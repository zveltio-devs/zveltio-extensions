{
  "spec": "zveltio.view/2",
  "title": "ecommerce.store.title",
  "type": "tabs",
  "items": [
    {
      "type": "list",
      "collection": "ec_products",
      "title": "ecommerce.store.tab.products",
      "fields": [
        {
          "field": "name",
          "label": "common.col.name"
        },
        {
          "field": "price",
          "label": "common.col.price"
        },
        {
          "field": "stock_qty",
          "label": "ecommerce.store.col.stock"
        },
        {
          "field": "status",
          "label": "common.col.status",
          "display": "badge",
          "tones": {
            "active": "success",
            "draft": "muted",
            "archived": "muted"
          }
        }
      ],
      "sort": "-created_at",
      "edit": true,
      "create": true
    },
    {
      "type": "list",
      "collection": "ec_orders",
      "title": "ecommerce.store.tab.orders",
      "fields": [
        {
          "field": "order_number",
          "label": "ecommerce.store.col.orderNumber",
          "display": "mono"
        },
        {
          "field": "customer_name",
          "label": "ecommerce.store.col.customer"
        },
        {
          "field": "total",
          "label": "common.col.total"
        },
        {
          "field": "created_at",
          "label": "common.col.date"
        },
        {
          "field": "status",
          "label": "common.col.status"
        }
      ],
      "sort": "-created_at"
    }
  ]
}
