{
  "sduiSchema": 1,
  "title": "ecommerce.store.title",
  "subtitle": "ecommerce.store.subtitle",
  "newLabel": "ecommerce.store.btn.newProduct",
  "resources": [
    {
      "id": "products",
      "label": "ecommerce.store.tab.products",
      "dataSource": "/api/data/ec_products?sort=created_at&order=desc&limit=500",
      "dataPath": "records",
      "columns": [
        {
          "key": "name",
          "label": "common.col.name"
        },
        {
          "key": "price",
          "label": "common.col.price",
          "type": "currency",
          "currency": {
            "codeKey": "currency"
          }
        },
        {
          "key": "stock_qty",
          "label": "ecommerce.store.col.stock",
          "classWhen": [
            {
              "equals": 0,
              "class": "text-error"
            }
          ]
        },
        {
          "key": "status",
          "label": "common.col.status",
          "type": "badge",
          "badge": {
            "colors": {
              "active": "badge-success",
              "draft": "badge-ghost",
              "archived": "badge-ghost"
            },
            "labels": {
              "active": "store.status.active",
              "draft": "store.status.draft",
              "archived": "store.status.archived"
            }
          }
        }
      ],
      "rowActions": [
        {
          "id": "delete",
          "icon": "Trash2",
          "variant": "text-error",
          "label": "common.delete",
          "method": "PATCH",
          "endpoint": "/api/data/ec_products/{id}",
          "confirm": "ecommerce.store.confirmDeleteProduct",
          "body": {
            "status": "archived"
          },
          "visibleWhen": {
            "field": "status",
            "in": [
              "draft",
              "active"
            ]
          }
        }
      ],
      "form": {
        "endpoint": "/api/data/ec_products",
        "fields": [
          {
            "name": "name",
            "label": "store.form.name",
            "required": true,
            "colSpan": 2
          },
          {
            "name": "sku",
            "label": "store.form.sku",
            "required": true,
            "colSpan": 1
          },
          {
            "name": "slug",
            "label": "store.form.slug",
            "required": true,
            "colSpan": 1
          },
          {
            "name": "short_description",
            "label": "store.form.shortDescription",
            "colSpan": 2
          },
          {
            "name": "price",
            "label": "store.form.price",
            "type": "number",
            "required": true,
            "colSpan": 1
          },
          {
            "name": "currency",
            "label": "store.form.currency",
            "default": "RON",
            "colSpan": 1
          },
          {
            "name": "stock_qty",
            "label": "store.form.stockQty",
            "type": "number",
            "colSpan": 1
          },
          {
            "name": "status",
            "label": "store.form.status",
            "type": "select",
            "default": "draft",
            "colSpan": 1,
            "options": [
              {
                "value": "draft",
                "label": "store.status.draft"
              },
              {
                "value": "active",
                "label": "store.status.active"
              },
              {
                "value": "archived",
                "label": "store.status.archived"
              }
            ]
          }
        ]
      }
    },
    {
      "id": "orders",
      "label": "ecommerce.store.tab.orders",
      "dataSource": "/api/data/ec_orders?sort=created_at&order=desc&limit=500",
      "dataPath": "records",
      "columns": [
        {
          "key": "order_number",
          "label": "ecommerce.store.col.orderNumber",
          "type": "mono"
        },
        {
          "key": "customer_name",
          "label": "ecommerce.store.col.customer",
          "secondary": "customer_email"
        },
        {
          "key": "total",
          "label": "common.col.total",
          "type": "currency",
          "currency": {
            "codeKey": "currency"
          }
        },
        {
          "key": "created_at",
          "label": "common.col.date",
          "type": "date"
        },
        {
          "key": "status",
          "label": "common.col.status",
          "editable": {
            "endpoint": "/api/data/ec_orders/{id}",
            "method": "PATCH",
            "field": "status",
            "options": [
              {
                "value": "pending",
                "label": "common.status.pending"
              },
              {
                "value": "processing",
                "label": "ecommerce.store.ui.processing"
              },
              {
                "value": "shipped",
                "label": "ecommerce.store.ui.shipped"
              },
              {
                "value": "delivered",
                "label": "ecommerce.store.ui.delivered"
              },
              {
                "value": "cancelled",
                "label": "common.status.cancelled"
              }
            ]
          }
        }
      ]
    }
  ]
}
