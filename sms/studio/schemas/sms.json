{
  "spec": "zveltio.view/2",
  "title": "sms.title",
  "type": "tabs",
  "items": [
    {
      "type": "list",
      "collection": "sms_messages",
      "title": "sms.tab.messages",
      "fields": [
        {
          "field": "to_number",
          "label": "common.col.to",
          "display": "mono"
        },
        {
          "field": "body",
          "label": "sms.col.body"
        },
        {
          "field": "provider",
          "label": "sms.col.provider"
        },
        {
          "field": "status",
          "label": "common.col.status",
          "display": "badge",
          "tones": {
            "pending": "warning",
            "sending": "muted",
            "sent": "info",
            "delivered": "success",
            "failed": "danger"
          }
        },
        {
          "field": "sent_at",
          "label": "sms.col.sentAt"
        },
        {
          "field": "error",
          "label": "sms.col.error"
        }
      ],
      "sort": "-created_at",
      "actions": [
        {
          "action": "send",
          "tone": "info",
          "label": "common.new",
          "prompt": [
            "provider",
            "to",
            "template_id",
            "body",
            "variables"
          ]
        }
      ]
    },
    {
      "type": "list",
      "collection": "sms_templates",
      "title": "sms.tab.templates",
      "fields": [
        {
          "field": "name",
          "label": "common.col.name"
        },
        {
          "field": "body",
          "label": "sms.col.body"
        },
        {
          "field": "provider",
          "label": "sms.col.provider"
        }
      ],
      "sort": "name",
      "edit": true,
      "delete": true,
      "create": true
    },
    {
      "type": "list",
      "collection": "sms_settings",
      "title": "sms.tab.settings",
      "fields": [
        {
          "field": "twilio_account_sid",
          "label": "sms.settings.accountSid",
          "display": "mono"
        },
        {
          "field": "twilio_from_number",
          "label": "sms.settings.twilioFrom",
          "display": "mono"
        },
        {
          "field": "vonage_api_key",
          "label": "sms.settings.apiKey",
          "display": "mono"
        },
        {
          "field": "vonage_from_number",
          "label": "sms.settings.vonageFrom",
          "display": "mono"
        }
      ],
      "edit": true,
      "create": true
    }
  ]
}
