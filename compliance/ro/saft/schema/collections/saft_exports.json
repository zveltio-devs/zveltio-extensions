{
  "name": "saft_exports",
  "fields": [
    {
      "name": "period_start",
      "type": "date",
      "required": true,
      "indexed": true
    },
    {
      "name": "period_end",
      "type": "date",
      "required": true
    },
    {
      "name": "company_name",
      "type": "text",
      "required": true
    },
    {
      "name": "company_cui",
      "type": "text",
      "required": true
    },
    {
      "name": "company_address",
      "type": "text"
    },
    {
      "name": "status",
      "type": "enum",
      "required": true,
      "indexed": true,
      "defaultValue": "draft",
      "writtenBy": "actions",
      "options": {
        "values": [
          "draft",
          "generated"
        ]
      }
    },
    {
      "name": "entries_count",
      "type": "integer",
      "writtenBy": "actions"
    }
  ],
  "validation": [
    {
      "field": "company_cui",
      "rule": "custom",
      "config": {
        "expression": "value == null || value == \"\" || value.matches(\"^[0-9]{2,10}$\") && (int(value) / 1000000000 % 10 * 7 + int(value) / 100000000 % 10 * 5 + int(value) / 10000000 % 10 * 3 + int(value) / 1000000 % 10 * 2 + int(value) / 100000 % 10 * 1 + int(value) / 10000 % 10 * 7 + int(value) / 1000 % 10 * 5 + int(value) / 100 % 10 * 3 + int(value) / 10 % 10 * 2) * 10 % 11 % 10 == int(value) % 10"
      },
      "message": "Not a valid Romanian CUI: 2 to 10 digits with a valid check digit, without the RO prefix."
    }
  ]
}
