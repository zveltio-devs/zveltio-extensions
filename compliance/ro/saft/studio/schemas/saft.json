{
  "spec": "zveltio.view/2",
  "title": "compliance.ro.saft.title",
  "type": "list",
  "collection": "saft_exports",
  "fields": [
    { "field": "period_start", "label": "compliance.ro.saft.ui.period_start", "display": "mono" },
    { "field": "period_end", "label": "compliance.ro.saft.ui.period_end", "display": "mono" },
    { "field": "company_name", "label": "compliance.ro.saft.col.company" },
    { "field": "company_cui", "label": "compliance.ro.saft.col.cui", "display": "mono" },
    { "field": "entries_count", "label": "compliance.ro.saft.col.lines" },
    {
      "field": "status",
      "label": "common.col.status",
      "display": "badge",
      "tones": { "draft": "warning", "generated": "info" }
    }
  ],
  "sort": "-period_start",
  "rowActions": [
    {
      "action": "generate",
      "label": "compliance.ro.saft.btn.generateXml",
      "input": { "id": { "$record": "id" } }
    },
    {
      "action": "download",
      "label": "common.download",
      "input": { "id": { "$record": "id" } },
      "when": [{ "field": "status", "op": "eq", "value": "generated" }],
      "files": { "write": { "name": { "$record": "file_name" }, "maxBytes": 33554432 } }
    }
  ],
  "create": true,
  "edit": true,
  "delete": true
}
