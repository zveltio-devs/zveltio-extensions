{
  "spec": "zveltio.view/2",
  "id": "ro-documents.list",
  "title": "compliance.ro.documents.title",
  "type": "list",
  "collection": "ro_documents",
  "fields": [
    { "field": "type", "label": "compliance.ro.documents.col.type", "display": "badge" },
    { "field": "number", "label": "compliance.ro.documents.ui.num_r", "display": "mono" },
    { "field": "date", "label": "compliance.ro.documents.col.data" },
    { "field": "title", "label": "compliance.ro.documents.col.title" },
    {
      "field": "status",
      "label": "common.col.status",
      "display": "badge",
      "tones": { "draft": "warning", "signed": "success", "archived": "muted" }
    }
  ],
  "sort": "-date",
  "actions": [{ "navigate": "ro-documents.new", "label": "compliance.ro.documents.btn.new" }],
  "rowActions": [
    {
      "action": "sign",
      "label": "compliance.ro.documents.col.signed",
      "input": { "id": { "$record": "id" } },
      "confirm": "compliance.ro.documents.confirmSign",
      "when": [{ "field": "status", "op": "eq", "value": "draft" }]
    },
    {
      "action": "archive",
      "label": "compliance.ro.documents.btn.archive",
      "input": { "id": { "$record": "id" } },
      "confirm": "compliance.ro.documents.confirmArchive",
      "when": [{ "field": "status", "op": "eq", "value": "signed" }]
    },
    {
      "action": "remove",
      "label": "common.delete",
      "tone": "danger",
      "input": { "id": { "$record": "id" } },
      "confirm": "compliance.ro.documents.confirmDelete",
      "when": [{ "field": "status", "op": "eq", "value": "draft" }]
    }
  ]
}
