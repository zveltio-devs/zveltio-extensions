{
  "spec": "zveltio.view/2",
  "id": "etransport.list",
  "title": "compliance.ro.etransport.title",
  "type": "list",
  "collection": "etransport_declarations",
  "fields": [
    { "field": "uit", "label": "compliance.ro.etransport.col.uit", "display": "mono" },
    { "field": "transport_date", "label": "common.col.date" },
    { "field": "vehicle_plate", "label": "compliance.ro.etransport.col.vehicle", "display": "mono" },
    { "field": "driver_name", "label": "compliance.ro.etransport.col.driver" },
    { "field": "destination_county", "label": "compliance.ro.etransport.col.route" },
    { "field": "total_weight_kg", "label": "compliance.ro.etransport.col.weightKg", "display": "mono" },
    {
      "field": "status",
      "label": "common.col.status",
      "display": "badge",
      "tones": {
        "draft": "warning",
        "declared": "info",
        "in_transit": "info",
        "completed": "success",
        "cancelled": "danger"
      }
    }
  ],
  "sort": "-transport_date",
  "actions": [{ "navigate": "etransport.new", "label": "compliance.ro.etransport.btn.newDeclaration" }],
  "rowActions": [
    {
      "action": "recordUit",
      "label": "compliance.ro.etransport.col.uit",
      "input": { "id": { "$record": "id" } },
      "prompt": ["uit", "note"],
      "when": [{ "field": "status", "op": "eq", "value": "draft" }]
    },
    {
      "action": "complete",
      "label": "compliance.ro.etransport.action.complete",
      "tone": "success",
      "input": { "id": { "$record": "id" } },
      "when": [{ "field": "status", "op": "in", "value": ["declared", "in_transit"] }]
    },
    {
      "action": "cancel",
      "label": "compliance.ro.etransport.action.cancel",
      "tone": "danger",
      "input": { "id": { "$record": "id" } },
      "confirm": "compliance.ro.etransport.confirmCancel",
      "when": [{ "field": "status", "op": "in", "value": ["draft", "declared", "in_transit"] }]
    }
  ]
}
