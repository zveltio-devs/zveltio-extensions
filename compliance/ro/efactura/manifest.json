            "format": "uuid"
          }
        }
      },
      "reads": [
        "efactura_invoices",
        "efactura_files",
        "efactura_settings"
      ],
      "writes": [
        "efactura_invoices",
        "efactura_files",
        "efactura_settings"
      ],
      "egress": [
