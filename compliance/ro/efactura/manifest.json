{
  "name": "compliance/ro/efactura",
  "displayName": "e-Factura RO",
  "category": "compliance/ro",
  "description": "Romanian e-Invoice (e-Factura): build the UBL XML (CIUS-RO), submit it to ANAF, follow its state and keep ANAF's signed answer",
  "version": "2.0.0",
  "zveltioMinVersion": "3.0.0-beta.103",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-ro-efactura",
  "permissions": [
    "data:write",
    "data:system"
  ],
  "i18nPrefixes": [
    "compliance.ro.efactura",
    "efactura"
  ],
  "studio": {
    "pages": [
      {
        "path": "/admin/compliance/ro/efactura",
        "label": "e-Factura RO",
        "icon": "receipt",
        "schema": "schemas/efactura.json"
      }
    ],
    "navGroup": "compliance"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "fieldTypes": []
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "optionalDependencies": [
    {
      "name": "finance/invoicing",
      "minVersion": "2.3.0"
    }
  ],
  "collections": [
    "efactura_invoices",
    "efactura_files",
    "efactura_messages",
    "efactura_settings"
  ],
  "publicRoutes": [
    "/oauth/callback"
  ],
  "actions": [
    {
      "name": "generateXml",
      "permission": {
        "resource": "efactura_invoices",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "efactura_invoices",
        "efactura_files"
      ],
      "writes": [
        "efactura_invoices",
        "efactura_files"
      ]
    },
    {
      "name": "submit",
      "permission": {
        "resource": "efactura_invoices",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "efactura_invoices",
        "efactura_files"
      ],
      "writes": [
        "efactura_invoices"
      ],
      "enqueues": [
        "submit"
      ]
    },
    {
      "name": "checkStatus",
      "permission": {
        "resource": "efactura_invoices",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "efactura_invoices"
      ],
      "writes": [],
      "enqueues": [
        "checkStatus"
      ]
    },
    {
      "name": "renderPdf",
      "permission": {
        "resource": "efactura_invoices",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "efactura_invoices",
        "efactura_files"
      ],
      "writes": [],
      "enqueues": [
        "renderPdf"
      ]
    },
    {
      "name": "storno",
      "permission": {
        "resource": "efactura_invoices",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      },
      "reads": [
        "efactura_invoices"
      ],
      "writes": [
        "efactura_invoices"
      ]
    },
    {
      "name": "fromInvoice",
      "permission": {
        "resource": "efactura_invoices",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "invoice_id"
        ],
        "additionalProperties": false,
        "properties": {
          "invoice_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "efactura_invoices",
        "invoices",
        "invoice_lines"
      ],
      "writes": [
        "efactura_invoices"
      ]
    },
    {
      "name": "verify",
      "permission": {
        "resource": "efactura_settings",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "efactura_settings"
      ],
      "writes": [],
      "enqueues": [
        "connect"
      ]
    },
    {
      "name": "syncMessages",
      "permission": {
        "resource": "efactura_messages",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          },
          "filter": {
            "type": "string",
            "enum": [
              "E",
              "T",
              "P",
              "R"
            ]
          }
        }
      },
      "reads": [],
      "writes": [],
      "enqueues": [
        "syncMessages"
      ]
    },
    {
      "name": "downloadMessage",
      "permission": {
        "resource": "efactura_messages",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "efactura_messages"
      ],
      "writes": [],
      "enqueues": [
        "downloadMessage"
      ]
    }
  ],
  "jobs": [
    {
      "name": "connect",
      "input": {
        "type": "object",
        "required": [
          "settings_id"
        ],
        "additionalProperties": false,
        "properties": {
          "settings_id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      },
      "reads": [
        "efactura_settings"
      ],
      "writes": [
        "efactura_settings"
      ],
      "egress": [
        "logincert.anaf.ro",
        "api.anaf.ro"
      ],
      "retry": {
        "limit": 0,
        "backoff": true
      },
      "timeoutSeconds": 120,
      "fromPublicRoutes": [
        "/oauth/callback"
      ]
    },
    {
      "name": "submit",
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "efactura_invoices",
        "efactura_files",
        "efactura_settings"
      ],
      "writes": [
        "efactura_invoices",
        "efactura_settings"
      ],
      "egress": [
        "logincert.anaf.ro",
        "api.anaf.ro"
      ],
