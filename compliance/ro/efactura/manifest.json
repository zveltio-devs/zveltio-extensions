{
  "name": "compliance/ro/efactura",
  "displayName": "e-Factura RO",
  "category": "compliance/ro",
  "description": "Romanian e-Invoice (e-Factura): build the UBL XML (CIUS-RO), submit it to ANAF, follow its state and keep ANAF's signed answer",
  "version": "4.0.1",
  "zveltioMinVersion": "3.0.0-beta.130",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-ro-efactura",
  "permissions": [
    "data:write",
    "data:system"
  ],
  "i18nPrefixes": [
    "compliance.ro.efactura",
    "efactura"
  ],
  "studio": {
    "pages": [
      {
        "path": "/admin/compliance/ro/efactura",
        "label": "e-Factura RO",
        "icon": "receipt",
        "schema": "schemas/efactura.json"
      },
      {
        "path": "/admin/compliance/ro/efactura/new",
        "label": "compliance.ro.efactura.btn.newInvoice",
        "icon": "file-plus",
        "schema": "schemas/invoice-new.json"
      },
      {
        "path": "/admin/compliance/ro/efactura/connection",
        "label": "e-Factura RO: ANAF",
        "icon": "key-round",
        "schema": "schemas/connection.json"
      }
    ],
    "navGroup": "compliance"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "fieldTypes": []
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "optionalDependencies": [
    {
      "name": "finance/invoicing",
      "minVersion": "2.3.0"
    }
  ],
  "collections": [
    "efactura_invoices",
    "efactura_files",
    "efactura_messages",
    "efactura_settings"
  ],
  "routes": [
    {
      "method": "GET",
      "path": "/oauth/callback",
      "access": "public",
      "handler": "oauthCallback"
    }
  ],
  "actions": [
    {
      "name": "createInvoice",
      "permission": {
        "resource": "efactura_invoices",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "invoice_number",
          "invoice_date",
          "seller_name",
          "seller_cui",
          "buyer_name",
          "lines"
        ],
        "additionalProperties": false,
        "properties": {
          "invoice_number": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "invoice_date": {
            "type": "string",
            "format": "date"
          },
          "due_date": {
            "type": "string",
            "format": "date"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$"
          },
          "seller_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "seller_cui": {
            "type": "string",
            "minLength": 1,
            "maxLength": 20
          },
          "seller_address": {
            "type": "string",
            "maxLength": 500
          },
          "seller_iban": {
            "type": "string",
            "maxLength": 34
          },
          "buyer_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255
          },
          "buyer_cui": {
            "type": "string",
            "maxLength": 20
          },
          "buyer_address": {
            "type": "string",
            "maxLength": 500
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "description",
                "unit_price"
              ],
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "quantity": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "type": "string",
                  "maxLength": 10
                },
                "unit_price": {
                  "type": "number"
                },
                "vat_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            }
          }
        }
      },
      "reads": [
        "efactura_invoices"
      ],
      "writes": [
        "efactura_invoices"
      ]
    },
    {
      "name": "deleteDraft",
      "permission": {
        "resource": "efactura_invoices",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "efactura_invoices"
      ],
      "writes": [
        "efactura_invoices"
      ]
    },
    {
      "name": "generateXml",
      "permission": {
        "resource": "efactura_invoices",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "efactura_invoices",
        "efactura_files"
      ],
      "writes": [
        "efactura_invoices",
        "efactura_files"
      ]
    },
    {
      "name": "submit",
      "permission": {
        "resource": "efactura_invoices",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "efactura_invoices",
        "efactura_files"
      ],
      "writes": [
        "efactura_invoices"
      ],
      "enqueues": [
        "submit"
      ]
    },
    {
      "name": "checkStatus",
      "permission": {
        "resource": "efactura_invoices",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "efactura_invoices"
      ],
      "writes": [],
      "enqueues": [
        "checkStatus"
      ]
    },
    {
      "name": "renderPdf",
      "permission": {
        "resource": "efactura_invoices",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "efactura_invoices",
        "efactura_files"
      ],
      "writes": [],
      "enqueues": [
        "renderPdf"
      ]
    },
    {
      "name": "storno",
      "permission": {
        "resource": "efactura_invoices",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      },
      "reads": [
        "efactura_invoices"
      ],
      "writes": [
        "efactura_invoices"
      ]
    },
    {
      "name": "fromInvoice",
      "permission": {
        "resource": "efactura_invoices",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "invoice_id"
        ],
        "additionalProperties": false,
        "properties": {
          "invoice_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "efactura_invoices",
        "invoices",
        "invoice_lines"
      ],
      "writes": [
        "efactura_invoices"
      ]
    },
    {
      "name": "verify",
      "permission": {
        "resource": "efactura_settings",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "efactura_settings"
      ],
      "writes": [],
      "enqueues": [
        "connect"
      ]
    },
    {
      "name": "startSignIn",
      "permission": {
        "resource": "efactura_settings",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "efactura_settings"
      ],
      "writes": [
        "efactura_settings"
      ]
    },
    {
      "name": "finishSignIn",
      "permission": {
        "resource": "efactura_settings",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id",
          "code",
          "state"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "state": {
            "type": "string",
            "pattern": "^[0-9a-f]{48}$"
          }
        }
      },
      "reads": [
        "efactura_settings"
      ],
      "writes": [
        "efactura_settings"
      ],
      "enqueues": [
        "connect"
      ]
    },
    {
      "name": "syncMessages",
      "permission": {
        "resource": "efactura_messages",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          },
          "filter": {
            "type": "string",
            "enum": [
              "E",
              "T",
              "P",
              "R"
            ]
          }
        }
      },
      "reads": [],
      "writes": [],
      "enqueues": [
        "syncMessages"
      ]
    },
    {
      "name": "downloadMessage",
      "permission": {
        "resource": "efactura_messages",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "efactura_messages"
      ],
      "writes": [],
      "enqueues": [
        "downloadMessage"
      ]
    },
    {
      "name": "download",
      "permission": {
        "resource": "efactura_invoices",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id",
          "document"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "document": {
            "type": "string",
            "enum": [
              "xml",
              "pdf",
              "archive"
            ]
          }
        }
      },
      "reads": [
        "efactura_files"
      ],
      "writes": []
    },
    {
      "name": "messageArchive",
      "permission": {
        "resource": "efactura_messages",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "efactura_messages"
      ],
      "writes": []
    }
  ],
  "jobs": [
    {
      "name": "connect",
      "input": {
        "type": "object",
        "required": [
          "settings_id"
        ],
        "additionalProperties": false,
        "properties": {
          "settings_id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          }
        }
      },
      "reads": [
        "efactura_settings"
      ],
      "writes": [
        "efactura_settings"
      ],
      "egress": [
        "logincert.anaf.ro",
        "api.anaf.ro"
      ],
      "retry": {
        "limit": 0,
