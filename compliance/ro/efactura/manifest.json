          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "efactura_messages",
        "efactura_settings"
      ],
      "writes": [
        "efactura_messages",
        "efactura_settings"
      ],
      "egress": [
        "logincert.anaf.ro",
