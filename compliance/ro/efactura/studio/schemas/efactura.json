{
  "spec": "zveltio.view/2",
  "id": "efactura.invoices",
  "title": "compliance.ro.efactura.title",
  "type": "tabs",
  "items": [
    {
      "type": "list",
      "collection": "efactura_invoices",
      "title": "compliance.ro.efactura.tab.invoices",
      "fields": [
        {
          "field": "invoice_number",
          "label": "common.col.number",
          "display": "mono"
        },
        {
          "field": "invoice_date",
          "label": "common.col.date"
        },
        {
          "field": "buyer_name",
          "label": "compliance.ro.efactura.col.buyer"
        },
        {
          "field": "total",
          "label": "common.col.total"
        },
        {
          "field": "anaf_index",
          "label": "compliance.ro.efactura.col.anafIndex",
          "display": "mono"
        },
        {
          "field": "status",
          "label": "common.col.status",
          "display": "badge",
          "tones": {
            "draft": "warning",
            "xml_generated": "info",
            "submitting": "muted",
            "submitted": "info",
            "accepted": "success",
            "rejected": "danger"
          }
        },
        {
          "field": "anaf_state",
          "label": "compliance.ro.efactura.col.anafState",
          "display": "mono"
        }
      ],
      "sort": "-invoice_date",
      "actions": [
        {
          "navigate": "efactura.new",
          "label": "compliance.ro.efactura.btn.newInvoice"
        }
      ],
      "rowActions": [
        {
          "action": "generateXml",
          "label": "compliance.ro.efactura.btn.generateXml",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "when": [
            {
              "field": "status",
              "op": "in",
              "value": [
                "draft",
                "xml_generated"
              ]
            }
          ]
        },
        {
          "action": "download",
          "label": "compliance.ro.efactura.btn.xml",
          "input": {
            "id": {
              "$record": "id"
            },
            "document": "xml"
          },
          "when": [
            {
              "field": "status",
              "op": "in",
              "value": [
                "xml_generated",
                "submitting",
                "submitted",
                "accepted",
                "rejected"
              ]
            }
          ],
          "files": {
            "write": {
              "name": "efactura.xml",
              "maxBytes": 10485760
            }
          }
        },
        {
          "action": "submit",
          "label": "common.send",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "confirm": "compliance.ro.efactura.confirmSend",
          "when": [
            {
              "field": "status",
              "op": "eq",
              "value": "xml_generated"
            }
          ]
        },
        {
          "action": "checkStatus",
          "label": "compliance.ro.efactura.btn.checkStatus",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "when": [
            {
              "field": "status",
              "op": "in",
              "value": [
                "submitted",
                "accepted",
                "rejected"
              ]
            }
          ]
        },
        {
          "action": "renderPdf",
          "label": "compliance.ro.efactura.btn.renderPdf",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "when": [
            {
              "field": "status",
              "op": "in",
              "value": [
                "xml_generated",
                "submitting",
                "submitted",
                "accepted",
                "rejected"
              ]
            }
          ]
        },
        {
          "action": "download",
          "label": "compliance.ro.efactura.btn.pdf",
          "input": {
            "id": {
              "$record": "id"
            },
            "document": "pdf"
          },
          "when": [
            {
              "field": "status",
              "op": "in",
              "value": [
                "xml_generated",
                "submitting",
                "submitted",
                "accepted",
                "rejected"
              ]
            }
          ],
          "files": {
            "write": {
              "name": "efactura.pdf",
              "maxBytes": 33554432
            }
          }
        },
        {
          "action": "download",
          "label": "compliance.ro.efactura.btn.archive",
          "input": {
            "id": {
              "$record": "id"
            },
            "document": "archive"
          },
          "when": [
            {
              "field": "status",
              "op": "in",
              "value": [
                "accepted",
                "rejected"
              ]
            }
          ],
          "files": {
            "write": {
              "name": "anaf.zip",
              "maxBytes": 33554432
            }
          }
        },
        {
          "action": "storno",
          "label": "compliance.ro.efactura.btn.storno",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "prompt": [
            "reason"
          ],
          "when": [
            {
              "field": "status",
              "op": "in",
              "value": [
                "submitted",
                "accepted"
              ]
            }
          ]
        },
        {
          "action": "deleteDraft",
          "label": "common.delete",
          "tone": "danger",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "confirm": "compliance.ro.efactura.confirmDelete",
          "when": [
            {
              "field": "status",
              "op": "eq",
              "value": "draft"
            }
          ]
        }
      ]
    },
    {
      "type": "list",
      "collection": "efactura_messages",
      "title": "compliance.ro.efactura.tab.messages",
      "fields": [
        {
          "field": "data_creare",
          "label": "common.col.date",
          "display": "mono"
        },
        {
          "field": "tip",
          "label": "compliance.ro.efactura.col.type"
        },
        {
          "field": "id_solicitare",
          "label": "compliance.ro.efactura.col.anafIndex",
          "display": "mono"
        },
        {
          "field": "detalii",
          "label": "compliance.ro.efactura.col.details"
        },
        {
          "field": "downloaded_at",
          "label": "compliance.ro.efactura.col.downloaded"
        }
      ],
      "sort": "-data_creare",
      "actions": [
        {
          "action": "syncMessages",
          "label": "compliance.ro.efactura.btn.syncMessages",
          "input": {}
        }
      ],
      "rowActions": [
        {
          "action": "downloadMessage",
          "label": "compliance.ro.efactura.btn.fetchArchive",
          "input": {
            "id": {
              "$record": "id"
            }
          }
        },
        {
          "action": "messageArchive",
          "label": "compliance.ro.efactura.btn.archive",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "when": [
            {
              "field": "downloaded_at",
              "op": "not_null"
            }
          ],
          "files": {
            "write": {
              "name": "anaf.zip",
              "maxBytes": 33554432
            }
          }
        }
      ]
    }
  ]
}
