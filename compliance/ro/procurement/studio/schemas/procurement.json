{
  "sduiSchema": 1,
  "title": "compliance.ro.procurement.title",
  "subtitle": "compliance.ro.procurement.subtitle",
  "newLabel": "common.new",
  "resources": [
    {
      "id": "orders",
      "label": "compliance.ro.procurement.tab.orders",
      "icon": "Package",
      "dataSource": "/api/data/procurement_orders?sort=date&order=desc&limit=500",
      "dataPath": "records",
      "columns": [
        {
          "key": "number",
          "label": "common.col.number",
          "type": "mono"
        },
        {
          "key": "supplier_name",
          "label": "compliance.ro.procurement.col.supplier"
        },
        {
          "key": "description",
          "label": "common.col.description"
        },
        {
          "key": "total",
          "label": "common.col.total",
          "type": "currency",
          "currency": {
            "codeKey": "currency"
          }
        },
        {
          "key": "status",
          "label": "common.col.status",
          "type": "badge",
          "badge": {
            "colors": {
              "draft": "badge-warning",
              "approved": "badge-info",
              "received": "badge-success",
              "cancelled": "badge-error"
            }
          }
        },
        {
          "key": "date",
          "label": "common.col.date",
          "type": "date"
        }
      ],
      "rowActions": [
        {
          "id": "approve",
          "icon": "CheckCircle",
          "label": "common.approve",
          "method": "POST",
          "endpoint": "/ext/compliance/ro/procurement/actions/approveOrder",
          "visibleWhen": {
            "field": "status",
            "equals": "draft"
          },
          "body": {
            "id": "{id}"
          },
          "variant": "text-success"
        },
        {
          "id": "receive",
          "icon": "PackageCheck",
          "label": "compliance.ro.procurement.action.receive",
          "method": "POST",
          "endpoint": "/ext/compliance/ro/procurement/actions/receiveOrder",
          "visibleWhen": {
            "field": "status",
            "equals": "approved"
          },
          "body": {
            "id": "{id}"
          }
        },
        {
          "id": "cancel",
          "icon": "XCircle",
          "label": "compliance.ro.procurement.action.cancel",
          "method": "POST",
          "endpoint": "/ext/compliance/ro/procurement/actions/cancelOrder",
          "body": {
            "id": "{id}"
          },
          "variant": "text-error",
          "prompt": {
            "title": "compliance.ro.procurement.action.cancel",
            "submitLabel": "compliance.ro.procurement.action.cancel",
            "fields": [
              {
                "name": "reason",
                "label": "compliance.ro.procurement.field.reason",
                "type": "textarea",
                "required": true
              }
            ]
          },
          "visibleWhen": {
            "field": "status",
            "in": [
              "draft",
              "approved"
            ]
          }
        },
        {
          "id": "delete",
          "icon": "Trash2",
          "label": "common.delete",
          "method": "POST",
          "endpoint": "/ext/compliance/ro/procurement/actions/deleteDraft",
          "visibleWhen": {
            "field": "status",
            "equals": "draft"
          },
          "body": {
            "id": "{id}"
          },
          "variant": "text-error",
          "confirm": "ext.confirmDelete"
        }
      ],
      "form": {
        "endpoint": "/ext/compliance/ro/procurement/actions/createOrder",
        "fields": [
          {
            "name": "number",
            "label": "common.col.number",
            "required": true,
            "mono": true,
            "colSpan": 1
          },
          {
            "name": "date",
            "label": "common.col.date",
            "type": "date",
            "required": true,
            "colSpan": 1,
            "default": "today"
          },
          {
            "name": "supplier_name",
            "label": "compliance.ro.procurement.col.supplier",
            "required": true,
            "colSpan": 1
          },
          {
            "name": "supplier_cui",
            "label": "compliance.ro.procurement.ui.cui",
            "required": true,
            "mono": true,
            "colSpan": 1
          },
          {
            "name": "description",
            "label": "common.col.description",
            "type": "textarea",
            "required": true,
            "colSpan": 2
          },
          {
            "name": "currency",
            "label": "common.col.currency",
            "colSpan": 1,
            "default": "RON"
          },
          {
            "name": "items",
            "label": "compliance.ro.procurement.form.lineItemsJson",
            "type": "json",
            "mono": true,
            "rows": 6,
            "colSpan": 2,
            "default": "[{\"description\":\"\",\"quantity\":1,\"unit\":\"BUC\",\"unit_price\":0,\"vat_rate\":21}]"
          }
        ]
      },
      "filters": [
        {
          "param": "status",
          "options": [
            {
              "value": "all",
              "label": "compliance.ro.procurement.filter.all"
            },
            {
              "value": "draft",
              "label": "compliance.ro.procurement.status.draft"
            },
            {
              "value": "approved",
              "label": "compliance.ro.procurement.status.approved"
            },
