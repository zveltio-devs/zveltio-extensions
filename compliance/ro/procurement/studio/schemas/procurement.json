{
  "spec": "zveltio.view/2",
  "title": "compliance.ro.procurement.title",
  "type": "tabs",
  "items": [
    {
      "type": "list",
      "collection": "procurement_orders",
      "title": "compliance.ro.procurement.tab.orders",
      "fields": [
        {
          "field": "number",
          "label": "common.col.number",
          "display": "mono"
        },
        {
          "field": "supplier_name",
          "label": "compliance.ro.procurement.col.supplier"
        },
        {
          "field": "description",
          "label": "common.col.description"
        },
        {
          "field": "total",
          "label": "common.col.total"
        },
        {
          "field": "status",
          "label": "common.col.status",
          "display": "badge",
          "tones": {
            "draft": "warning",
            "approved": "info",
            "received": "success",
            "cancelled": "danger"
          }
        },
        {
          "field": "date",
          "label": "common.col.date"
        }
      ],
      "sort": "-date",
      "rowActions": [
        {
          "action": "approveOrder",
          "label": "common.approve",
          "tone": "success",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "when": [
            {
              "field": "status",
              "op": "eq",
              "value": "draft"
            }
          ]
        },
        {
          "action": "receiveOrder",
          "label": "compliance.ro.procurement.action.receive",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "when": [
            {
              "field": "status",
              "op": "eq",
              "value": "approved"
            }
          ]
        },
        {
          "action": "cancelOrder",
          "label": "compliance.ro.procurement.action.cancel",
          "tone": "danger",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "prompt": [
            "reason"
          ],
          "when": [
            {
              "field": "status",
              "op": "in",
              "value": [
                "draft",
                "approved"
              ]
            }
          ]
        },
        {
          "action": "deleteDraft",
          "label": "common.delete",
          "tone": "danger",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "confirm": "ext.confirmDelete",
          "when": [
            {
              "field": "status",
              "op": "eq",
              "value": "draft"
            }
          ]
        }
      ],
      "actions": [
        {
          "action": "createOrder",
          "tone": "info",
          "label": "common.new",
          "prompt": [
            "number",
            "date",
            "supplier_name",
            "supplier_cui",
            "description",
            "currency",
            "items"
          ]
        }
      ]
    },
    {
      "type": "list",
      "collection": "procurement_reception_notes",
      "title": "compliance.ro.procurement.tab.receptions",
      "fields": [
        {
          "field": "number",
          "label": "common.col.number",
          "display": "mono"
        },
        {
          "field": "supplier_name",
          "label": "compliance.ro.procurement.col.supplier"
        },
        {
          "field": "total_value",
          "label": "common.col.total"
        },
        {
          "field": "status",
          "label": "common.col.status",
          "display": "badge",
          "tones": {
            "draft": "warning",
            "confirmed": "success"
          }
        },
        {
          "field": "date",
          "label": "common.col.date"
        }
      ],
      "sort": "-date",
      "rowActions": [
        {
          "action": "confirmReceptionNote",
          "label": "compliance.ro.procurement.action.confirm",
          "tone": "success",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "when": [
            {
              "field": "status",
              "op": "eq",
              "value": "draft"
            }
          ]
        }
      ],
      "actions": [
        {
          "action": "createReceptionNote",
          "tone": "info",
          "label": "common.new",
          "prompt": [
            "number",
            "date",
            "supplier_name",
            "discrepancies",
            "items"
          ]
        }
      ]
    },
    {
      "type": "list",
      "collection": "procurement_suppliers",
      "title": "compliance.ro.procurement.tab.suppliers",
      "fields": [
        {
          "field": "name",
          "label": "common.col.name"
        },
        {
          "field": "cui",
          "label": "compliance.ro.procurement.ui.cui",
          "display": "mono"
        },
        {
          "field": "county",
          "label": "compliance.ro.procurement.ui.judet"
        },
        {
          "field": "category",
          "label": "common.col.category"
        },
        {
          "field": "contact_email",
          "label": "common.col.email"
        }
      ],
      "sort": "name",
      "edit": true,
      "create": true
    },
    {
      "type": "list",
      "collection": "procurement_contracts",
      "title": "compliance.ro.procurement.tab.contracts",
      "fields": [
        {
          "field": "number",
          "label": "common.col.number",
          "display": "mono"
        },
        {
          "field": "title",
          "label": "common.col.name"
        },
        {
          "field": "supplier_name",
          "label": "compliance.ro.procurement.col.supplier"
        },
        {
          "field": "value",
          "label": "common.col.total"
        },
        {
          "field": "status",
          "label": "common.col.status",
          "display": "badge",
          "tones": {
            "draft": "warning",
            "active": "success",
            "expired": "muted",
            "cancelled": "danger",
            "terminated": "danger"
          }
        },
        {
          "field": "end_date",
          "label": "common.col.date"
        }
      ],
      "sort": "-created_at",
      "edit": true,
      "create": true
    },
    {
      "type": "list",
      "collection": "procurement_budget_lines",
      "title": "compliance.ro.procurement.tab.budget",
      "fields": [
        {
          "field": "code",
          "label": "common.col.code",
          "display": "mono"
        },
        {
          "field": "name",
          "label": "common.col.name"
        },
        {
          "field": "year",
          "label": "common.col.year",
          "display": "mono"
        },
        {
          "field": "allocated",
          "label": "compliance.ro.procurement.allocated"
        }
      ],
      "sort": "code",
      "edit": true,
      "create": true
    }
  ]
}
