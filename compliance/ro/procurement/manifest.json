{
  "name": "compliance/ro/procurement",
  "displayName": "Achizitii Publice RO",
  "category": "compliance/ro",
  "description": "Romanian public procurement management — purchase orders, supplier registry, budget tracking",
  "version": "2.0.1",
  "zveltioMinVersion": "3.0.0-beta.96",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-ro-procurement",
  "permissions": [
    "data:write"
  ],
  "i18nPrefixes": [
    "compliance.ro.procurement"
  ],
  "studio": {
    "pages": [
      {
        "path": "/admin/compliance/ro/procurement",
        "label": "Achizitii Publice RO",
        "icon": "Package",
        "schema": "schemas/procurement.json"
      }
    ],
    "navGroup": "compliance"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "fieldTypes": []
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "integrity": {
    "engineSha256": "2291624510995385599906cdf33916d1370afce38cc7ab320fb03cc7866fbdf0",
    "sourceSha256": "f36b15ccb89e537406b5095525330c140eedce9555101da7f969d92dff0231f4",
    "schemaSha256": "20e5ac06070d4d3f112de88aa522cff68d8965b5676169dcdebe44703873dff6"
  },
  "collections": [
    "procurement_suppliers",
    "procurement_budget_lines",
    "procurement_contracts",
    "procurement_orders",
    "procurement_reception_notes",
    "procurement_supplier_evaluations"
  ],
  "actions": [
    {
      "name": "createOrder",
      "permission": {
        "resource": "procurement_orders",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "number",
          "date",
          "description",
          "items"
        ],
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "supplier_id": {
            "type": "string",
            "format": "uuid"
          },
          "supplier_name": {
            "type": "string",
            "minLength": 1
          },
          "supplier_cui": {
            "type": "string",
            "minLength": 1
          },
          "contract_id": {
            "type": "string",
            "format": "uuid"
          },
          "budget_line_id": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "normal",
              "high",
              "urgent"
            ]
          },
          "notes": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "description",
                "quantity",
                "unit_price",
                "vat_rate"
              ],
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "quantity": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit": {
                  "type": "string"
                },
                "unit_price": {
                  "type": "number",
                  "minimum": 0
                },
                "vat_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            }
          }
        }
      },
      "reads": [
        "procurement_suppliers"
      ],
      "writes": [
        "procurement_orders"
      ]
    },
    {
      "name": "deleteDraft",
      "permission": {
        "resource": "procurement_orders",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "procurement_orders"
      ],
      "writes": [
        "procurement_orders"
      ]
    },
    {
      "name": "approveOrder",
      "permission": {
        "resource": "procurement_orders",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "procurement_orders"
      ],
      "writes": [
        "procurement_orders"
      ]
    },
    {
      "name": "receiveOrder",
      "permission": {
        "resource": "procurement_orders",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "procurement_orders"
      ],
      "writes": [
        "procurement_orders"
      ]
    },
    {
      "name": "cancelOrder",
      "permission": {
        "resource": "procurement_orders",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id",
          "reason"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "reads": [
        "procurement_orders"
      ],
      "writes": [
        "procurement_orders"
      ]
    },
    {
      "name": "createReceptionNote",
      "permission": {
        "resource": "procurement_reception_notes",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "number",
          "date",
          "items"
        ],
        "additionalProperties": false,
        "properties": {
          "number": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "order_id": {
            "type": "string",
            "format": "uuid"
          },
          "supplier_id": {
            "type": "string",
            "format": "uuid"
          },
          "supplier_name": {
            "type": "string",
            "minLength": 1
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "discrepancies": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "description",
                "ordered_qty",
                "received_qty",
                "unit_price"
              ],
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "ordered_qty": {
                  "type": "number",
                  "minimum": 0
                },
                "received_qty": {
                  "type": "number",
                  "minimum": 0
                },
                "unit": {
                  "type": "string"
                },
                "unit_price": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      },
      "reads": [
        "procurement_orders",
        "procurement_suppliers"
      ],
      "writes": [
        "procurement_reception_notes"
      ]
    },
    {
      "name": "confirmReceptionNote",
      "permission": {
        "resource": "procurement_reception_notes",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "procurement_reception_notes"
      ],
      "writes": [
        "procurement_reception_notes"
      ]
    },
    {
      "name": "evaluateSupplier",
      "permission": {
        "resource": "procurement_supplier_evaluations",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "supplier_id",
          "period",
          "quality_score",
          "delivery_score",
          "price_score"
        ],
        "additionalProperties": false,
        "properties": {
          "supplier_id": {
            "type": "string",
            "format": "uuid"
          },
          "period": {
            "type": "string",
            "minLength": 1
          },
          "quality_score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "delivery_score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "price_score": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "reads": [
        "procurement_suppliers",
        "procurement_supplier_evaluations"
      ],
      "writes": [
        "procurement_supplier_evaluations"
      ]
    },
    {
      "name": "budgetReport",
      "permission": {
        "resource": "procurement_budget_lines",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "year": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2100
          }
        }
      },
      "reads": [
        "procurement_budget_lines",
        "procurement_orders"
      ],
      "writes": []
    },
    {
      "name": "spendingReport",
      "permission": {
        "resource": "procurement_orders",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "year": {
            "type": "integer",
            "minimum": 2000,
            "maximum": 2100
          },
          "supplier_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "procurement_orders"
      ],
      "writes": []
    }
  ]
}
