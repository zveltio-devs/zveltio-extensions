{
  "name": "procurement_reception_notes",
  "writtenBy": "actions",
  "fields": [
    { "name": "number", "type": "text", "required": true, "unique": true },
    { "name": "order_id", "type": "m2o", "indexed": true, "options": { "related_collection": "procurement_orders" } },
    { "name": "supplier_id", "type": "m2o", "options": { "related_collection": "procurement_suppliers" } },
    { "name": "supplier_name", "type": "text", "required": true },
    { "name": "date", "type": "date", "required": true, "indexed": true },
    { "name": "items", "type": "json", "required": true },
    { "name": "total_value", "type": "decimal", "required": true, "defaultValue": 0 },
    { "name": "currency", "type": "text", "required": true, "defaultValue": "RON" },
    { "name": "status", "type": "enum", "required": true, "defaultValue": "draft", "indexed": true, "options": { "values": ["draft", "confirmed"] } },
    { "name": "discrepancies", "type": "textarea" },
    { "name": "confirmed_at", "type": "datetime" }
  ],
  "relations": [
    { "name": "procurement_reception_notes_order_id", "type": "m2o", "field": "order_id", "target": "procurement_orders", "targetField": "id", "onDelete": "RESTRICT", "onUpdate": "CASCADE", "metadata": {} },
    { "name": "procurement_reception_notes_supplier_id", "type": "m2o", "field": "supplier_id", "target": "procurement_suppliers", "targetField": "id", "onDelete": "RESTRICT", "onUpdate": "CASCADE", "metadata": {} }
  ],
  "validation": [
    {
      "field": "status",
      "rule": "transition",
      "config": { "expression": "previous == null ? value == null || value == 'draft' : previous == 'draft' ? value in ['draft', 'confirmed'] : value == previous" },
      "message": "A reception note is confirmed once; a confirmed note is final."
    }
  ]
}
