{
  "spec": "zveltio.view/2",
  "title": "compliance.gdpr.title",
  "type": "tabs",
  "items": [
    {
      "type": "list",
      "collection": "gdpr_subject_requests",
      "title": "compliance.gdpr.tab.requests",
      "fields": [
        {
          "field": "request_type",
          "label": "common.col.type",
          "display": "badge"
        },
        {
          "field": "created_by",
          "label": "common.col.subject"
        },
        {
          "field": "created_at",
          "label": "compliance.gdpr.col.requested"
        },
        {
          "field": "status",
          "label": "common.col.status",
          "display": "badge",
          "tones": {
            "pending": "warning",
            "in_progress": "info",
            "completed": "success",
            "rejected": "danger",
            "withdrawn": "muted"
          }
        }
      ],
      "sort": "-created_at",
      "rowActions": [
        {
          "action": "setRequestStatus",
          "label": "compliance.gdpr.btn.start",
          "input": {
            "id": {
              "$record": "id"
            },
            "status": "in_progress"
          },
          "when": [
            {
              "field": "status",
              "op": "eq",
              "value": "pending"
            }
          ]
        },
        {
          "action": "setRequestStatus",
          "label": "compliance.gdpr.btn.fulfill",
          "input": {
            "id": {
              "$record": "id"
            },
            "status": "completed"
          },
          "when": [
            {
              "field": "status",
              "op": "in",
              "value": [
                "pending",
                "in_progress"
              ]
            }
          ]
        },
        {
          "action": "setRequestStatus",
          "label": "common.reject",
          "tone": "danger",
          "input": {
            "id": {
              "$record": "id"
            },
            "status": "rejected"
          },
          "when": [
            {
              "field": "status",
              "op": "in",
              "value": [
                "pending",
                "in_progress"
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "list",
      "collection": "gdpr_breaches",
      "title": "compliance.gdpr.tab.breaches",
      "fields": [
        {
          "field": "discovered_at",
          "label": "common.col.date"
        },
        {
          "field": "description",
          "label": "common.col.description"
        },
        {
          "field": "severity",
          "label": "compliance.gdpr.col.severity",
          "display": "badge",
          "tones": {
            "low": "info",
            "medium": "warning",
            "high": "danger",
            "critical": "danger"
          }
        },
        {
          "field": "affected_records_estimate",
          "label": "compliance.gdpr.col.affected"
        },
        {
          "field": "dpa_reported_at",
          "label": "compliance.gdpr.col.notifiedDpa"
        }
      ],
      "sort": "-discovered_at"
    },
    {
      "type": "list",
      "collection": "gdpr_consent_records",
      "title": "compliance.gdpr.tab.consents",
      "fields": [
        {
          "field": "created_by",
          "label": "common.col.subject"
        },
        {
          "field": "purpose",
          "label": "compliance.gdpr.col.purpose"
        },
        {
          "field": "created_at",
          "label": "compliance.gdpr.col.granted"
        },
        {
          "field": "withdrawn_at",
          "label": "compliance.gdpr.col.withdrawn"
        }
      ],
      "sort": "-created_at"
    },
    {
      "type": "list",
      "collection": "gdpr_processing_activities",
      "title": "compliance.gdpr.tab.records",
      "fields": [
        {
          "field": "name",
          "label": "compliance.gdpr.col.activity"
        },
        {
          "field": "legal_basis",
          "label": "compliance.gdpr.col.lawfulBasis"
        },
        {
          "field": "data_categories",
          "label": "compliance.gdpr.col.categories"
        },
        {
          "field": "retention_period_days",
          "label": "compliance.gdpr.col.retention"
        }
      ],
      "filter": [
        {
          "field": "is_active",
          "op": "eq",
          "value": true
        }
      ],
      "sort": "name"
    }
  ]
}
