{
  "sduiSchema": 1,
  "title": "compliance.gdpr.title",
  "subtitle": "compliance.gdpr.subtitle",
  "resources": [
    {
      "id": "requests",
      "label": "compliance.gdpr.tab.requests",
      "icon": "Users",
      "dataSource": "/api/data/gdpr_subject_requests?sort=created_at&order=desc&limit=500",
      "dataPath": "records",
      "columns": [
        {
          "key": "request_type",
          "label": "common.col.type",
          "type": "badge",
          "badge": {
            "colors": {}
          }
        },
        {
          "key": "created_by",
          "label": "common.col.subject"
        },
        {
          "key": "created_at",
          "label": "compliance.gdpr.col.requested",
          "type": "date"
        },
        {
          "key": "status",
          "label": "common.col.status",
          "type": "badge",
          "badge": {
            "colors": {
              "pending": "badge-warning",
              "in_progress": "badge-info",
              "completed": "badge-success",
              "rejected": "badge-error",
              "withdrawn": "badge-ghost"
            }
          }
        }
      ],
      "rowActions": [
        {
          "id": "fulfill",
          "label": "compliance.gdpr.btn.fulfill",
          "method": "POST",
          "endpoint": "/ext/compliance/gdpr/actions/setRequestStatus",
          "body": {
            "id": "{id}",
            "status": "completed"
          },
          "visibleWhen": {
            "field": "status",
            "equals": "pending"
          }
        },
        {
          "id": "reject",
          "label": "common.reject",
          "variant": "text-error",
          "method": "POST",
          "endpoint": "/ext/compliance/gdpr/actions/setRequestStatus",
          "body": {
            "id": "{id}",
            "status": "rejected"
          },
          "visibleWhen": {
            "field": "status",
            "equals": "pending"
          }
        }
      ]
    },
    {
      "id": "breaches",
      "label": "compliance.gdpr.tab.breaches",
      "icon": "XCircle",
      "dataSource": "/api/data/gdpr_breaches?sort=discovered_at&order=desc&limit=500",
      "dataPath": "records",
      "columns": [
        {
          "key": "discovered_at",
          "label": "common.col.date",
          "type": "date"
        },
        {
          "key": "description",
          "label": "common.col.description"
        },
        {
          "key": "severity",
          "label": "compliance.gdpr.col.severity",
          "type": "badge",
          "badge": {
            "colors": {
              "low": "badge-info",
              "medium": "badge-warning",
              "high": "badge-error",
              "critical": "badge-error"
            }
          }
        },
        {
          "key": "affected_records_estimate",
          "label": "compliance.gdpr.col.affected"
        },
        {
          "key": "dpa_reported_at",
          "label": "compliance.gdpr.col.notifiedDpa",
          "type": "boolean"
        }
      ]
    },
    {
      "id": "consents",
      "label": "compliance.gdpr.tab.consents",
      "dataSource": "/api/data/gdpr_consent_records?sort=created_at&order=desc&limit=500",
      "dataPath": "records",
      "columns": [
        {
          "key": "created_by",
          "label": "common.col.subject"
        },
        {
          "key": "purpose",
          "label": "compliance.gdpr.col.purpose"
        },
        {
          "key": "created_at",
          "label": "compliance.gdpr.col.granted",
          "type": "date"
        },
        {
          "key": "withdrawn_at",
          "label": "compliance.gdpr.col.withdrawn",
          "type": "date"
        }
      ]
    },
    {
      "id": "records",
      "label": "compliance.gdpr.tab.records",
      "icon": "Boxes",
      "dataSource": "/api/data/gdpr_processing_activities?is_active[eq]=true&sort=name&order=asc&limit=500",
      "dataPath": "records",
      "columns": [
        {
          "key": "name",
          "label": "compliance.gdpr.col.activity"
        },
        {
          "key": "legal_basis",
          "label": "compliance.gdpr.col.lawfulBasis"
        },
        {
          "key": "data_categories",
          "label": "compliance.gdpr.col.categories"
        },
        {
          "key": "retention_period_days",
          "label": "compliance.gdpr.col.retention"
        }
      ]
    }
  ]
}
