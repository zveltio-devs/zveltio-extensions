{
  "spec": "zveltio.view/2",
  "title": "communications.mail.title",
  "type": "tabs",
  "items": [
    {
      "type": "list",
      "collection": "mail_accounts",
      "title": "communications.mail.tab.accounts",
      "fields": [
        {
          "field": "name",
          "label": "common.col.name"
        },
        {
          "field": "email_address",
          "label": "common.col.email"
        },
        {
          "field": "imap_host",
          "label": "communications.mail.col.host",
          "display": "mono"
        },
        {
          "field": "sync_status",
          "label": "communications.mail.col.syncStatus",
          "display": "badge"
        },
        {
          "field": "last_sync_at",
          "label": "communications.mail.col.lastSync"
        },
        {
          "field": "is_default",
          "label": "communications.mail.col.default"
        }
      ],
      "sort": "name",
      "edit": true,
      "delete": true,
      "rowActions": [
        {
          "action": "sync",
          "label": "common.sync",
          "input": {
            "account_id": {
              "$record": "id"
            }
          }
        }
      ],
      "create": true
    },
    {
      "type": "list",
      "collection": "mail_identities",
      "title": "communications.mail.tab.identities",
      "fields": [
        {
          "field": "email_address",
          "label": "common.col.email"
        },
        {
          "field": "display_name",
          "label": "communications.mail.form.displayName"
        },
        {
          "field": "is_default",
          "label": "communications.mail.col.default"
        }
      ],
      "sort": "email_address",
      "edit": true,
      "delete": true,
      "create": true
    },
    {
      "type": "list",
      "collection": "mail_signatures",
      "title": "communications.mail.tab.signatures",
      "fields": [
        {
          "field": "name",
          "label": "common.col.name"
        },
        {
          "field": "is_default",
          "label": "communications.mail.col.default"
        }
      ],
      "sort": "name",
      "edit": true,
      "delete": true,
      "create": true
    },
    {
      "type": "list",
      "collection": "mail_filters",
      "title": "communications.mail.tab.filters",
      "fields": [
        {
          "field": "name",
          "label": "common.col.name"
        },
        {
          "field": "sort_order",
          "label": "communications.mail.form.sortOrder"
        },
        {
          "field": "is_active",
          "label": "communications.mail.col.active"
        }
      ],
      "sort": "sort_order",
      "edit": true,
      "delete": true,
      "create": true
    },
    {
      "type": "list",
      "collection": "mail_contacts",
      "title": "communications.mail.tab.contacts",
      "fields": [
        {
          "field": "email_address",
          "label": "common.col.email"
        },
        {
          "field": "display_name",
          "label": "communications.mail.form.displayName"
        }
      ],
      "sort": "email_address",
      "edit": true,
      "delete": true,
      "create": true
    }
  ]
}
