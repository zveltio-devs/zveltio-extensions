{
  "sduiSchema": 1,
  "title": "communications.mail.title",
  "subtitle": "communications.mail.subtitle",
  "newLabel": "common.new",
  "resources": [
    {
      "id": "accounts",
      "label": "communications.mail.tab.accounts",
      "icon": "Mail",
      "dataSource": "/ext/communications/mail/accounts",
      "dataPath": "accounts",
      "columns": [
        {
          "key": "name",
          "label": "common.col.name"
        },
        {
          "key": "email_address",
          "label": "common.col.email"
        },
        {
          "key": "imap_host",
