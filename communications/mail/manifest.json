{
  "name": "communications/mail",
  "displayName": "Mail Client",
  "category": "communications",
  "description": "IMAP/SMTP email client with AI features, filter rules, attachments and contacts. Password or OAuth2 (Gmail/Outlook). Filters are applied locally to messages a sync fetches, not on the mail server. Move-to-another-folder from the UI is local only.",
  "version": "1.0.13",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-mail",
  "permissions": [
    "database",
    "secrets",
    "settings"
  ],
  "dependencies": [
    {
      "name": "ai",
      "minVersion": "1.0.0"
    }
  ],
  "peerDependencies": {
    "imapflow": "^1.0.0",
    "mailparser": "^3.6.0",
    "nodemailer": "^9.0.0"
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/mail",
        "label": "Mail",
        "icon": "Mail"
      }
    ],
    "navGroup": "communications"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "fieldTypes": []
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": true
  },
  "integrity": {
    "engineSha256": "cf0a3c7c6b5bd8da382544dc60c00ddc1f5bee9fb94abb6b8ca46f11ed0a9134",
    "sourceSha256": "7925b6eb3d88fa5eb8b970e32ab6ae7f4d161749c6cf707f617725a2f0faa649"
  }
}
