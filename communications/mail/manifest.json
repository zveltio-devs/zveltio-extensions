{
  "name": "communications/mail",
  "displayName": "Mail Client",
  "category": "communications",
  "description": "IMAP/SMTP mail client: accounts, folders, messages, drafts, identities, signatures, filters and contacts as collections; syncing and sending run as jobs that reach only the mail servers an operator binds to the \"mail\" slot.",
  "version": "2.0.0",
  "zveltioMinVersion": "3.0.0-beta.109",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-mail",
  "permissions": [
    "data:system",
    "files"
  ],
  "i18nPrefixes": [
    "communications"
  ],
  "studio": {
    "pages": [
      {
        "path": "/admin/mail",
        "label": "Mail",
        "icon": "Mail",
        "schema": "schemas/mail.json"
      },
      {
        "path": "/admin/mail/inbox",
        "label": "Inbox",
        "icon": "Inbox"
      }
    ],
    "navGroup": "communications"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "fieldTypes": []
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "collections": [
    "mail_accounts",
    "mail_folders",
    "mail_messages",
    "mail_attachments",
    "mail_drafts",
    "mail_identities",
    "mail_signatures",
    "mail_filters",
    "mail_contacts"
  ],
  "actions": [
    {
      "name": "sync",
      "permission": {
        "resource": "mail_accounts",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "account_id"
        ],
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "mail_accounts"
      ],
      "writes": [
        "mail_accounts"
      ],
      "enqueues": [
        "sync"
      ]
    },
    {
      "name": "send",
      "permission": {
        "resource": "mail_drafts",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "draft_id"
        ],
        "additionalProperties": false,
        "properties": {
          "draft_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "mail_drafts",
        "mail_accounts"
      ],
      "writes": [
        "mail_drafts"
      ],
      "enqueues": [
        "send"
      ]
    },
    {
      "name": "setFlags",
      "permission": {
        "resource": "mail_messages",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "message_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "message_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "is_read": {
            "type": "boolean"
          },
          "is_starred": {
            "type": "boolean"
          }
        }
      },
      "reads": [
        "mail_messages"
      ],
      "writes": [
        "mail_messages"
      ],
      "enqueues": [
        "apply"
      ]
    },
    {
      "name": "moveMessages",
      "permission": {
        "resource": "mail_messages",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "message_ids",
          "folder_id"
        ],
        "additionalProperties": false,
        "properties": {
          "message_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "folder_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "mail_messages",
        "mail_folders",
        "mail_accounts"
      ],
      "writes": [],
      "enqueues": [
        "apply"
      ]
    },
    {
      "name": "deleteMessages",
      "permission": {
        "resource": "mail_messages",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "message_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "message_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "reads": [
        "mail_messages",
        "mail_accounts"
      ],
      "writes": [],
      "enqueues": [
        "apply"
      ]
    },
    {
      "name": "createFolder",
      "permission": {
        "resource": "mail_accounts",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "account_id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        }
      },
      "reads": [
        "mail_accounts"
      ],
      "writes": [],
      "enqueues": [
        "apply"
      ]
    },
    {
      "name": "renameFolder",
      "permission": {
        "resource": "mail_folders",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "folder_id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "folder_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        }
      },
      "reads": [
        "mail_folders",
        "mail_accounts"
      ],
      "writes": [],
      "enqueues": [
        "apply"
      ]
    },
    {
      "name": "deleteFolder",
      "permission": {
        "resource": "mail_folders",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "folder_id"
        ],
        "additionalProperties": false,
        "properties": {
          "folder_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "mail_folders",
        "mail_accounts"
      ],
      "writes": [],
      "enqueues": [
        "apply"
      ]
    }
  ],
  "jobs": [
    {
      "name": "sync",
      "input": {
        "type": "object",
        "required": [
          "account_id"
        ],
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "mail_accounts",
        "mail_folders",
        "mail_messages",
        "mail_filters"
      ],
      "writes": [
        "mail_accounts",
        "mail_folders",
        "mail_messages",
        "mail_attachments"
      ],
      "egressSlots": [
        {
          "name": "mail",
          "kind": "tcp"
        }
      ],
      "retry": {
        "limit": 0,
        "backoff": true
      },
      "timeoutSeconds": 600
    },
    {
      "name": "send",
      "input": {
        "type": "object",
        "required": [
          "draft_id"
        ],
        "additionalProperties": false,
        "properties": {
          "draft_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "mail_drafts",
        "mail_accounts",
        "mail_identities",
        "mail_folders",
        "mail_contacts"
      ],
      "writes": [
        "mail_drafts",
        "mail_contacts"
      ],
      "egressSlots": [
        {
          "name": "mail",
          "kind": "tcp"
        }
      ],
      "retry": {
        "limit": 0,
        "backoff": true
      },
      "timeoutSeconds": 300
    },
    {
      "name": "apply",
      "input": {
        "type": "object",
        "required": [
          "account_id",
          "op"
        ],
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid"
          },
          "op": {
            "type": "string",
            "enum": [
              "flags",
              "move",
              "delete",
              "createFolder",
              "renameFolder",
              "deleteFolder"
            ]
          },
          "message_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "is_read": {
            "type": "boolean"
          },
          "is_starred": {
            "type": "boolean"
          },
          "folder_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        }
      },
      "reads": [
        "mail_accounts",
        "mail_folders",
        "mail_messages"
      ],
      "writes": [
        "mail_accounts",
        "mail_folders",
        "mail_messages",
        "mail_attachments"
      ],
      "egressSlots": [
        {
          "name": "mail",
          "kind": "tcp"
        }
      ],
      "retry": {
        "limit": 0,
        "backoff": true
      },
      "timeoutSeconds": 300
    }
  ],
  "integrity": {
    "engineSha256": "e4f54d336588785f34e7ca046e17062fd14af1cf59d1a7059989fc0508ba14a5",
    "sourceSha256": "3835bd9bf68c04611f68c690287f786145da0345759ca47ec50c7da50c07236a",
    "schemaSha256": "f50f21733799b53115db6aa987730a7a6048d641a7a62ea428804f7c53c9335d",
    "jobsSha256": "1d3560c775e73dc9077b31ded81c303dd3a8b3825f9128d4acb63be77d78827c"
  }
}
