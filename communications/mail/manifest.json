{
  "name": "communications/mail",
  "displayName": "Mail Client",
  "category": "communications",
  "description": "IMAP/SMTP email client with AI features, filter rules and contacts. Reads and sends mail; read, star and delete are pushed to the IMAP server. Filters are applied locally to messages a sync fetches, not on the mail server. Attachments are listed and downloadable, streamed from the server on demand rather than stored.",
  "version": "1.0.11",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-mail",
  "permissions": [
    "database",
    "secrets",
    "settings"
  ],
  "dependencies": [
    {
      "name": "ai",
      "minVersion": "1.0.0"
    }
  ],
  "peerDependencies": {
    "imapflow": "^1.0.0",
    "mailparser": "^3.6.0",
    "nodemailer": "^9.0.0"
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/mail",
        "label": "Mail",
        "icon": "Mail"
      }
    ],
    "navGroup": "communications"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "fieldTypes": []
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": true
  },
  "integrity": {
    "engineSha256": "a5acd02f4847b5ddadf17fd0fc000413480991381ea024c20d713c81272190ce",
    "sourceSha256": "3dc233a74af87c31bfb5fa1f69f68b953b70536a822859d0fc064574eb77524d"
  }
}
