{
  "name": "communications/mail",
  "displayName": "Mail Client",
  "category": "communications",
  "description": "IMAP/SMTP email client with AI features, filter rules and contacts. Reads mail and sends it; filters are applied locally to messages a sync fetches, not on the mail server. read/star/move/delete are local only and do not yet propagate to IMAP. Attachments are listed, not downloaded.",
  "version": "1.0.7",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-mail",
  "permissions": [
    "database",
    "secrets",
    "settings"
  ],
  "dependencies": [
    {
      "name": "ai",
      "minVersion": "1.0.0"
    }
  ],
  "peerDependencies": {
    "imapflow": "^1.0.0",
    "mailparser": "^3.6.0",
    "nodemailer": "^9.0.0"
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/mail",
        "label": "Mail",
        "icon": "Mail"
      }
    ],
    "navGroup": "communications"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "fieldTypes": []
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": true
  },
  "integrity": {
    "engineSha256": "7e88c0f9227bcfd17b7785db286dc612a324a5ebd9409070f8da9dedc4bb0ecc",
    "sourceSha256": "dbe9fc65272b1515773fac60481a3a689e934b86dd3bcfd3c03fdcd63fafdc46"
  }
}
