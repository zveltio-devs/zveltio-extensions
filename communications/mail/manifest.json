{
  "name": "communications/mail",
  "displayName": "Mail Client",
  "category": "communications",
  "description": "IMAP/SMTP email client with AI features, filter rules, attachments and contacts. Password or OAuth2 (Gmail/Outlook). Background sync on a schedule. Filter actions and read/star/delete are pushed to the mail server.",
  "version": "1.2.7",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-mail",
  "permissions": [
    "database",
    "secrets",
    "settings"
  ],
  "i18nPrefixes": [
    "communications"
  ],
  "dependencies": [
    {
      "name": "ai",
      "minVersion": "1.0.0"
    }
  ],
  "peerDependencies": {
    "imapflow": "^1.0.0",
    "mailparser": "^3.6.0",
    "nodemailer": "^10.0.13"
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/mail",
        "label": "Mail",
        "icon": "Mail",
        "schema": "schemas/mail.json"
      },
      {
        "path": "/admin/mail/inbox",
        "label": "Inbox",
        "icon": "Inbox"
      }
    ],
    "navGroup": "communications"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "fieldTypes": []
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": true
  },
  "integrity": {
    "engineSha256": "f21947e5804ab3022c2441bfffb873569c61298173e6167089750978c1c92a9e",
    "sourceSha256": "2a51daa6454d6d733e5da7c39d8f105936b28c629fcd91ab4cf98ede8a548cbc"
  }
}
