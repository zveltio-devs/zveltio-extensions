{
  "name": "communications/mail",
  "displayName": "Mail Client",
  "category": "communications",
  "description": "IMAP/SMTP mail client: accounts, folders, messages, drafts, identities, signatures, filters and contacts as collections; syncing and sending run as jobs that reach only the mail servers an operator binds to the \"mail\" slot.",
  "version": "2.2.0",
  "zveltioMinVersion": "3.0.0-beta.117",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-mail",
  "permissions": [
    "data:system",
    "files"
  ],
  "i18nPrefixes": [
    "communications"
  ],
  "studio": {
    "pages": [
      {
        "path": "/admin/mail",
        "label": "Mail",
        "icon": "Mail",
        "schema": "schemas/mail.json"
      },
      {
        "path": "/admin/mail/inbox",
        "label": "Inbox",
        "icon": "Inbox",
        "schema": "schemas/inbox.json"
      },
      {
        "path": "/admin/mail/compose",
        "label": "Compose",
        "icon": "PenLine",
        "schema": "schemas/compose.json"
      },
      {
        "path": "/admin/mail/thread",
        "label": "Conversation",
        "icon": "MessagesSquare",
        "schema": "schemas/thread.json"
      }
    ],
    "navGroup": "communications"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "fieldTypes": []
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "collections": [
    "mail_accounts",
    "mail_folders",
    "mail_messages",
    "mail_attachments",
    "mail_drafts",
    "mail_identities",
    "mail_signatures",
    "mail_filters",
    "mail_contacts"
  ],
  "actions": [
    {
      "name": "sync",
      "permission": {
        "resource": "mail_accounts",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "account_id"
        ],
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "mail_accounts"
      ],
      "writes": [
        "mail_accounts"
      ],
      "enqueues": [
        "sync"
      ]
    },
    {
      "name": "send",
      "permission": {
        "resource": "mail_drafts",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "draft_id"
        ],
        "additionalProperties": false,
        "properties": {
          "draft_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "mail_drafts",
        "mail_accounts"
      ],
      "writes": [
        "mail_drafts"
      ],
      "enqueues": [
        "send"
      ]
    },
    {
      "name": "fetchAttachment",
      "permission": {
        "resource": "mail_attachments",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "attachment_id"
        ],
        "additionalProperties": false,
        "properties": {
          "attachment_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "mail_attachments",
        "mail_messages",
        "mail_accounts"
      ],
      "writes": [
        "mail_attachments"
      ],
      "enqueues": [
        "fetchAttachment"
      ]
    },
    {
      "name": "openAttachment",
      "permission": {
        "resource": "mail_attachments",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "attachment_id"
        ],
        "additionalProperties": false,
        "properties": {
          "attachment_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "mail_attachments"
      ],
      "writes": []
    },
    {
      "name": "newDraft",
      "permission": {
        "resource": "mail_accounts",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "account_id"
        ],
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "mail_accounts"
      ],
      "writes": [
        "mail_drafts"
      ]
    },
    {
      "name": "reply",
      "permission": {
        "resource": "mail_messages",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "message_id",
          "mode"
        ],
        "additionalProperties": false,
        "properties": {
          "message_id": {
            "type": "string",
            "format": "uuid"
          },
          "mode": {
            "type": "string",
            "enum": [
              "reply",
              "reply_all",
              "forward"
            ]
          }
        }
      },
      "reads": [
        "mail_messages",
        "mail_accounts",
        "mail_attachments"
      ],
      "writes": [
        "mail_drafts"
      ]
    },
    {
      "name": "setFlags",
      "permission": {
        "resource": "mail_messages",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "message_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "message_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "is_read": {
            "type": "boolean"
          },
          "is_starred": {
            "type": "boolean"
          }
        }
      },
      "reads": [
        "mail_messages"
      ],
      "writes": [
        "mail_messages"
      ],
      "enqueues": [
        "apply"
      ]
    },
    {
      "name": "moveMessages",
      "permission": {
        "resource": "mail_messages",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "message_ids",
          "folder_id"
        ],
        "additionalProperties": false,
        "properties": {
          "message_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "folder_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "mail_messages",
        "mail_folders",
        "mail_accounts"
      ],
      "writes": [],
      "enqueues": [
        "apply"
      ]
    },
    {
      "name": "deleteMessages",
      "permission": {
        "resource": "mail_messages",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "message_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "message_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "reads": [
        "mail_messages",
        "mail_accounts"
      ],
      "writes": [],
      "enqueues": [
        "apply"
      ]
    },
    {
      "name": "createFolder",
      "permission": {
        "resource": "mail_accounts",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "account_id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        }
      },
      "reads": [
        "mail_accounts"
      ],
      "writes": [],
      "enqueues": [
        "apply"
      ]
    },
    {
      "name": "renameFolder",
      "permission": {
        "resource": "mail_folders",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "folder_id",
          "name"
        ],
        "additionalProperties": false,
        "properties": {
          "folder_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        }
      },
      "reads": [
        "mail_folders",
        "mail_accounts"
      ],
      "writes": [],
      "enqueues": [
        "apply"
      ]
    },
    {
      "name": "deleteFolder",
      "permission": {
        "resource": "mail_folders",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "folder_id"
        ],
        "additionalProperties": false,
        "properties": {
          "folder_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "mail_folders",
        "mail_accounts"
      ],
      "writes": [],
      "enqueues": [
        "apply"
      ]
    }
  ],
  "jobs": [
    {
      "name": "sync",
      "input": {
        "type": "object",
        "required": [
          "account_id"
        ],
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "mail_accounts",
        "mail_folders",
        "mail_messages",
        "mail_filters"
      ],
      "writes": [
        "mail_accounts",
        "mail_folders",
        "mail_messages",
        "mail_attachments"
      ],
      "egressSlots": [
        {
          "name": "mail",
          "kind": "tcp"
        }
      ],
      "retry": {
        "limit": 0,
        "backoff": true
      },
      "timeoutSeconds": 600
    },
    {
      "name": "send",
      "input": {
        "type": "object",
        "required": [
          "draft_id"
        ],
        "additionalProperties": false,
        "properties": {
          "draft_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "mail_drafts",
        "mail_accounts",
        "mail_identities",
        "mail_folders",
        "mail_contacts"
      ],
      "writes": [
        "mail_drafts",
        "mail_contacts"
      ],
      "egressSlots": [
        {
          "name": "mail",
          "kind": "tcp"
        }
      ],
      "retry": {
        "limit": 0,
        "backoff": true
      },
      "timeoutSeconds": 300
    },
    {
      "name": "fetchAttachment",
      "input": {
        "type": "object",
        "required": [
          "attachment_id"
        ],
        "additionalProperties": false,
        "properties": {
          "attachment_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "mail_attachments",
        "mail_messages",
        "mail_folders",
        "mail_accounts"
      ],
      "writes": [
        "mail_attachments"
      ],
      "egressSlots": [
        {
          "name": "mail",
          "kind": "tcp"
        }
      ],
      "retry": {
        "limit": 1,
        "backoff": true
      },
      "timeoutSeconds": 300
    },
    {
      "name": "apply",
      "input": {
        "type": "object",
        "required": [
          "account_id",
          "op"
        ],
        "additionalProperties": false,
        "properties": {
          "account_id": {
            "type": "string",
            "format": "uuid"
          },
          "op": {
            "type": "string",
            "enum": [
              "flags",
              "move",
              "delete",
              "createFolder",
              "renameFolder",
              "deleteFolder"
            ]
          },
          "message_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "is_read": {
            "type": "boolean"
          },
          "is_starred": {
            "type": "boolean"
          },
          "folder_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
          }
        }
      },
      "reads": [
        "mail_accounts",
        "mail_folders",
        "mail_messages"
      ],
      "writes": [
        "mail_accounts",
        "mail_folders",
        "mail_messages",
        "mail_attachments"
      ],
      "egressSlots": [
        {
          "name": "mail",
          "kind": "tcp"
        }
      ],
      "retry": {
        "limit": 0,
        "backoff": true
      },
      "timeoutSeconds": 300
    }
  ],
  "integrity": {
    "engineSha256": "1b87dc060570e0894b9068981583a72f5c93f9486f6aeb99bf0cce6dd7db7efb",
    "sourceSha256": "da3723d2ccc694a66a5c2d834ddc9507cbaaa21d08fed38fc69df82df7bee6cc",
    "schemaSha256": "58d078d6236c4e595df2571633470c5b0891baaa36277fece90513206b911aff",
    "jobsSha256": "40d939a2b5eed29667a297f12d4babe775fcd4a573b549da85fcc575b5b0c2ae"
  }
}
