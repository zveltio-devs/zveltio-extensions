      "required": true
    },
    {
      "name": "smtp_port",
      "type": "integer",
      "required": true,
      "defaultValue": 465
    },
    {
      "name": "smtp_tls",
      "type": "enum",
      "required": true,
      "defaultValue": "implicit",
      "options": {
        "values": [
          "implicit",
          "starttls",
          "none"
        ]
      }
    },
    {
      "name": "smtp_user",
      "type": "text"
    },
    {
      "name": "smtp_password",
      "type": "secret"
