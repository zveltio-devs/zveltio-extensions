    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "integrity": {
    "engineSha256": "2f9d11e420053f30c3e86d5a86882ce80f1bc2bc54d7756f294f201a7106a538",
