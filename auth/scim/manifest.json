      {
        "path": "/admin/auth/scim",
        "label": "SCIM Provisioning",
        "icon": "KeyRound",
        "schema": "schemas/scim.json"
      }
    ]
  },
  "globalRoutes": [
    "/scim/v2/*"
  ]
