{
  "name": "auth/scim",
  "displayName": "SCIM Provisioning",
  "category": "auth",
  "description": "SCIM 2.0 user provisioning for Azure AD / Entra, Okta and other identity providers — engine API keys, Users CRUD, active-flag offboarding",
  "version": "3.0.0",
  "zveltioMinVersion": "3.0.0-beta.114",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-scim",
  "permissions": [
    "identity:provision"
  ],
  "routes": [
    {
      "method": "GET",
      "path": "/v2/ServiceProviderConfig",
      "access": "caller",
      "handler": "serviceProviderConfig"
    },
    {
      "method": "GET",
      "path": "/v2/Users",
      "access": "caller",
      "handler": "listUsers"
    },
    {
      "method": "POST",
      "path": "/v2/Users",
      "access": "caller",
      "handler": "createUser"
    },
    {
      "method": "GET",
      "path": "/v2/Users/:id",
      "access": "caller",
      "handler": "getUser"
    },
    {
      "method": "PUT",
      "path": "/v2/Users/:id",
      "access": "caller",
      "handler": "replaceUser"
    },
    {
      "method": "PATCH",
      "path": "/v2/Users/:id",
      "access": "caller",
      "handler": "patchUser"
    },
    {
      "method": "DELETE",
      "path": "/v2/Users/:id",
      "access": "caller",
      "handler": "deleteUser"
    },
    {
      "method": "GET",
      "path": "/v2/Groups",
      "access": "caller",
      "handler": "listGroups"
    }
  ],
  "apiKeyRoutes": [
    "GET /v2/*",
    "POST /v2/Users",
    "PUT /v2/Users/*",
    "PATCH /v2/Users/*",
    "DELETE /v2/Users/*"
  ],
  "contributes": {
    "engine": true,
    "studio": false
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "integrity": {
    "engineSha256": "2138bb1bd5071f2c1780989d7163b01f55c2e1db7f64fac8bd03fffbf49dd2fc",
    "sourceSha256": "f1f6364de60a0819af04c25840c9181db5521db6787a278b7ee003ea3f68c17c"
  }
}
