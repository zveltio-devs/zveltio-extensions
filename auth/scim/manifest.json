{
  "name": "auth/scim",
  "displayName": "SCIM Provisioning",
  "category": "auth",
  "description": "SCIM 2.0 user provisioning for Azure AD / Entra, Okta and other identity providers — bearer tokens, Users CRUD, active-flag offboarding",
  "version": "3.0.0",
  "zveltioMinVersion": "3.0.0-beta.114",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-scim",
  "permissions": [
    "identity:provision",
    "secrets",
    "data:system",
    "data:write"
  ],
  "i18nPrefixes": [
    "auth.scim"
  ],
  "routes": [
    {
      "method": "POST",
      "path": "/tokens",
      "access": "caller",
      "handler": "mintToken"
    },
    {
      "method": "GET",
      "path": "/v2/ServiceProviderConfig",
      "access": "public",
      "handler": "serviceProviderConfig"
    },
    {
      "method": "GET",
      "path": "/v2/Users",
      "access": "public",
      "handler": "listUsers"
    },
    {
      "method": "POST",
      "path": "/v2/Users",
      "access": "public",
      "handler": "createUser"
    },
    {
      "method": "GET",
      "path": "/v2/Users/:id",
      "access": "public",
      "handler": "getUser"
    },
    {
      "method": "PUT",
      "path": "/v2/Users/:id",
      "access": "public",
      "handler": "replaceUser"
    },
    {
      "method": "PATCH",
      "path": "/v2/Users/:id",
      "access": "public",
      "handler": "patchUser"
    },
    {
      "method": "DELETE",
      "path": "/v2/Users/:id",
      "access": "public",
      "handler": "deleteUser"
    },
    {
      "method": "GET",
      "path": "/v2/Groups",
      "access": "public",
      "handler": "listGroups"
    }
  ],
  "contributes": {
    "engine": true,
    "studio": true
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "integrity": {
    "engineSha256": "e67e7f3cd58ab1975239448cfb82fe8b2a8fcd76c55ea8bf3cf6d74c16278b5d",
    "sourceSha256": "04e843ea758ddbfde6bda5b80e531df68b7dc0a2c5a0179790cae64b373934b9",
    "schemaSha256": "501c280ce551916a2b0f6baf195b8b7ff0e89673b9405543aaef0efc1b46264d"
  },
  "studio": {
    "navGroup": "other",
    "pages": [
      {
        "path": "/admin/auth/scim",
        "label": "SCIM Provisioning",
        "icon": "KeyRound",
        "schema": "schemas/scim.json"
      }
    ]
  },
  "collections": [
    "scim_tokens",
    "scim_users"
  ]
}
