  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": true
  },
  "integrity": {
    "engineSha256": "4bd26db67472724f960e2bead691bf1af3ef6656e2629e5eff22b4376482be63",
