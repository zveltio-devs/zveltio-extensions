{
  "name": "auth/ldap",
  "displayName": "LDAP / Active Directory",
  "category": "auth",
  "description": "Authenticate users via LDAP or Active Directory (ldapts)",
  "version": "1.1.8",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-auth-ldap",
  "permissions": [
    "auth:session",
    "database",
    "secrets"
