{
  "name": "auth/ldap",
  "displayName": "LDAP / Active Directory",
  "category": "auth",
  "description": "Authenticate users via LDAP or Active Directory (ldapts)",
  "version": "3.0.1",
  "zveltioMinVersion": "3.0.0-beta.113",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-auth-ldap",
  "permissions": [
    "auth:session",
    "data:system"
  ],
  "i18nPrefixes": [
    "auth.ldap"
  ],
  "routes": [
    {
      "method": "POST",
      "path": "/login",
      "access": "public",
      "handler": "login"
    }
  ],
  "signInProviders": [
    {
      "id": "ldap",
      "label": "LDAP / Active Directory",
      "kind": "credentials",
      "route": "/login"
    }
  ],
  "peerDependencies": {
    "ldapts": "^7.4.0"
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/auth/ldap",
        "label": "LDAP / AD",
        "icon": "Globe",
        "schema": "schemas/ldap.json"
      }
    ],
    "navGroup": "other"
  },
  "contributes": {
    "engine": true,
    "studio": true
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": true
  },
  "integrity": {
    "engineSha256": "85d831e767402c935884352b67f239896147179878fe7ba9e427201dc04dca5c",
    "sourceSha256": "cde8ebd4dd2e00d6ae4e1abd5966570d23b5630f3ad74d04e1e009c1bab92aa3",
    "schemaSha256": "9185a9e53b9c55d9af3afffa99e2a2c91f59f6375775e9ab3e73b759ba6061b0"
  },
  "collections": [
    "ldap_settings"
  ]
}
