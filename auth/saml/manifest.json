{
  "name": "auth/saml",
  "displayName": "SAML 2.0 SSO",
  "category": "auth",
  "description": "SAML 2.0 Single Sign-On with external Identity Providers (Okta, Azure AD, Google Workspace)",
  "version": "1.0.4",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-auth-saml",
  "permissions": [
    "auth:session",
    "database",
    "documents",
    "secrets"
  ],
  "peerDependencies": {
    "node-saml": "^3.1.0"
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/auth/saml",
        "label": "SAML SSO",
        "icon": "Lock",
        "schema": "schemas/saml.json"
      }
    ],
    "navGroup": "other"
  },
  "contributes": {
    "engine": true,
    "studio": true
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": true
  },
  "integrity": {
    "engineSha256": "e2acbdda77c7ed7c18381a9f7a929f81b122534199d61ddee216619b28d7fe0b",
    "sourceSha256": "87bb82fc3146c5b3d23af4337cf3c3615329c1c4769d528d9aa3b565a9880528"
  },
  "publicRoutes": [
    "/login",
    "/callback",
    "/metadata"
  ]
}
