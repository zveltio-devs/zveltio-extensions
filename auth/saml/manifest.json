{
  "name": "auth/saml",
  "displayName": "SAML 2.0 SSO",
  "category": "auth",
  "description": "SAML 2.0 Single Sign-On with external Identity Providers (Okta, Azure AD, Google Workspace)",
  "version": "1.0.3",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-auth-saml",
  "permissions": [
    "auth:session",
    "database",
    "documents",
    "secrets"
  ],
  "i18nPrefixes": [
    "auth.saml"
  ],
  "peerDependencies": {
    "node-saml": "^3.1.0"
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/auth/saml",
        "label": "SAML SSO",
        "icon": "Lock",
        "schema": "schemas/saml.json"
      }
    ],
    "navGroup": "other"
  },
  "contributes": {
    "engine": true,
    "studio": true
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": true
  },
  "integrity": {
    "engineSha256": "0c25844b58268af07fdc667afa877a97efaafd5c7b3f6de03f4c5bc5247c78f4",
    "sourceSha256": "e77617573502845db535db8981b9aea0a6ac24dbde2b0cda7342c7fee2177307"
  },
  "publicRoutes": [
    "/login",
    "/callback",
    "/metadata"
  ]
}
