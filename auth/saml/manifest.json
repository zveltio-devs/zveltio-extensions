{
  "name": "auth/saml",
  "displayName": "SAML 2.0 SSO",
  "category": "auth",
  "description": "SAML 2.0 Single Sign-On with external Identity Providers (Okta, Azure AD, Google Workspace)",
  "version": "1.1.0",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-auth-saml",
  "permissions": [
    "auth:session",
    "database",
    "documents",
    "secrets"
  ],
  "i18nPrefixes": [
    "auth.saml"
  ],
  "peerDependencies": {
    "node-saml": "^3.1.0"
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/auth/saml",
        "label": "SAML SSO",
        "icon": "Lock",
        "schema": "schemas/saml.json"
      }
    ],
    "navGroup": "other"
  },
  "contributes": {
    "engine": true,
    "studio": true
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": true
  },
  "integrity": {
    "engineSha256": "d18ecc8cb67b5dbb99d5e932fd9be6bf8d3e30e430f17b61e4ad74c66b3f2804",
    "sourceSha256": "79f396fcc380f69168be6406f12a851e5cba90cfdae6893340086421fd757d5d"
  },
  "publicRoutes": [
    "/login",
    "/callback",
    "/metadata"
  ]
}
