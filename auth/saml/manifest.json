{
  "name": "auth/saml",
  "displayName": "SAML 2.0 SSO",
  "category": "auth",
  "description": "SAML 2.0 Single Sign-On with external Identity Providers (Okta, Azure AD, Google Workspace)",
  "version": "2.0.0",
  "zveltioMinVersion": "3.0.0-beta.100",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-auth-saml",
  "permissions": [
    "auth:session",
    "identity:provision",
    "data:system"
  ],
  "i18nPrefixes": [
    "auth.saml"
  ],
  "peerDependencies": {
    "@node-saml/node-saml": "^5.1.0"
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/auth/saml",
        "label": "SAML SSO",
        "icon": "Lock",
        "schema": "schemas/saml.json"
      }
    ],
    "navGroup": "other"
  },
  "contributes": {
    "engine": true,
    "studio": true
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": true
  },
  "integrity": {
    "engineSha256": "0901b1dce0e6941570db9b41a3495d52f1388a1eed8096bf3042495fb5a05a09",
    "sourceSha256": "d56b346c5967864363c047577e68975652cb8dd9ec7e48c21af461cb558d4f8a",
    "schemaSha256": "6ba4b1c3077a44366481b26fd0a8fc4476658ee130cbf02c30681d840bbbeeed"
  },
  "publicRoutes": [
    "/login",
    "/callback",
    "/metadata"
  ],
  "collections": [
    "saml_settings",
    "saml_spent_assertions"
  ]
}
