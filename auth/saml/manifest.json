{
  "name": "auth/saml",
  "displayName": "SAML 2.0 SSO",
  "category": "auth",
  "description": "SAML 2.0 Single Sign-On with external Identity Providers (Okta, Azure AD, Google Workspace)",
  "version": "1.3.0",
  "zveltioMinVersion": "3.0.0-beta.77",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-auth-saml",
  "permissions": [
    "auth:session",
    "database",
    "documents",
    "secrets",
    "identity:provision"
  ],
  "i18nPrefixes": [
    "auth.saml"
  ],
  "peerDependencies": {
    "@node-saml/node-saml": "^5.1.0"
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/auth/saml",
        "label": "SAML SSO",
        "icon": "Lock",
        "schema": "schemas/saml.json"
      }
    ],
    "navGroup": "other"
  },
  "contributes": {
    "engine": true,
    "studio": true
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": true
  },
  "integrity": {
    "engineSha256": "84caee84f4431ca255ded8f671bcfc1fc6262af2f76fb466174ab1379a7a9444",
    "sourceSha256": "a8e2fbec50a5ab77c5c07e64b9e97dc1e5c865bf9ebdad1e2e25eadac006f9b2"
  },
  "publicRoutes": [
    "/login",
    "/callback",
    "/metadata"
  ]
}
