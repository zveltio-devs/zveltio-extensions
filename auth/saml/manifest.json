{
  "name": "auth/saml",
  "displayName": "SAML 2.0 SSO",
  "category": "auth",
  "description": "SAML 2.0 Single Sign-On with external Identity Providers (Okta, Azure AD, Google Workspace)",
  "version": "2.2.0",
  "zveltioMinVersion": "3.0.0-beta.113",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-auth-saml",
  "permissions": [
    "auth:session",
    "data:system"
  ],
  "i18nPrefixes": [
    "auth.saml"
  ],
  "routes": [
    {
      "method": "GET",
      "path": "/login",
      "access": "public",
      "handler": "login"
    },
    {
      "method": "POST",
      "path": "/callback",
      "access": "public",
      "handler": "callback"
    },
    {
      "method": "GET",
      "path": "/metadata",
      "access": "public",
      "handler": "metadata"
    }
  ],
  "signInProviders": [
    {
      "id": "saml",
      "label": "SAML single sign-on",
      "kind": "redirect",
      "route": "/login"
    }
  ],
  "peerDependencies": {
    "@node-saml/node-saml": "^5.1.0"
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/auth/saml",
        "label": "SAML SSO",
        "icon": "Lock",
        "schema": "schemas/saml.json"
      }
    ],
    "navGroup": "other"
  },
  "contributes": {
    "engine": true,
    "studio": true
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": true
  },
  "integrity": {
    "engineSha256": "92c3d4b0752c2ef77e3bc14decf0d30a77da90cbf3faad6dc606356b766867a5",
    "sourceSha256": "2d012d4596fbcb946cd6d12d29c8b427c37e61d55484f14466cb84deca3a1f8d",
    "schemaSha256": "6d9602b1cf2028153f6ae46bacd66d401ab53e7e52c975c61d9090f840c7611e"
  },
  "collections": [
    "saml_settings",
    "saml_spent_assertions"
  ]
}
