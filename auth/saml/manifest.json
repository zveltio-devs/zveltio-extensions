{
  "name": "auth/saml",
  "displayName": "SAML 2.0 SSO",
  "category": "auth",
  "description": "SAML 2.0 Single Sign-On with external Identity Providers (Okta, Azure AD, Google Workspace)",
  "version": "1.2.0",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-auth-saml",
  "permissions": [
    "auth:session",
    "database",
    "documents",
    "secrets"
  ],
  "i18nPrefixes": [
    "auth.saml"
  ],
  "peerDependencies": {
    "@node-saml/node-saml": "^5.1.0"
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/auth/saml",
        "label": "SAML SSO",
        "icon": "Lock",
        "schema": "schemas/saml.json"
      }
    ],
    "navGroup": "other"
  },
  "contributes": {
    "engine": true,
    "studio": true
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": true
  },
  "integrity": {
    "engineSha256": "718eda85353ed92416fdd22d8bed76aacd37fabfbe23106045e4fee9052f1e6d",
    "sourceSha256": "c7e78c31fc0933fd8b6ae052e81e9bdd38566f38244e7ec978da66883db0bb65"
  },
  "publicRoutes": [
    "/login",
    "/callback",
    "/metadata"
  ]
}
