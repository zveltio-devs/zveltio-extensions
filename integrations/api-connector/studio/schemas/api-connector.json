{
  "spec": "zveltio.view/2",
  "title": "integrations.api-connector.title",
  "type": "tabs",
  "items": [
    {
      "type": "list",
      "collection": "connector_connections",
      "title": "integrations.api-connector.tab.connections",
      "fields": [
        {
          "field": "name",
          "label": "common.col.name"
        },
        {
          "field": "base_url",
          "label": "integrations.api-connector.ui.base_url",
          "display": "mono"
        },
        {
          "field": "auth_type",
          "label": "integrations.api-connector.ui.auth"
        },
        {
          "field": "is_active",
          "label": "integrations.api-connector.col.active"
        }
      ],
      "sort": "name",
      "edit": true,
      "delete": true,
      "create": true
    },
    {
      "type": "list",
      "collection": "connector_endpoints",
      "title": "integrations.api-connector.tab.endpoints",
      "fields": [
        {
          "field": "name",
          "label": "common.col.name"
        },
        {
          "field": "method",
          "label": "integrations.api-connector.ui.method",
          "display": "mono"
        },
        {
          "field": "path",
          "label": "integrations.api-connector.ui.path",
          "display": "mono"
        },
        {
          "field": "is_active",
          "label": "integrations.api-connector.col.active"
        }
      ],
      "sort": "name",
      "edit": true,
      "delete": true,
      "rowActions": [
        {
          "action": "execute",
          "label": "integrations.api-connector.action.run",
          "input": {
            "endpoint_id": {
              "$record": "id"
            }
          }
        }
      ],
      "create": true
    },
    {
      "type": "list",
      "collection": "connector_calls",
      "title": "integrations.api-connector.tab.calls",
      "fields": [
        {
          "field": "created_at",
          "label": "integrations.api-connector.col.time"
        },
        {
          "field": "url",
          "label": "integrations.api-connector.col.url",
          "display": "mono"
        },
        {
          "field": "status",
          "label": "common.col.status",
          "display": "badge",
          "tones": {
            "pending": "warning",
            "running": "muted",
            "succeeded": "success",
            "failed": "danger"
          }
        },
        {
          "field": "response_status",
          "label": "integrations.api-connector.col.http_status"
        },
        {
          "field": "duration_ms",
          "label": "integrations.api-connector.col.duration"
        },
        {
          "field": "error",
          "label": "integrations.api-connector.col.error"
        }
      ],
      "sort": "-created_at"
    },
    {
      "type": "list",
      "collection": "connector_webhooks",
      "title": "integrations.api-connector.tab.webhooks",
      "fields": [
        {
          "field": "name",
          "label": "common.col.name"
        },
        {
          "field": "id",
          "label": "integrations.api-connector.col.url",
          "display": "mono"
        },
        {
          "field": "is_active",
          "label": "integrations.api-connector.col.active"
        },
        {
          "field": "last_received_at",
          "label": "integrations.api-connector.col.lastReceived"
        }
      ],
      "sort": "name",
      "edit": true,
      "delete": true,
      "create": true
    },
    {
      "type": "list",
      "collection": "connector_webhook_events",
      "title": "integrations.api-connector.tab.events",
      "fields": [
        {
          "field": "created_at",
          "label": "integrations.api-connector.col.time"
        },
        {
          "field": "source_ip",
          "label": "integrations.api-connector.col.source_ip",
          "display": "mono"
        },
        {
          "field": "payload",
          "label": "integrations.api-connector.col.payload"
        }
      ],
      "sort": "-created_at"
    }
  ]
}
