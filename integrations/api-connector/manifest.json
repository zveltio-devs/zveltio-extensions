{
  "name": "integrations/api-connector",
  "displayName": "API Connector",
  "category": "integrations",
  "description": "No-code HTTP integrations: call external REST APIs on hosts the operator allows, with retries, OAuth2 and a call log; receive signed incoming webhooks",
  "version": "2.2.0",
  "zveltioMinVersion": "3.0.0-beta.111",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-api-connector",
  "permissions": [
    "data:system"
  ],
  "i18nPrefixes": [
    "integrations.api-connector",
    "integrations.apiConnector"
  ],
  "studio": {
    "pages": [
      {
        "path": "/admin/integrations/api-connector",
        "label": "API Connector",
        "icon": "Plug",
        "schema": "schemas/api-connector.json"
      }
    ],
    "navGroup": "developer"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "fieldTypes": []
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "collections": [
    "connector_connections",
    "connector_endpoints",
    "connector_calls",
    "connector_webhooks",
    "connector_webhook_events"
  ],
  "routes": [
    {
      "method": "POST",
      "path": "/webhooks/receive",
      "access": "public",
      "handler": "receiveWebhook"
    }
  ],
  "actions": [
    {
      "name": "execute",
      "permission": {
        "resource": "connector_calls",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "endpoint_id"
        ],
        "additionalProperties": false,
        "properties": {
          "endpoint_id": {
            "type": "string",
            "format": "uuid"
          },
          "path_params": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "query_params": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "body": {
            "type": [
              "object",
              "array"
            ]
          }
        }
      },
      "reads": [
        "connector_endpoints",
        "connector_connections"
      ],
      "writes": [
        "connector_calls"
      ],
      "enqueues": [
        "call"
      ]
    }
  ],
  "jobs": [
    {
      "name": "call",
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "connector_calls",
        "connector_endpoints",
        "connector_connections"
      ],
      "writes": [
        "connector_calls",
        "connector_connections"
      ],
      "egressSlots": [
        "api"
      ],
      "retry": {
        "limit": 0,
        "backoff": true
      },
      "timeoutSeconds": 900
    },
    {
      "name": "receive",
      "input": {
        "type": "object",
        "required": [
          "webhook_id",
          "payload",
          "headers"
        ],
        "additionalProperties": false,
        "properties": {
          "webhook_id": {
            "type": "string",
            "format": "uuid"
          },
          "payload": {},
          "headers": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "maxLength": 4096
            }
          },
          "source_ip": {
            "type": "string",
            "maxLength": 512
          }
        }
      },
      "reads": [
        "connector_webhooks"
      ],
      "writes": [
        "connector_webhook_events",
        "connector_webhooks"
      ],
      "fromPublicRoutes": [
        "/webhooks/receive"
      ],
      "retry": {
        "limit": 5,
        "backoff": true
      },
      "timeoutSeconds": 60
    }
  ],
  "integrity": {
    "engineSha256": "6636e0483d97e068b3896a3bac4bc95f6271c194b06656c688f50a1a99a1355b",
    "sourceSha256": "fc48666fdc3e780c725769ffecfb8b66c3ad8075a5fc1c5870564890ad466327",
    "schemaSha256": "098ea2183cfaada6aa27816fe29c61f549ec18ea934333a1366cbab7ae55ffc8",
    "jobsSha256": "c0680162cfbb72cbb922a9aeeb4d8740b52e9c36c489886f021f3d5fb69e045e"
  }
}
