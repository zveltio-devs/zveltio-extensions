{
  "name": "integrations/migrators",
  "displayName": "Data Migrators",
  "category": "integrations",
  "description": "Import your data from HubSpot, Notion and Airtable into Zveltio collections, through the data API as the importing user",
  "version": "3.0.0",
  "zveltioMinVersion": "3.0.0-beta.121",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-migrators",
  "permissions": [
    "data:write",
    "data:system"
  ],
  "i18nPrefixes": [
    "integrations.migrators"
  ],
  "studio": {
    "navGroup": "developer",
    "pages": [
      {
        "path": "/admin/integrations/migrators",
        "label": "Data Migrators",
        "icon": "Import",
        "schema": "schemas/migrators.json"
      }
    ]
  },
  "contributes": {
    "engine": true,
    "studio": true
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "collections": [
    "migrator_connections",
    "migrator_fetches",
    "migrator_runs"
  ],
  "actions": [
    {
      "name": "discover",
      "permission": {
        "resource": "migrator_connections",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "connection_id"
        ],
        "additionalProperties": false,
        "properties": {
          "connection_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "migrator_connections"
      ],
      "enqueues": [
        "discover"
      ]
    },
    {
      "name": "fetch",
      "permission": {
        "resource": "migrator_fetches",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "connection_id",
          "object"
        ],
        "additionalProperties": false,
        "properties": {
          "connection_id": {
            "type": "string",
            "format": "uuid"
          },
          "object": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        }
      },
      "reads": [
        "migrator_connections"
      ],
      "writes": [
        "migrator_fetches"
      ],
      "enqueues": [
        "fetch"
      ]
    },
    {
      "name": "importFetch",
      "permission": {
        "resource": "migrator_runs",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "fetch_id",
          "target_collection"
        ],
        "additionalProperties": false,
        "properties": {
          "fetch_id": {
            "type": "string",
            "format": "uuid"
          },
          "target_collection": {
            "type": "string",
            "pattern": "^(zvd_)?[a-z_][a-z0-9_]*$",
            "maxLength": 63
          },
          "mapping": {
            "type": "object",
            "maxProperties": 500,
            "additionalProperties": {
              "type": "string",
              "maxLength": 63
            }
          }
        }
      },
      "reads": [
        "migrator_fetches",
        "migrator_runs"
      ],
      "writes": [
        "migrator_runs",
        "*"
      ]
    }
  ],
  "jobs": [
    {
      "name": "discover",
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "migrator_connections"
      ],
      "writes": [
        "migrator_connections"
      ],
      "egress": [
        "api.hubapi.com",
        "api.notion.com",
        "api.airtable.com"
      ],
      "retry": {
        "limit": 2,
        "backoff": true
      },
      "timeoutSeconds": 120
    },
    {
      "name": "fetch",
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "migrator_connections",
        "migrator_fetches"
      ],
      "writes": [
        "migrator_fetches"
      ],
      "egress": [
        "api.hubapi.com",
        "api.notion.com",
        "api.airtable.com"
      ],
      "retry": {
        "limit": 2,
        "backoff": true
      },
      "timeoutSeconds": 300
    }
  ],
  "integrity": {
    "engineSha256": "ce1d41419f5ea324a3ad3a13b9c1c119d4acc683a0f3068517e8e182c41e9a30",
    "sourceSha256": "b6b8b5f216ff670e9d256de28a6e1b3722e7cc3c4ff2101dce13e3a9f2efecdd",
    "schemaSha256": "39d7d5a7147c9978ae1cb396f15244587b211a96d646cf80c773b8e8ca0de0b0",
    "jobsSha256": "7fa330571e26ec7746437b3b4da5a17003232d186a32c31aaf9c0f8515510201"
  }
}
