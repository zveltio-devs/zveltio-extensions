{
  "spec": "zveltio.view/2",
  "title": "integrations.migrators.title",
  "type": "tabs",
  "items": [
    {
      "type": "list",
      "collection": "migrator_connections",
      "title": "integrations.migrators.tab.connections",
      "fields": [
        { "field": "name", "label": "common.col.name" },
        {
          "field": "source",
          "label": "integrations.migrators.col.source",
          "display": "badge",
          "tones": { "hubspot": "warning", "notion": "neutral", "airtable": "info" }
        },
        { "field": "objects_error", "label": "integrations.migrators.col.objectsError" },
        { "field": "objects_at", "label": "integrations.migrators.col.objectsAt" },
        { "field": "created_at", "label": "common.col.created" }
      ],
      "sort": "-created_at",
      "create": true,
      "delete": true,
      "rowActions": [
        {
          "action": "discover",
          "label": "integrations.migrators.action.discover",
          "input": { "connection_id": { "$record": "id" } }
        },
        {
          "action": "fetch",
          "label": "integrations.migrators.action.fetch",
          "input": { "connection_id": { "$record": "id" } },
          "prompt": ["object", "limit"]
        }
      ]
    },
    {
      "type": "list",
      "collection": "migrator_fetches",
      "title": "integrations.migrators.tab.fetches",
      "fields": [
        { "field": "source", "label": "integrations.migrators.col.source", "display": "mono" },
        { "field": "object", "label": "integrations.migrators.col.object", "display": "mono" },
        {
          "field": "status",
          "label": "common.col.status",
          "display": "badge",
          "tones": { "pending": "muted", "fetching": "info", "ready": "success", "failed": "danger" }
        },
        { "field": "total_rows", "label": "integrations.migrators.col.rows" },
        { "field": "error", "label": "integrations.migrators.col.error" },
        { "field": "created_at", "label": "common.col.created" }
      ],
      "sort": "-created_at",
      "rowActions": [
        {
          "action": "importFetch",
          "label": "integrations.migrators.action.import",
          "input": { "fetch_id": { "$record": "id" } },
          "prompt": ["target_collection"],
          "when": [{ "field": "status", "op": "eq", "value": "ready" }]
        }
      ]
    },
    {
      "type": "list",
      "collection": "migrator_runs",
      "title": "integrations.migrators.tab.runs",
      "fields": [
        { "field": "source", "label": "integrations.migrators.col.source", "display": "mono" },
        { "field": "source_object", "label": "integrations.migrators.col.object", "display": "mono" },
        { "field": "target_collection", "label": "common.col.collection", "display": "mono" },
        { "field": "imported_rows", "label": "integrations.migrators.col.rows" },
        { "field": "created_at", "label": "common.col.created" }
      ],
      "sort": "-created_at"
    }
  ]
}
