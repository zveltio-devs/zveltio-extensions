{
  "name": "content/documents",
  "displayName": "Document Generator",
  "category": "content",
  "description": "Generate PDF documents from templates with data binding",
  "version": "1.0.8",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-documents",
  "permissions": [
    "database",
    "documents"
  ],
  "dependencies": [
    {
      "name": "content/document-templates",
      "minVersion": "1.0.0"
    }
  ],
  "i18nPrefixes": [
    "content.documents"
  ],
  "publicRoutes": [
    "/sign/*",
    "/share/*"
  ],
  "studio": {
    "pages": [
      {
        "path": "/admin/content/documents",
        "label": "Documents",
        "icon": "FileText",
        "schema": "schemas/documents.json"
      }
    ],
    "navGroup": "content"
  },
  "contributes": {
    "engine": true,
    "studio": true
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "integrity": {
    "engineSha256": "c419b3f53aa4561173c9b3ddf438bc5a18646806cafc5d1f20aa09bdb73790a4",
    "sourceSha256": "ed1804d9ed6dfeec11da7e58275c06c3c246f78e5137ba5315193dd7aff5e2ba"
  }
}
