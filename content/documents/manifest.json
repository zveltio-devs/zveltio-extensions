{
  "name": "content/documents",
  "displayName": "Document Generator",
  "category": "content",
  "description": "Generate PDF documents from templates with data binding",
  "version": "1.0.5",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-documents",
  "permissions": [
    "database",
    "documents"
  ],
  "dependencies": [
    {
      "name": "content/document-templates",
      "minVersion": "1.0.0"
    }
  ],
  "i18nPrefixes": [
    "content.documents"
  ],
  "publicRoutes": [
    "/sign/*",
    "/share/*"
  ],
  "studio": {
    "pages": [
      {
        "path": "/admin/content/documents",
        "label": "Documents",
        "icon": "FileText",
        "schema": "schemas/documents.json"
      }
    ],
    "navGroup": "content"
  },
  "contributes": {
    "engine": true,
    "studio": true
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "integrity": {
    "engineSha256": "e4dc6b10da9376a94986127ff583183b7f8e0dc9a2803a6acbc5da7b58d13a8c",
    "sourceSha256": "8cb5ddf247d4fb8fc01c7f346adbd28b69d973cff257100f07d8049f6e6010e7"
  }
}
