  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "integrity": {
    "engineSha256": "e0d076695fc54916c3306b72882f33dbedaeb5f73edd173108bb5cb25d866a4b",
