    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "integrity": {
    "engineSha256": "ad742d305dc01a6645cc5c7b8667377960cbd3822ea4b1e45317612b83ad6c36",
