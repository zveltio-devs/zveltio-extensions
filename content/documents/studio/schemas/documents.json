{
  "sduiSchema": 1,
  "title": "content.documents.title",
  "subtitle": "content.documents.subtitle",
  "newLabel": "content.documents.btn.generate",
  "resources": [
    {
      "id": "generated",
      "label": "content.documents.tab.generated",
      "icon": "FileText",
      "dataSource": "/api/data/generated_documents?sort=created_at&order=desc&limit=500",
      "dataPath": "records",
      "columns": [
        {
          "key": "document_number",
          "label": "common.col.number",
          "type": "mono"
        },
        {
          "key": "template_name",
          "label": "content.documents.tab.templates"
        },
        {
          "key": "status",
          "label": "common.col.status",
          "type": "badge",
          "badge": {
            "colors": {
              "active": "badge-success",
              "revoked": "badge-error"
            }
          }
        },
        {
          "key": "created_at",
          "label": "common.col.created",
          "type": "date"
        }
      ],
      "rowActions": [
        {
          "id": "sign",
          "icon": "PenLine",
          "label": "content.documents.btn.sign",
          "method": "POST",
          "endpoint": "/api/data/document_signatures",
          "visibleWhen": {
            "field": "status",
            "equals": "active"
          },
          "body": {
            "document_id": "{id}"
          },
          "confirm": "content.documents.confirmSign"
        },
        {
          "id": "revoke",
          "icon": "Ban",
          "variant": "text-error",
          "label": "content.documents.btn.revoke",
          "method": "PATCH",
          "endpoint": "/api/data/generated_documents/{id}",
          "visibleWhen": {
            "field": "status",
            "equals": "active"
          },
          "body": {
            "status": "revoked"
          },
          "confirm": "content.documents.confirmRevoke"
        }
      ]
    },
    {
      "id": "templates",
      "label": "content.documents.tab.templates",
      "icon": "Plus",
      "dataSource": "/api/data/document_templates?is_active[eq]=true&sort=name&limit=500",
      "dataPath": "records",
      "columns": [
        {
          "key": "name",
          "label": "common.col.name"
        },
        {
          "key": "description",
          "label": "common.col.description"
        }
      ],
      "rowActions": [
        {
          "id": "generate",
          "icon": "FileText",
          "label": "content.documents.btn.generate",
          "method": "POST",
          "endpoint": "/ext/content/documents/generate/{id}",
          "prompt": {
            "title": "content.documents.generateLabel",
            "submitLabel": "content.documents.btn.generate",
            "fields": [
              {
                "name": "variables_data",
                "label": "content.documents.col.variable",
                "type": "json",
                "mono": true,
                "rows": 6,
                "default": "{}"
              },
              {
                "name": "output_format",
                "label": "content.documents.form.outputFormat",
                "type": "select",
                "default": "pdf",
                "options": [
                  {
                    "value": "pdf",
                    "label": "content.documents.format.pdf"
                  },
                  {
                    "value": "html",
                    "label": "content.documents.format.html"
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  ]
}
