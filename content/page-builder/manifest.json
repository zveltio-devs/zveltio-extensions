{
  "name": "content/page-builder",
  "displayName": "Page Builder",
  "category": "content",
  "description": "Visual drag-and-drop page builder with block-based content editing",
  "version": "1.0.2",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-page-builder",
  "permissions": [
    "database"
  ],
  "publicRoutes": [
    "/cms",
    "/cms/*",
    "/blocks/metrics/track",
    "/blocks/*/ab-variants/*/track"
  ],
  "studio": {
    "pages": [
      {
        "path": "/admin/page-builder",
        "label": "Pages",
        "icon": "Layout"
      }
    ],
    "navGroup": "content"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "client": true,
    "clientComponents": [
      "HeroSection",
      "GridSection",
      "CTASection",
      "TextSection"
    ],
    "fieldTypes": []
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "integrity": {
    "engineSha256": "c60d6acba90d3f20501ed0bf986d10072d4d828b0c059ed3c6f91680c1577547",
    "sourceSha256": "55d6b63ade8b80ef5a92ecdf74bc31cae12497b23f99fb1eee950b238436b015"
  },
  "globalRoutes": [
    "/sitemap.xml",
    "/robots.txt"
  ]
}
