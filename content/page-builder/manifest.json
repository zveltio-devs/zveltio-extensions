{
  "name": "content/page-builder",
  "displayName": "Page Builder",
  "category": "content",
  "description": "Visual drag-and-drop page builder with block-based content editing",
  "version": "1.0.2",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-page-builder",
  "permissions": [
    "database"
  ],
  "publicRoutes": [
    "/cms",
    "/cms/*",
    "/blocks/metrics/track",
    "/blocks/*/ab-variants/*/track"
  ],
  "studio": {
    "pages": [
      {
        "path": "/admin/page-builder",
        "label": "Pages",
        "icon": "Layout"
      }
    ],
    "navGroup": "content"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "client": true,
    "clientComponents": [
      "HeroSection",
      "GridSection",
      "CTASection",
      "TextSection"
    ],
    "fieldTypes": []
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "integrity": {
    "engineSha256": "c270d2fc731a65295a8a4b689960e8c572e199f5206346bffc7493a82a261f5e",
    "sourceSha256": "a00eb7ea9be93513332e3d57a0843b58b275501f91d2c8cdbf4f1d7732b8e3c6"
  },
  "globalRoutes": [
    "/sitemap.xml",
    "/robots.txt"
  ]
}
