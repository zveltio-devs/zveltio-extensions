{
  "name": "content/page-builder",
  "displayName": "Page Builder",
  "category": "content",
  "description": "Visual drag-and-drop page builder with block-based content editing",
  "version": "1.0.2",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-page-builder",
  "permissions": [
    "database"
  ],
  "publicRoutes": [
    "/cms",
    "/cms/*",
    "/blocks/metrics/track",
    "/blocks/*/ab-variants/*/track"
  ],
  "studio": {
    "pages": [
      {
        "path": "/admin/page-builder",
        "label": "Pages",
        "icon": "Layout"
      }
    ],
    "navGroup": "content"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "client": true,
    "clientComponents": [
      "HeroSection",
      "GridSection",
      "CTASection",
      "TextSection"
    ],
    "fieldTypes": []
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "integrity": {
    "engineSha256": "eeefb2bfbba77b66595135ea557b206e09ca1d5f9b6d6ed11c8e984fbc99e391",
    "sourceSha256": "f0108780d29f9382b3542e6e9c3042b223e819ff8f649460ad77755a13db25e0"
  },
  "globalRoutes": [
    "/sitemap.xml",
    "/robots.txt"
  ]
}
