{
  "name": "content/drafts",
  "displayName": "Content Drafts",
  "category": "content",
  "description": "Draft, review and publish workflow for content collections, through the data API as the publishing user",
  "version": "2.0.0",
  "zveltioMinVersion": "3.0.0-beta.99",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-drafts",
  "permissions": [
    "data:write"
  ],
  "collections": [
    "content_drafts",
    "content_draft_decisions",
    "content_draft_comments",
    "content_draft_snapshots"
  ],
  "i18nPrefixes": [
    "content.drafts"
  ],
  "contributes": {
    "engine": true,
    "studio": true
  },
  "studio": {
    "navGroup": "content",
    "pages": [
      {
        "path": "/admin/content/drafts",
        "label": "Content Drafts",
        "icon": "FileEdit",
        "schema": "schemas/drafts.json"
      }
    ]
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "integrity": {
    "engineSha256": "dd2b2645592f1f1ca1f5381d8d51fe32f3ab5e642f02370401d7e8affac1a796",
    "sourceSha256": "00b2815abd9bc9d5f32f9a2c7f72714f71943d782fe8b6fb0a74b7e3d80f1c18",
    "schemaSha256": "423425777eeb0d0b3fb9df14ab0383a59a4c70d55b0990e7f688d59c764fc63b"
  },
  "actions": [
    {
      "name": "reviewDraft",
      "permission": {
        "resource": "content_draft_decisions",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id",
          "decision"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "rejected"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 5000
          }
        }
      },
      "reads": [
        "content_drafts"
      ],
      "writes": [
        "content_drafts",
        "content_draft_decisions"
      ]
    },
    {
      "name": "snapshotDraft",
      "permission": {
        "resource": "content_draft_snapshots",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "reads": [
        "content_drafts",
        "content_draft_snapshots"
      ],
      "writes": [
        "content_draft_snapshots"
      ]
    }
  ]
}
