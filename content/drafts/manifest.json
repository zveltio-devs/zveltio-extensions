{
  "name": "content/drafts",
  "displayName": "Content Drafts",
  "category": "content",
  "description": "Draft, review and publish workflow for content collections, through the data API as the publishing user",
  "version": "3.0.0",
  "zveltioMinVersion": "3.0.0-beta.121",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-drafts",
  "permissions": [
    "data:write"
  ],
  "collections": [
    "content_drafts",
    "content_draft_decisions",
    "content_draft_comments",
    "content_draft_snapshots"
  ],
  "i18nPrefixes": [
    "content.drafts"
  ],
  "contributes": {
    "engine": true,
    "studio": true
  },
  "studio": {
    "navGroup": "content",
    "pages": [
      {
        "path": "/admin/content/drafts",
        "label": "Content Drafts",
        "icon": "FileEdit",
        "schema": "schemas/drafts.json"
      }
    ]
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "integrity": {
    "engineSha256": "86841d50a1b588bed710b7f813c92fb4f4a706c5e88be32ef838ca5868c7dbfa",
    "sourceSha256": "c0b16b2b5d19d9bdc3b06366d6a473759af9ca7612f49d32888375385f55b4fd",
    "schemaSha256": "cadb5766667ccf1cab4d2332498195b6f8ebf348b6a203d707f3dbd804925879"
  },
  "actions": [
    {
      "name": "reviewDraft",
      "permission": {
        "resource": "content_draft_decisions",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id",
          "decision"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "rejected"
            ]
          },
          "note": {
            "type": "string",
            "maxLength": 5000
          }
        }
      },
      "reads": [
        "content_drafts"
      ],
      "writes": [
        "content_drafts",
        "content_draft_decisions"
      ]
    },
    {
      "name": "snapshotDraft",
      "permission": {
        "resource": "content_draft_snapshots",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "description": {
            "type": "string",
            "maxLength": 500
          }
        }
      },
      "reads": [
        "content_drafts",
        "content_draft_snapshots"
      ],
      "writes": [
        "content_drafts",
        "content_draft_snapshots"
      ]
    },
    {
      "name": "publishDraft",
      "permission": {
        "resource": "content_drafts",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "content_drafts"
      ],
      "writes": [
        "content_drafts",
        "*"
      ]
    },
    {
      "name": "bulkPublish",
      "permission": {
        "resource": "content_drafts",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "draft_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "draft_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 200,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "reads": [
        "content_drafts"
      ],
      "writes": [
        "content_drafts",
        "*"
      ]
    },
    {
      "name": "publishDue",
      "permission": {
        "resource": "content_drafts",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "additionalProperties": false,
        "properties": {}
      },
      "reads": [
        "content_drafts"
      ],
      "writes": [
        "content_drafts",
        "*"
      ]
    }
  ]
}
