{
  "spec": "zveltio.view/2",
  "type": "list",
  "title": "content.drafts.title",
  "collection": "content_drafts",
  "fields": [
    { "field": "target_collection", "label": "common.col.collection", "display": "badge" },
    { "field": "record_id", "label": "content.drafts.col.record", "display": "mono" },
    {
      "field": "review_status",
      "label": "content.drafts.col.review",
      "display": "badge",
      "tones": { "draft": "neutral", "approved": "success", "rejected": "danger" }
    },
    { "field": "scheduled_at", "label": "content.drafts.col.scheduled" },
    { "field": "created_by", "label": "content.drafts.col.author", "display": "mono" },
    { "field": "updated_at", "label": "content.drafts.col.updated" }
  ],
  "filter": [{ "field": "published_at", "op": "null" }],
  "sort": "-updated_at",
  "selectable": true,
  "delete": true,
  "actions": [
    { "action": "publishDue", "label": "content.drafts.btn.publishDue", "confirm": "content.drafts.confirmPublishDue" }
  ],
  "bulkActions": [
    {
      "action": "bulkPublish",
      "label": "content.drafts.btn.publishSelected",
      "input": { "draft_ids": { "$selection": "id" } },
      "confirm": "content.drafts.confirmPublish"
    }
  ],
  "rowActions": [
    {
      "action": "publishDraft",
      "label": "content.drafts.btn.publish",
      "tone": "success",
      "input": { "id": { "$record": "id" } },
      "confirm": "content.drafts.confirmPublish"
    },
    {
      "action": "reviewDraft",
      "label": "content.drafts.btn.approve",
      "input": { "id": { "$record": "id" }, "decision": "approved" },
      "prompt": ["note"]
    },
    {
      "action": "reviewDraft",
      "label": "content.drafts.btn.reject",
      "tone": "danger",
      "input": { "id": { "$record": "id" }, "decision": "rejected" },
      "prompt": ["note"]
    },
    {
      "action": "snapshotDraft",
      "label": "content.drafts.btn.snapshot",
      "input": { "id": { "$record": "id" } },
      "prompt": ["description"]
    }
  ]
}
