{
  "name": "content/pages",
  "displayName": "Pages",
  "category": "content",
  "description": "Pages built from blocks, grouped into sites. Authors edit drafts; publishing writes the sanitized snapshot a public website or a signed-in portal renders, read through the data API under the engine's rules.",
  "version": "2.2.0",
  "zveltioMinVersion": "3.0.0-beta.111",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-pages",
  "permissions": [],
  "routes": [
    {
      "method": "GET",
      "path": "/sitemap.xml",
      "access": "public",
      "handler": "sitemap"
    },
    {
      "method": "GET",
      "path": "/robots.txt",
      "access": "public",
      "handler": "robots"
    }
  ],
  "i18nPrefixes": [
    "content.pages"
  ],
  "studio": {
    "pages": [
      {
        "path": "/admin/pages",
        "label": "Pages",
        "icon": "Layout",
        "schema": "schemas/pages.json"
      },
      {
        "path": "/admin/pages/builder/:id",
        "label": "Page builder",
        "icon": "Layout"
      }
    ],
    "navGroup": "content"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "client": true,
    "clientComponents": [
      "HeroSection",
      "GridSection",
      "CTASection",
      "TextSection"
    ],
    "studioComponents": [
      "CalendarView",
      "CardView",
      "ListView"
    ],
    "fieldTypes": []
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "integrity": {
    "engineSha256": "ad3e4794cea7d44e143bba452156601e9579d81792d50372533f0bb6a182cbe8",
    "sourceSha256": "fa308f20124a481ec5105db48a8dfc1257b434c1073e8f6ed976672bef671ea0",
    "schemaSha256": "962d955615bf4644d9d733fff32661eca9b832975fda3656f8cbf4e1583775cb"
  },
  "collections": [
    "page_sites",
    "pages",
    "page_publications",
    "page_revisions",
    "page_menus"
  ],
  "actions": [
    {
      "name": "publish",
      "permission": {
        "resource": "page_publications",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "pages",
        "page_publications"
      ],
      "writes": [
        "page_publications",
        "page_revisions"
      ]
    },
    {
      "name": "restoreRevision",
      "permission": {
        "resource": "pages",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "page_revisions",
        "pages"
      ],
      "writes": [
        "pages"
      ]
    }
  ]
}
