{
  "name": "content/pages",
  "displayName": "Pages",
  "category": "content",
  "description": "Pages built from blocks — content or live collection data — grouped into sites. A site is a public website with SEO and a sitemap, or an authenticated portal with its own branding, base path and access roles.",
  "version": "1.0.5",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-pages",
  "permissions": [
    "database"
  ],
  "i18nPrefixes": [
    "content.pages"
  ],
  "resources": [
    "sites",
    "pages"
  ],
  "publicRoutes": [
    "/cms",
    "/cms/*",
    "/pages/metrics/track",
    "/pages/*/ab-variants/*/track"
  ],
  "studio": {
    "pages": [
      {
        "path": "/admin/pages",
        "label": "Pages",
        "icon": "Layout",
        "schema": "schemas/pages.json"
      },
      {
        "path": "/admin/pages/builder/:id",
        "label": "Page builder",
        "icon": "Layout"
      }
    ],
    "navGroup": "content"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "client": true,
    "clientComponents": [
      "HeroSection",
      "GridSection",
      "CTASection",
      "TextSection"
    ],
    "studioComponents": [
      "CalendarView",
      "CardView",
      "ListView"
    ],
    "fieldTypes": []
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "globalRoutes": [
    "/sitemap.xml",
    "/robots.txt"
  ],
  "integrity": {
    "engineSha256": "6035e3b0f7b5d2f5ac9b2fdb41154db89d98ad09ba6ef188d534db14ebb7e152",
    "sourceSha256": "9caba242c333c0a7ff79963004ae921f9db9e7b7195568abe8e8c35fa426b1ec"
  }
}
