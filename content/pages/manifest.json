{
  "name": "content/pages",
  "displayName": "Pages",
  "category": "content",
  "description": "Pages built from blocks — content or live collection data — grouped into sites. A site is a public website with SEO and a sitemap, or an authenticated portal with its own branding, base path and access roles.",
  "version": "1.0.1",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-pages",
  "permissions": [
    "database"
  ],
  "resources": [
    "sites",
    "pages"
  ],
  "publicRoutes": [
    "/cms",
    "/cms/*",
    "/pages/metrics/track",
    "/pages/*/ab-variants/*/track"
  ],
  "studio": {
    "pages": [
      {
        "path": "/admin/pages",
        "label": "Pages",
        "icon": "Layout"
      }
    ],
    "navGroup": "content"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "client": true,
    "clientComponents": [
      "HeroSection",
      "GridSection",
      "CTASection",
      "TextSection"
    ],
    "studioComponents": [
      "CalendarView",
      "CardView",
      "ListView"
    ],
    "fieldTypes": []
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "globalRoutes": [
    "/sitemap.xml",
    "/robots.txt"
  ],
  "integrity": {
    "engineSha256": "a7ae10ba7cf44945b778bb7751ac70e53ad97c832c70470c52ddcedcb85bab08",
    "sourceSha256": "a78f11c722bcafc3c4f5414ab3cc3584e6b042ad4ad5decf9e74e61c14a94dae"
  }
}
