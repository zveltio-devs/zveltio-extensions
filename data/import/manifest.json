{
  "name": "data/import",
  "displayName": "Data Import",
  "category": "data",
  "description": "Import collection data as rows, CSV, JSON or NDJSON text through the data API, as the importing user",
  "version": "3.0.0",
  "zveltioMinVersion": "3.0.0-beta.121",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-import",
  "permissions": [
    "data:write"
  ],
  "collections": [
    "data_import_jobs",
    "data_import_profiles"
  ],
  "i18nPrefixes": [
    "data.import"
  ],
  "studio": {
    "pages": [
      {
        "path": "/admin/data/import",
        "label": "Import",
        "icon": "Upload",
        "schema": "schemas/import.json"
      }
    ],
    "navGroup": "developer"
  },
  "contributes": {
    "engine": true,
    "studio": true
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "integrity": {
    "engineSha256": "b66b279ab55b70a0af14d767b182cfc379d2e375f287369ad2ac92ade3639d25",
    "sourceSha256": "c9a96d23a56a40314cf275106d97f7b3f3ceacff746dfffee164f336276ea6c9",
    "schemaSha256": "0060c4c59b859f1e6599f9ab40060e0f682f642c50b9c8e736e6924792327fb8"
  },
  "actions": [
    {
      "name": "importRows",
      "permission": {
        "resource": "data_import_jobs",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "collection"
        ],
        "additionalProperties": false,
        "properties": {
          "collection": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "rows": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10000,
            "items": {}
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 104857600
          },
          "format": {
            "type": "string",
            "enum": [
              "csv",
              "json",
              "ndjson"
            ]
          },
          "delimiter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1
          },
          "filename": {
            "type": "string",
            "maxLength": 255
          },
          "mapping": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "profile_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "data_import_profiles"
      ],
      "writes": [
        "data_import_jobs",
        "*"
      ]
    },
    {
      "name": "rollbackImport",
      "permission": {
        "resource": "data_import_jobs",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "data_import_jobs"
      ],
      "writes": [
        "data_import_jobs",
        "*"
      ]
    }
  ]
}
