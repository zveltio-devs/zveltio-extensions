{
  "spec": "zveltio.view/2",
  "type": "list",
  "title": "data.import.title",
  "collection": "data_import_jobs",
  "fields": [
    { "field": "created_at", "label": "data.import.col.time" },
    { "field": "target_collection", "label": "common.col.collection", "display": "badge" },
    { "field": "format", "label": "data.import.col.format", "display": "badge" },
    { "field": "imported_rows", "label": "data.import.col.rows" },
    { "field": "filename", "label": "common.col.file" },
    { "field": "rolled_back_at", "label": "data.import.col.rolledBack" }
  ],
  "sort": "-created_at",
  "actions": [
    {
      "action": "importRows",
      "label": "data.import.action.import",
      "input": { "format": "json" },
      "prompt": ["collection", "text"]
    }
  ],
  "rowActions": [
    {
      "action": "rollbackImport",
      "label": "data.import.action.rollback",
      "tone": "danger",
      "input": { "id": { "$record": "id" } },
      "when": [{ "field": "rolled_back_at", "op": "null" }],
      "confirm": "data.import.confirm.rollback"
    }
  ]
}
