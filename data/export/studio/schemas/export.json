{
  "sduiSchema": 1,
  "title": "data.export.title",
  "subtitle": "data.export.subtitle",
  "newLabel": "data.export.ui.export_collection",
  "resources": [
    {
      "id": "templates",
      "dataSource": "/api/data/data_export_templates?sort=name&order=asc&limit=500",
      "dataPath": "records",
      "columns": [
        {
          "key": "name",
          "label": "data.export.col.name"
        },
        {
          "key": "target_collection",
          "label": "common.col.collection"
        },
        {
          "key": "format",
          "label": "data.export.col.format",
          "type": "badge",
          "badge": {
            "colors": {}
          }
        },
        {
          "key": "row_limit",
          "label": "data.export.col.rows"
        },
        {
          "key": "fields",
          "label": "data.export.col.fields",
          "type": "mono"
        }
      ],
      "form": {
        "endpoint": "/ext/data/export/{collection}",
        "submit": {
          "kind": "download"
        },
        "fields": [
          {
            "name": "collection",
            "label": "data.export.col.collection",
            "type": "relation",
            "required": true,
            "colSpan": 2,
            "relation": {
              "dataSource": "/api/collections",
              "dataPath": "collections",
              "valueKey": "name",
              "labelKey": "name"
            }
          },
          {
            "name": "format",
            "label": "data.export.col.format",
            "type": "select",
            "default": "csv",
            "colSpan": 1,
            "options": [
              {
                "value": "csv",
                "label": "CSV"
              },
              {
                "value": "json",
                "label": "JSON"
              },
              {
                "value": "ndjson",
                "label": "NDJSON"
              }
            ]
          },
          {
            "name": "limit",
            "label": "data.export.rowLimit",
            "type": "number",
            "colSpan": 1,
            "default": 1000
          },
          {
            "name": "filter",
            "label": "data.export.filterHint",
            "mono": true,
            "colSpan": 2,
            "placeholder": "{\"status\":{\"eq\":\"active\"}}"
          }
        ]
      },
      "rowActions": [
        {
          "id": "download",
          "label": "data.export.btn.download",
          "icon": "Download",
          "kind": "open",
          "endpoint": "/ext/data/export/{target_collection}?format={format}&limit={row_limit}&fields={fields}"
        }
      ]
    }
  ]
}
