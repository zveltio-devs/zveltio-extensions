{
  "name": "search",
  "displayName": "Search Adapter",
  "category": "search",
  "description": "Full-text search via MeiliSearch or Typesense with automatic record sync",
  "version": "1.0.2",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-search",
  "permissions": [
    "database"
  ],
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/search",
        "component": "./studio/src/pages/SearchPage.svelte",
        "label": "Search",
        "icon": "search"
      }
    ],
    "navGroup": "developer"
  },
  "contributes": {
    "engine": true,
    "studio": false,
    "fieldTypes": []
  },
  "integrity": {
    "engineSha256": "5d21d7a5410349d255ec71e35f8f4dc0c657031c95b10f5f94e6d0534dfaf5c0",
    "sourceSha256": "edfe681e4e28b886cc91037e1679ea6c412ffbf0055d0f75ae56b54cbeefffda"
  }
}
