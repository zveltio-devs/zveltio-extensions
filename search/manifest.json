    ],
    "navGroup": "developer"
  },
  "contributes": {
    "engine": true,
    "studio": false,
    "fieldTypes": []
  },
  "integrity": {
    "engineSha256": "a034a7d78366183d22bf777ad3b1bb88ece8a9ab11cad954c4a70c08d4eaadce",
