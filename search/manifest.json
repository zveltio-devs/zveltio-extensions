  },
  "contributes": {
    "engine": true,
    "studio": false,
    "fieldTypes": []
  },
  "integrity": {
    "engineSha256": "53775dbb5374c53c2175b53b4173586fd99b61150ce610cba61c2b6d8adbf5cf",
