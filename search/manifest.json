{
  "name": "search",
  "displayName": "Search Adapter",
  "category": "search",
  "description": "Full-text search via MeiliSearch or Typesense with automatic record sync",
  "version": "1.0.0",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-search",
  "permissions": [
    "database"
  ],
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/search",
        "component": "./studio/src/pages/SearchPage.svelte",
        "label": "Search",
        "icon": "search"
      }
    ],
    "navGroup": "developer"
  },
  "contributes": {
    "engine": true,
    "studio": false,
    "fieldTypes": []
  },
  "integrity": {
    "engineSha256": "5bb63b53c69f2d6f3f84a32226a03f349fb0f82cbc9ec449986a4ce97b1edf7a",
    "sourceSha256": "42a644f7153ef510bdd999cd99dfd25c0847349de764ce0c4e33978c4083d8db"
  }
}
