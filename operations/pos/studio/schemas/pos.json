          "badge": {
            "colors": {}
          }
        }
      ],
      "form": {
        "endpoint": "/ext/operations/pos/actions/openSession",
        "fields": [
          {
            "name": "opening_float",
            "label": "operations.pos.ui.opening_float",
            "type": "number",
            "required": true,
            "colSpan": 2,
            "default": 0
          },
          {
            "name": "notes",
            "label": "common.col.notes",
            "type": "textarea",
