{
  "spec": "zveltio.view/2",
  "title": "operations.pos.title",
  "type": "split",
  "panes": [
    {
      "type": "list",
      "id": "master",
      "collection": "pos_sessions",
      "fields": [
        "status",
        "created_at"
      ],
      "sort": "-created_at",
      "rowActions": [
        {
          "action": "closeSession",
          "label": "operations.pos.closeSession",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "prompt": [
            "closing_float"
          ],
          "when": [
            {
              "field": "status",
              "op": "eq",
              "value": "open"
            }
          ]
        }
      ]
    },
    {
      "type": "list",
      "collection": "pos_orders",
      "fields": [
        {
          "field": "number",
          "label": "common.col.number",
          "display": "mono"
        },
        {
          "field": "created_at",
          "label": "operations.pos.col.time"
        },
        {
          "field": "total",
          "label": "common.col.total"
        },
        {
          "field": "status",
          "label": "common.col.status",
          "display": "badge"
        }
      ],
      "filter": [
        {
          "field": "session_id",
          "op": "eq",
          "value": {
            "$selected": "master"
          }
        }
      ],
      "sort": "-created_at",
      "actions": [
        {
          "action": "openSession",
          "tone": "info",
          "label": "operations.pos.openSession",
          "prompt": [
            "opening_float",
            "notes"
          ]
        }
      ]
    }
  ]
}
