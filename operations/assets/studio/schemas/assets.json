{
  "spec": "zveltio.view/2",
  "title": "operations.assets.title",
  "type": "list",
  "collection": "assets",
  "fields": [
    {
      "field": "name",
      "label": "common.col.name"
    },
    {
      "field": "code",
      "label": "common.col.code",
      "display": "mono"
    },
    {
      "field": "category",
      "label": "common.col.category"
    },
    {
      "field": "location",
      "label": "operations.assets.col.location"
    },
    {
      "field": "purchase_cost",
      "label": "operations.assets.col.cost"
    },
    {
      "field": "status",
      "label": "common.col.status",
      "display": "badge",
      "tones": {
        "active": "success",
        "disposed": "danger"
      }
    }
  ],
  "sort": "-created_at",
  "rowActions": [
    {
      "action": "transferAsset",
      "label": "operations.assets.action.transfer",
      "input": {
        "id": {
          "$record": "id"
        }
      },
      "prompt": [
        "to_location",
        "transfer_date",
        "reason"
      ],
      "when": [
        {
          "field": "status",
          "op": "eq",
          "value": "active"
        }
      ]
    },
    {
      "action": "revalueAsset",
      "label": "operations.assets.action.revalue",
      "input": {
        "id": {
          "$record": "id"
        }
      },
      "prompt": [
        "new_value",
        "revaluation_date",
        "notes"
      ],
      "when": [
        {
          "field": "status",
          "op": "eq",
          "value": "active"
        }
      ]
    },
    {
      "action": "disposeAsset",
      "label": "operations.assets.action.dispose",
      "input": {
        "id": {
          "$record": "id"
        }
      },
      "prompt": [
        "disposal_date",
        "disposal_value",
        "reason"
      ],
      "when": [
        {
          "field": "status",
          "op": "eq",
          "value": "active"
        }
      ]
    }
  ],
  "actions": [
    {
      "action": "createAsset",
      "tone": "info",
      "label": "operations.assets.btn.new",
      "prompt": [
        "name",
        "code",
        "serial_number",
        "category",
        "location",
        "purchase_date",
        "purchase_cost",
        "useful_life_years",
        "residual_value",
        "depreciation_account_id",
        "accumulated_dep_account_id",
        "asset_account_id",
        "disposal_loss_account_id"
      ]
    }
  ]
}
