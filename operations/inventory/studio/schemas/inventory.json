{
  "spec": "zveltio.view/2",
  "title": "inventory.title",
  "type": "tabs",
  "items": [
    {
      "type": "list",
      "collection": "products",
      "title": "inventory.tab.products",
      "fields": [
        {
          "field": "sku",
          "label": "inventory.col.sku",
          "display": "mono"
        },
        {
          "field": "name",
          "label": "inventory.col.name"
        },
        {
          "field": "sale_price",
          "label": "common.col.price"
        },
        {
          "field": "avg_cost",
          "label": "inventory.col.avgCost"
        },
        {
          "field": "tax_rate",
          "label": "inventory.col.vat"
        },
        {
          "field": "is_active",
          "label": "inventory.col.active"
        }
      ],
      "sort": "name",
      "search": true,
      "create": true
    },
    {
      "type": "list",
      "collection": "warehouses",
      "title": "inventory.tab.warehouses",
      "fields": [
        {
          "field": "name",
          "label": "inventory.col.name"
        },
        {
          "field": "location",
          "label": "inventory.col.location"
        },
        {
          "field": "is_active",
          "label": "inventory.col.active"
        }
      ],
      "sort": "name",
      "create": true
    },
    {
      "type": "list",
      "collection": "suppliers",
      "title": "inventory.tab.suppliers",
      "fields": [
        {
          "field": "name",
          "label": "inventory.col.name"
        },
        {
          "field": "email",
          "label": "common.col.email"
        },
        {
          "field": "phone",
          "label": "common.col.phone"
        },
        {
          "field": "tax_id",
          "label": "inventory.col.taxId",
          "display": "mono"
        }
      ],
      "sort": "name",
      "create": true
    },
    {
      "type": "list",
      "collection": "stock_levels",
      "title": "inventory.tab.stock",
      "fields": [
        {
          "field": "product_id",
          "label": "inventory.col.product"
        },
        {
          "field": "warehouse_id",
          "label": "inventory.col.warehouse"
        },
        {
          "field": "quantity",
          "label": "inventory.col.quantity",
          "display": "mono"
        },
        {
          "field": "reserved_qty",
          "label": "inventory.col.reserved",
          "display": "mono"
        }
      ]
    },
    {
      "type": "list",
      "collection": "stock_movements",
      "title": "inventory.tab.movements",
      "fields": [
        {
          "field": "created_at",
          "label": "common.col.date"
        },
        {
          "field": "product_id",
          "label": "inventory.col.product"
        },
        {
          "field": "warehouse_id",
          "label": "inventory.col.warehouse"
        },
        {
          "field": "type",
          "label": "common.col.type",
          "display": "badge",
          "tones": {
            "in": "success",
            "out": "warning",
            "transfer": "info",
            "adjustment": "muted"
          }
        },
        {
          "field": "quantity",
          "label": "inventory.col.quantity",
          "display": "mono"
        },
        {
          "field": "reference",
          "label": "common.col.docNumber",
          "display": "mono"
        }
      ],
      "sort": "-created_at",
      "actions": [
        {
          "action": "moveStock",
          "tone": "info",
          "label": "common.new",
          "prompt": [
            "product_id",
            "warehouse_id",
            "type",
            "quantity",
            "destination_warehouse_id",
            "unit_cost",
            "reference",
            "note"
          ]
        }
      ]
    },
    {
      "type": "list",
      "collection": "purchase_orders",
      "title": "inventory.tab.purchaseOrders",
      "fields": [
        {
          "field": "number",
          "label": "common.col.number",
          "display": "mono"
        },
        {
          "field": "supplier_id",
          "label": "inventory.col.supplier"
        },
        {
          "field": "status",
          "label": "common.col.status",
          "display": "badge",
          "tones": {
            "draft": "muted",
            "sent": "info",
            "partial": "warning",
            "received": "success",
            "cancelled": "danger"
          }
        },
        {
          "field": "expected_date",
          "label": "inventory.col.expected"
        },
        {
          "field": "total",
          "label": "common.col.total"
        }
      ],
      "sort": "-created_at"
    }
  ]
}
