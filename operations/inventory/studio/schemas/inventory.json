        {
          "key": "status",
          "label": "common.col.status",
          "type": "badge",
          "badge": {
            "colors": {
              "draft": "badge-ghost",
              "sent": "badge-info",
              "partial": "badge-warning",
              "received": "badge-success",
              "cancelled": "badge-error"
            }
