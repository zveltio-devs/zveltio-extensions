            "label": "common.col.type",
            "type": "select",
            "required": true,
            "default": "in",
            "colSpan": 1,
            "options": [
              {
                "value": "in",
                "label": "inventory.type.in"
              },
              {
                "value": "out",
                "label": "inventory.type.out"
              },
              {
                "value": "transfer",
                "label": "inventory.type.transfer"
              },
              {
                "value": "adjustment",
                "label": "inventory.type.adjustment"
