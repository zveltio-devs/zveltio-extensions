{
  "name": "operations/inventory",
  "displayName": "Inventory",
  "category": "operations",
  "description": "Warehouses, SKUs, stock movements, reorder alerts and barcode support",
  "version": "2.1.2",
  "zveltioMinVersion": "3.0.0-beta.93",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-inventory",
  "permissions": [
    "data:write"
  ],
  "i18nPrefixes": [
    "inventory",
    "operations.inventory"
  ],
  "contributes": {
    "engine": true,
    "studio": true,
    "fieldTypes": []
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/inventory",
        "label": "Inventory",
        "icon": "Boxes",
        "schema": "schemas/inventory.json"
      }
    ],
    "navGroup": "operations"
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "collections": [
    "warehouses",
    "suppliers",
    "products",
    "product_variants",
    "stock_levels",
    "purchase_orders",
    "purchase_order_series",
    "purchase_order_lines",
    "product_batches",
    "stock_movements"
  ],
  "actions": [
    {
      "name": "moveStock",
      "permission": {
        "resource": "stock_movements",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "product_id",
          "warehouse_id",
          "type",
          "quantity"
        ],
        "additionalProperties": false,
        "properties": {
          "product_id": {
            "type": "string",
            "format": "uuid"
          },
          "warehouse_id": {
            "type": "string",
            "format": "uuid"
          },
          "type": {
            "type": "string",
            "enum": [
              "in",
              "out",
              "transfer",
              "adjustment"
            ]
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "destination_warehouse_id": {
            "type": "string",
            "format": "uuid"
          },
          "unit_cost": {
            "type": "number",
            "minimum": 0
          },
          "reference": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        }
      },
      "reads": [
        "stock_levels",
        "products"
      ],
      "writes": [
        "stock_levels",
        "products",
        "stock_movements"
      ]
    },
    {
      "name": "createPurchaseOrder",
      "permission": {
        "resource": "purchase_orders",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "supplier_id",
          "lines"
        ],
        "additionalProperties": false,
        "properties": {
          "supplier_id": {
            "type": "string",
            "format": "uuid"
          },
          "warehouse_id": {
            "type": "string",
            "format": "uuid"
          },
          "expected_date": {
            "type": "string",
            "format": "date"
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "notes": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "product_id",
                "quantity_ordered",
                "unit_cost"
              ],
              "additionalProperties": false,
              "properties": {
                "product_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "quantity_ordered": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit_cost": {
                  "type": "number",
                  "minimum": 0
                },
                "tax_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              }
            }
          }
        }
      },
      "reads": [
        "purchase_orders",
        "purchase_order_series"
      ],
      "writes": [
        "purchase_orders",
        "purchase_order_lines",
        "purchase_order_series"
      ]
    },
    {
      "name": "sendPurchaseOrder",
      "permission": {
        "resource": "purchase_orders",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "purchase_orders"
      ],
      "writes": [
        "purchase_orders"
      ]
    },
    {
      "name": "cancelPurchaseOrder",
      "permission": {
        "resource": "purchase_orders",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "purchase_orders"
      ],
      "writes": [
        "purchase_orders"
      ]
    },
    {
      "name": "receivePurchaseOrder",
      "permission": {
        "resource": "purchase_orders",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id",
          "lines"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "received_date": {
            "type": "string",
            "format": "date"
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "line_id",
                "quantity_received"
              ],
              "additionalProperties": false,
              "properties": {
                "line_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "quantity_received": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "batch_number": {
                  "type": "string",
                  "minLength": 1
                },
                "expiry_date": {
                  "type": "string",
                  "format": "date"
                }
              }
            }
          }
        }
      },
      "reads": [
        "purchase_orders",
        "purchase_order_lines",
        "product_batches",
        "stock_levels",
        "products"
      ],
      "writes": [
        "purchase_orders",
        "purchase_order_lines",
        "product_batches",
        "stock_levels",
        "products",
        "stock_movements"
      ]
    },
    {
      "name": "lowStock",
      "permission": {
        "resource": "products",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [],
        "additionalProperties": false,
        "properties": {}
      },
      "reads": [
        "products",
        "stock_levels"
      ],
      "writes": []
    },
    {
      "name": "valuation",
      "permission": {
        "resource": "products",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [],
        "additionalProperties": false,
        "properties": {}
      },
      "reads": [
        "products",
        "stock_levels"
      ],
      "writes": []
    },
    {
      "name": "expiringBatches",
      "permission": {
        "resource": "product_batches",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [],
        "additionalProperties": false,
        "properties": {
          "days": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3650
          }
        }
      },
      "reads": [
        "product_batches"
      ],
      "writes": []
    }
  ],
  "integrity": {
    "engineSha256": "e06f1f9c43e32418180ec4c43c5df9a1e53dba3a8479474612b4e0b6532e1221",
    "sourceSha256": "953035d52c438f9f11e7ffac891fd4cac292fb4ad5449eee5db5f02fe5db58c8",
    "schemaSha256": "23467294df1f3c37441033faeda5f4d1c0858f3e0b81375b148116fbea24fb10"
  }
}
