          "customer_id": {
            "type": "string",
            "format": "uuid"
          },
          "invoice_number": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "reads": [
        "trace_lots"
      ],
      "writes": [
        "trace_dispatches",
        "trace_lots",
        "trace_movements"
      ]
    },
    {
      "name": "importInvoice",
      "permission": {
        "resource": "trace_dispatches",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "invoice_id"
        ],
        "additionalProperties": false,
        "properties": {
          "invoice_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
