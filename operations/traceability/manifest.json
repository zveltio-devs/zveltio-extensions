      "name": "scanLot",
      "permission": {
        "resource": "trace_lots",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "lot_id"
        ],
        "additionalProperties": false,
        "properties": {
          "lot_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "trace_lots",
        "trace_items",
        "trace_suppliers",
        "trace_locations"
      ],
      "writes": []
    },
    {
      "name": "parseGs1",
      "permission": {
        "resource": "trace_lots",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "raw"
        ],
        "additionalProperties": false,
        "properties": {
          "raw": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      },
      "reads": [],
      "writes": []
    },
    {
      "name": "report",
      "permission": {
        "resource": "trace_lots",
        "action": "execute"
      },
      "input": {
        "type": "object",
