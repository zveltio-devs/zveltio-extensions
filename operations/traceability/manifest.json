        ],
        "additionalProperties": false,
        "properties": {
          "lot_id": {
            "type": "string",
            "format": "uuid"
          },
          "quantity_dispatched": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "customer_name": {
            "type": "string",
