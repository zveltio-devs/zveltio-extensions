    {
      "id": "lots",
      "label": "operations.traceability.tab.lots",
      "icon": "Package",
      "dataSource": "/api/data/trace_lots?expand=item_id,supplier_id&sort=created_at&order=desc",
      "dataPath": "records",
      "columns": [
        {
          "key": "lot_number",
          "label": "operations.traceability.col.lot",
          "type": "mono"
        },
        {
          "key": "item_id_expanded.name",
          "label": "operations.traceability.form.product"
        },
        {
          "key": "lot_type",
          "label": "common.col.type",
          "type": "badge"
        },
        {
          "key": "status",
          "label": "common.col.status",
          "type": "badge",
          "badge": {
            "colors": {
              "quarantine": "badge-warning",
              "available": "badge-success",
              "exhausted": "badge-ghost",
              "recalled": "badge-error"
            }
          }
        },
        {
          "key": "quantity_remaining",
          "label": "operations.traceability.col.qty"
        },
        {
          "key": "unit",
          "label": "operations.traceability.form.unit"
        },
        {
          "key": "best_before_date",
          "label": "operations.traceability.col.bbd",
          "type": "date",
          "classWhen": [
            {
              "field": "best_before_date",
              "class": "text-error font-semibold"
            }
          ]
        },
        {
          "key": "supplier_id_expanded.name",
          "label": "operations.traceability.form.supplier"
        }
      ],
      "rowActions": [
        {
          "id": "open",
          "kind": "navigate",
          "href": "/traceability/lots/{id}",
          "icon": "Package",
          "label": "operations.traceability.action.details"
        },
        {
          "id": "label",
          "kind": "open",
          "icon": "Download",
          "label": "operations.traceability.ui.printeaz_etichet",
          "endpoint": "/ext/operations/traceability/app/tools.html?label={id}"
        },
        {
          "id": "release",
          "icon": "CheckCircle",
          "label": "operations.traceability.action.release",
          "method": "POST",
          "endpoint": "/ext/operations/traceability/actions/releaseLot",
          "visibleWhen": {
            "field": "status",
            "equals": "quarantine"
          },
          "confirm": "operations.traceability.confirmReleaseLot",
          "body": {
            "id": "{id}"
          }
        },
        {
          "id": "status",
          "label": "operations.traceability.action.setStatus",
          "method": "POST",
          "endpoint": "/ext/operations/traceability/actions/setLotStatus",
          "body": {
            "id": "{id}"
          },
          "prompt": {
            "fields": [
              {
                "name": "status",
                "label": "common.col.status",
                "type": "select",
                "required": true,
                "options": [
                  {
                    "value": "quarantine",
                    "label": "operations.traceability.status.quarantine"
                  },
                  {
                    "value": "available",
                    "label": "operations.traceability.status.available"
                  },
                  {
                    "value": "exhausted",
                    "label": "operations.traceability.status.exhausted"
                  },
                  {
                    "value": "recalled",
                    "label": "operations.traceability.status.recalled"
                  },
                  {
                    "value": "returned",
                    "label": "operations.traceability.status.returned"
                  }
                ]
              },
              {
                "name": "notes",
                "label": "common.col.notes",
                "type": "textarea"
              }
            ]
          }
        }
      ],
      "form": {
        "endpoint": "/ext/operations/traceability/actions/receiveLot",
        "fields": [
          {
            "name": "gs1_scan",
            "label": "operations.traceability.form.gs1Scan",
            "colSpan": 2,
            "placeholder": "operations.traceability.form.gs1Placeholder",
            "lookup": {
              "label": "operations.traceability.action.parseGs1",
              "endpoint": "/ext/operations/traceability/actions/parseGs1",
              "body": {
                "raw": "{gs1_scan}"
              },
              "map": {
                "supplier_lot_ref": "result.supplier_lot_ref",
                "best_before_date": "result.best_before_date",
                "gtin_scanned": "result.gtin"
              }
            }
          },
          {
            "name": "item_id",
            "label": "operations.traceability.form.product",
            "type": "relation",
            "required": true,
            "colSpan": 1,
            "relation": {
              "dataSource": "/api/data/trace_items?is_active[eq]=true&sort=name&order=asc&limit=500",
              "dataPath": "records",
              "valueKey": "id",
              "labelKey": [
                "code",
                "name"
              ]
            }
          },
          {
            "name": "lot_type",
            "label": "common.col.type",
            "type": "select",
            "default": "inbound",
            "colSpan": 1,
            "options": [
              {
                "value": "inbound"
              },
              {
                "value": "internal"
              },
              {
                "value": "outbound"
              }
            ]
          },
          {
            "name": "quantity_initial",
            "label": "operations.traceability.col.qty",
            "type": "number",
            "required": true,
            "colSpan": 1
          },
          {
            "name": "unit",
            "label": "operations.traceability.form.unit",
            "type": "select",
            "required": true,
            "colSpan": 1,
            "options": [
              {
                "value": "kg"
              },
              {
                "value": "g"
              },
              {
                "value": "l"
              },
              {
                "value": "ml"
              },
              {
                "value": "buc"
              },
              {
                "value": "cutie"
              },
              {
                "value": "sac"
              },
              {
                "value": "palet"
              }
            ]
          },
          {
            "name": "supplier_id",
            "label": "operations.traceability.form.supplier",
            "type": "relation",
            "colSpan": 1,
            "relation": {
              "dataSource": "/api/data/trace_suppliers?is_active[eq]=true&sort=name&order=asc&limit=500",
              "dataPath": "records",
              "valueKey": "id",
              "labelKey": "name"
            }
          },
          {
            "name": "location_id",
            "label": "operations.traceability.form.location",
            "type": "relation",
            "colSpan": 1,
            "relation": {
              "dataSource": "/api/data/trace_locations?sort=warehouse&order=asc&limit=500",
              "dataPath": "records",
              "valueKey": "id",
              "labelKey": [
                "warehouse",
                "row",
                "shelf"
              ]
            }
          },
          {
            "name": "best_before_date",
            "label": "operations.traceability.col.bbd",
            "type": "date",
            "colSpan": 1
          },
          {
            "name": "reception_date",
            "label": "operations.traceability.col.reception",
            "type": "date",
            "colSpan": 1
          },
          {
            "name": "invoice_ref",
            "label": "operations.traceability.col.invoice",
            "colSpan": 1
          },
          {
            "name": "supplier_lot_ref",
            "label": "operations.traceability.col.supplierLot",
            "colSpan": 1
          },
          {
            "name": "production_date",
            "label": "operations.traceability.col.productionDate",
            "type": "date",
            "colSpan": 1
          },
          {
            "name": "sscc",
            "label": "operations.traceability.col.sscc",
            "mono": true,
            "colSpan": 1
          },
          {
            "name": "gtin_scanned",
            "label": "operations.traceability.col.gtin",
            "mono": true,
            "colSpan": 1
          },
          {
            "name": "notes",
            "label": "common.col.notes",
            "type": "textarea",
            "colSpan": 2
          }
        ]
      },
      "filters": [
        {
          "param": "status[eq]",
          "options": [
            {
              "value": "all",
              "label": "common.filter.all"
            },
            {
              "value": "quarantine",
              "label": "operations.traceability.status.quarantine"
            },
            {
              "value": "available",
              "label": "operations.traceability.status.available"
            },
            {
              "value": "exhausted",
              "label": "operations.traceability.status.exhausted"
            },
            {
              "value": "recalled",
              "label": "operations.traceability.status.recalled"
            }
          ]
        }
      ],
      "pagination": {
        "limit": 50
      },
      "readOnlyReason": "a lot is received, released and drawn from only through the actions, so its stock and its trail stay one record."
    },
    {
      "id": "production",
      "label": "operations.traceability.tab.production",
      "icon": "Factory",
      "dataSource": "/api/data/trace_production_orders?expand=output_lot_id&sort=created_at&order=desc",
      "dataPath": "records",
      "columns": [
        {
          "key": "order_number",
          "label": "operations.traceability.col.order",
          "type": "mono"
        },
        {
          "key": "output_lot_id_expanded.lot_number",
          "label": "operations.traceability.col.lot",
          "type": "mono"
        },
        {
          "key": "status",
          "label": "common.col.status",
          "type": "badge",
          "badge": {
            "colors": {
              "draft": "badge-ghost",
              "in_progress": "badge-warning",
              "completed": "badge-success"
            }
          }
        },
        {
          "key": "planned_quantity",
          "label": "operations.traceability.col.planned"
        },
        {
          "key": "unit",
          "label": "operations.traceability.form.unit"
        },
        {
          "key": "started_at",
          "label": "operations.traceability.col.started",
          "type": "date"
        }
      ],
      "rowActions": [
        {
          "id": "open",
          "kind": "navigate",
          "href": "/traceability/production/{id}",
          "icon": "Factory",
          "label": "operations.traceability.action.details"
        },
        {
          "id": "start",
          "icon": "Play",
          "label": "operations.traceability.action.start",
          "method": "POST",
          "endpoint": "/ext/operations/traceability/actions/startProduction",
          "visibleWhen": {
            "field": "status",
            "equals": "draft"
          },
          "body": {
            "id": "{id}"
          }
        },
        {
          "id": "consume",
          "label": "operations.traceability.action.consume",
          "method": "POST",
          "endpoint": "/ext/operations/traceability/actions/consumeLot",
          "body": {
            "production_order_id": "{id}"
          },
          "visibleWhen": {
            "field": "status",
            "equals": "in_progress"
          },
          "prompt": {
            "fields": [
              {
                "name": "lot_id",
                "label": "operations.traceability.col.lot",
                "type": "relation",
                "required": true,
                "relation": {
                  "dataSource": "/api/data/trace_lots?status[eq]=available&expand=item_id&sort=lot_number&order=asc&limit=500",
                  "dataPath": "records",
                  "valueKey": "id",
                  "labelKey": [
                    "lot_number",
                    "item_id_expanded.name"
                  ]
                }
              },
              {
                "name": "quantity_used",
                "label": "operations.traceability.col.qty",
                "type": "number",
                "required": true
              }
            ]
          }
        },
        {
          "id": "haccp",
          "label": "operations.traceability.action.haccp",
          "method": "POST",
          "endpoint": "/ext/operations/traceability/actions/recordHaccp",
          "body": {
            "production_order_id": "{id}"
          },
          "visibleWhen": {
            "field": "status",
            "equals": "in_progress"
          },
          "prompt": {
            "fields": [
              {
                "name": "ccp",
                "label": "operations.traceability.col.ccp",
                "required": true
              },
              {
                "name": "value",
                "label": "operations.traceability.col.value",
                "type": "number",
                "required": true
              },
              {
                "name": "unit",
                "label": "operations.traceability.col.unit",
                "required": true
              },
              {
                "name": "limit_min",
                "label": "operations.traceability.col.limitMin",
                "type": "number"
              },
              {
                "name": "limit_max",
                "label": "operations.traceability.col.limitMax",
                "type": "number"
              },
              {
                "name": "ok",
                "label": "operations.traceability.col.ok",
                "type": "boolean",
                "required": true
              }
            ]
          }
        },
        {
          "id": "complete",
          "icon": "CheckCircle",
          "label": "operations.traceability.action.complete",
          "method": "POST",
          "endpoint": "/ext/operations/traceability/actions/completeProduction",
          "visibleWhen": {
            "field": "status",
            "equals": "in_progress"
          },
          "prompt": {
            "title": "operations.traceability.action.complete",
            "fields": [
              {
                "name": "actual_quantity",
                "label": "operations.traceability.col.actual",
                "type": "number",
                "required": true
              }
            ]
          },
          "body": {
            "id": "{id}"
          }
        }
      ],
      "form": {
        "endpoint": "/ext/operations/traceability/actions/createProductionOrder",
        "fields": [
          {
            "name": "recipe_id",
            "label": "operations.traceability.form.recipe",
            "type": "relation",
            "colSpan": 2,
            "relation": {
              "dataSource": "/api/data/trace_recipes?is_active[eq]=true&sort=name&order=asc&limit=500",
              "dataPath": "records",
              "valueKey": "id",
              "labelKey": "name"
            }
          },
          {
            "name": "output_item_id",
            "label": "operations.traceability.form.product",
            "type": "relation",
            "required": true,
            "colSpan": 2,
            "relation": {
              "dataSource": "/api/data/trace_items?is_active[eq]=true&sort=name&order=asc&limit=500",
              "dataPath": "records",
              "valueKey": "id",
              "labelKey": [
                "code",
                "name"
              ]
            }
          },
          {
            "name": "planned_quantity",
            "label": "operations.traceability.col.planned",
            "type": "number",
            "required": true,
            "colSpan": 1
          },
          {
            "name": "unit",
            "label": "operations.traceability.form.unit",
            "type": "select",
            "required": true,
            "colSpan": 1,
            "options": [
              {
                "value": "kg"
              },
              {
                "value": "g"
              },
              {
                "value": "l"
              },
              {
                "value": "ml"
              },
              {
                "value": "buc"
              },
              {
                "value": "cutie"
              },
              {
                "value": "sac"
              },
              {
                "value": "palet"
              }
            ]
          },
          {
            "name": "notes",
            "label": "common.col.notes",
            "type": "textarea",
            "colSpan": 2
          }
        ]
      },
      "filters": [
        {
          "param": "status[eq]",
          "options": [
            {
              "value": "all",
              "label": "common.filter.all"
            },
            {
              "value": "draft",
              "label": "operations.traceability.status.draft"
            },
            {
              "value": "in_progress",
              "label": "operations.traceability.status.inProgress"
            },
            {
              "value": "completed",
              "label": "operations.traceability.status.completed"
            }
          ]
        }
      ],
      "readOnlyReason": "an order is created, started, fed and completed only through the actions, so its output lot follows it."
    },
    {
      "id": "dispatches",
      "label": "operations.traceability.tab.dispatches",
      "icon": "Truck",
      "dataSource": "/api/data/trace_dispatches?expand=lot_id&sort=created_at&order=desc",
      "dataPath": "records",
      "columns": [
        {
