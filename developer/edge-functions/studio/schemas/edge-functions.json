        {
          "key": "is_active",
          "label": "common.col.status",
          "type": "boolean"
        }
      ],
      "rowActions": [
        {
          "id": "edit",
          "kind": "edit",
          "icon": "Code",
          "label": "common.edit"
        },
        {
          "id": "invoke",
          "icon": "Play",
          "label": "developer.edge-functions.btn.run",
          "method": "POST",
          "endpoint": "/ext/developer/edge-functions/{id}/invoke"
        },
        {
          "id": "delete",
          "icon": "Trash2",
          "variant": "text-error",
          "label": "common.delete",
          "method": "DELETE",
          "endpoint": "/ext/developer/edge-functions/{id}",
          "confirm": "developer.edgeFunctions.confirmDelete"
        }
      ],
      "form": {
        "endpoint": "/ext/developer/edge-functions",
        "fields": [
          {
            "name": "name",
            "label": "developer.edge-functions.ui.name_url_safe",
            "required": true,
            "mono": true,
            "colSpan": 1,
            "placeholder": "developer.edge-functions.ui.my_function"
          },
          {
            "name": "display_name",
            "label": "developer.edge-functions.ui.display_name",
            "required": true,
            "colSpan": 1,
            "placeholder": "developer.edge-functions.form.displayNamePlaceholder"
          },
          {
            "name": "http_method",
            "label": "developer.edge-functions.ui.http_method",
            "type": "select",
            "colSpan": 1,
            "default": "POST",
            "options": [
              { "value": "GET", "label": "GET" },
              { "value": "POST", "label": "POST" },
              { "value": "PUT", "label": "PUT" },
              { "value": "PATCH", "label": "PATCH" },
              { "value": "DELETE", "label": "DELETE" },
              { "value": "ANY", "label": "ANY" }
            ]
          },
          {
            "name": "timeout_ms",
            "label": "developer.edge-functions.form.timeoutMs",
