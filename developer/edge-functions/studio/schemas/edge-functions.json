            "colSpan": 1,
            "default": 30000
          },
          {
            "name": "description",
            "label": "common.col.description",
            "colSpan": 2
          },
          {
            "name": "code",
            "label": "developer.edge-functions.panel.title",
            "type": "textarea",
            "mono": true,
            "rows": 12,
            "colSpan": 2,
            "default": "export default async function handler(ctx) {\n  const body = await ctx.request.json().catch(() => ({}));\n  return Response.json({ message: \"Hello from edge!\", input: body });\n}\n"
          },
          {
            "name": "env_vars",
            "label": "developer.edge-functions.form.envVars",
            "type": "json",
            "mono": true,
            "rows": 3,
            "colSpan": 2,
            "default": "{}"
          }
        ]
      }
    }
