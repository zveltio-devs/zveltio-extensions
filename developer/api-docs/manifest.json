{
  "name": "developer/api-docs",
  "displayName": "API Documentation",
  "category": "developer",
  "description": "Swagger UI over the data API: each visitor sees the collections they may read",
  "version": "2.1.1",
  "zveltioMinVersion": "3.0.0-beta.96",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-api-docs",
  "permissions": [],
  "i18nPrefixes": [
    "developer.api-docs"
  ],
  "studio": {
    "pages": [
      {
        "path": "/admin/developer/api-docs",
        "label": "API Docs",
        "icon": "BookOpen",
        "schema": "schemas/api-docs.json"
      }
    ],
    "navGroup": "developer"
  },
  "contributes": {
    "engine": true,
    "studio": true
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "integrity": {
    "engineSha256": "0655be9cf428d657bd98be6d1c45d35c294782755d3b32e0000fdd776812dc18",
    "sourceSha256": "861e550cf3cdf50d0414cdbff283168664595fe49f49275f58c683dc39e26df5",
    "schemaSha256": "8a140f1880329319eb85985654b4fa48446637f3c731034fa3ffdf49ffdd2c46"
  },
  "publicRoutes": [
    "/"
  ],
  "collections": [
    "apidoc_changelogs",
    "apidoc_pages"
  ],
  "actions": [
    {
      "name": "publish",
      "permission": {
        "resource": "apidoc_changelogs",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "apidoc_changelogs"
      ],
      "writes": [
        "apidoc_changelogs"
      ]
    },
    {
      "name": "unpublish",
      "permission": {
        "resource": "apidoc_changelogs",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "apidoc_changelogs"
      ],
      "writes": [
        "apidoc_changelogs"
      ]
    }
  ]
}
