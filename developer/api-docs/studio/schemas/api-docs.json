{
  "spec": "zveltio.view/2",
  "title": "developer.api-docs.title",
  "type": "tabs",
  "items": [
    {
      "type": "list",
      "collection": "apidoc_changelogs",
      "title": "developer.api-docs.tab.changelog",
      "fields": [
        {
          "field": "version",
          "label": "common.col.version",
          "display": "mono"
        },
        {
          "field": "title",
          "label": "common.col.title"
        },
        {
          "field": "is_published",
          "label": "developer.api-docs.col.public"
        },
        {
          "field": "published_at",
          "label": "common.col.date"
        }
      ],
      "sort": "-created_at",
      "edit": true,
      "delete": true,
      "rowActions": [
        {
          "action": "publish",
          "label": "common.publish",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "when": [
            {
              "field": "is_published",
              "op": "eq",
              "value": false
            }
          ]
        },
        {
          "action": "unpublish",
          "label": "developer.api-docs.btn.unpublish",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "when": [
            {
              "field": "is_published",
              "op": "eq",
              "value": true
            }
          ]
        }
      ],
      "create": true
    },
    {
      "type": "list",
      "collection": "apidoc_pages",
      "title": "developer.api-docs.tab.customPages",
      "fields": [
        {
          "field": "slug",
          "label": "common.col.slug",
          "display": "mono"
        },
        {
          "field": "title",
          "label": "common.col.title"
        },
        {
          "field": "is_published",
          "label": "developer.api-docs.col.public"
        },
        {
          "field": "updated_at",
          "label": "developer.api-docs.col.updated"
        }
      ],
      "sort": "sort_order",
      "edit": true,
      "delete": true,
      "create": true
    }
  ]
}
