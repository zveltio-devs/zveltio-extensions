{
  "name": "developer/graphql",
  "displayName": "GraphQL API",
  "category": "developer",
  "description": "Auto-generated GraphQL API with playground for all collections",
  "version": "2.2.0",
  "zveltioMinVersion": "3.0.0-beta.116",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-graphql",
  "permissions": [
    "data:write"
  ],
  "apiKeyRoutes": [
    "POST /",
    "POST /persisted/*/execute"
  ],
  "routes": [
    {
      "method": "GET",
      "path": "/",
      "access": "caller",
      "handler": "playground"
    },
    {
      "method": "POST",
      "path": "/",
      "access": "caller",
      "handler": "executeQuery"
    },
    {
      "method": "POST",
      "path": "/refresh-schema",
      "access": "caller",
      "handler": "refreshSchema"
    },
    {
      "method": "POST",
      "path": "/persisted/:name/execute",
      "access": "caller",
      "handler": "executePersisted"
    }
  ],
  "i18nPrefixes": [
    "developer.graphql"
  ],
  "peerDependencies": {
    "graphql": "^16.0.0"
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/developer/graphql",
        "label": "GraphQL",
        "icon": "Network",
        "schema": "schemas/graphql.json"
      },
      {
        "path": "/admin/developer/graphql/playground",
        "label": "GraphQL Playground",
        "icon": "Play"
      }
    ],
    "navGroup": "developer"
  },
  "contributes": {
    "engine": true,
    "studio": true
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": true
  },
  "collections": [
    "graphql_queries"
  ],
  "integrity": {
    "engineSha256": "f763bbd88cbc05c12a0dfa8da6e0ab93d71407a4f988681ba182d952605c8f70",
    "sourceSha256": "15d6fc2836276247d38b498f493ec8b50ea33e2e5e62cea89fdb3ee9fc86b798",
    "schemaSha256": "5e5727891cb98fe8877c261a2701a83bbe31ddda24e5364296b39789c69a98f4"
  }
}
