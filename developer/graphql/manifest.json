{
  "name": "developer/graphql",
  "displayName": "GraphQL API",
  "category": "developer",
  "description": "Auto-generated GraphQL API with playground for all collections",
  "version": "2.0.0",
  "zveltioMinVersion": "3.0.0-beta.99",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-graphql",
  "permissions": [
    "data:write"
  ],
  "apiKeyRoutes": [
    "POST /",
    "POST /persisted/*/execute"
  ],
  "i18nPrefixes": [
    "developer.graphql"
  ],
  "peerDependencies": {
    "graphql": "^16.0.0"
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/developer/graphql",
        "label": "GraphQL",
        "icon": "Network",
        "schema": "schemas/graphql.json"
      },
      {
        "path": "/admin/developer/graphql/playground",
        "label": "GraphQL Playground",
        "icon": "Play"
      }
    ],
    "navGroup": "developer"
  },
  "contributes": {
    "engine": true,
    "studio": true
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": true
  },
  "collections": [
    "graphql_queries"
  ],
  "integrity": {
    "engineSha256": "89f4c7b06b4733419fba4aead1a2354e61c5fa7ae50b73e811a80ba4474d9b57",
    "sourceSha256": "0b86cdfb436e8083537f162ff3a782a674e07c5ecfa1f6e6d571a9955de02271",
    "schemaSha256": "5e5727891cb98fe8877c261a2701a83bbe31ddda24e5364296b39789c69a98f4"
  }
}
