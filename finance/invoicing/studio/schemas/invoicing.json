{
  "spec": "zveltio.view/2",
  "id": "invoicing.invoices",
  "title": "invoicing.title",
  "type": "list",
  "collection": "invoices",
  "fields": [
    { "field": "number", "label": "invoicing.col.number", "display": "mono" },
    {
      "field": "doc_type",
      "label": "invoicing.form.docType",
      "display": "badge",
      "tones": { "invoice": "info", "proforma": "muted", "delivery_note": "info" }
    },
    { "field": "client_name", "label": "invoicing.col.client" },
    { "field": "total", "label": "invoicing.col.total" },
    { "field": "amount_paid", "label": "invoicing.col.paid" },
    {
      "field": "status",
      "label": "invoicing.col.status",
      "display": "badge",
      "tones": {
        "draft": "muted",
        "sent": "info",
        "partially_paid": "warning",
        "paid": "success",
        "overdue": "danger",
        "cancelled": "muted"
      }
    },
    { "field": "due_date", "label": "invoicing.col.dueDate" }
  ],
  "sort": "-created_at",
  "actions": [{ "navigate": "invoicing.new", "label": "invoicing.newInvoice" }],
  "rowActions": [
    {
      "action": "sendInvoice",
      "label": "invoicing.action.send",
      "input": { "id": { "$record": "id" } },
      "when": [{ "field": "status", "op": "eq", "value": "draft" }]
    },
    {
      "action": "recordPayment",
      "label": "invoicing.action.recordPayment",
      "input": { "id": { "$record": "id" } },
      "prompt": ["amount", "payment_date", "payment_method", "reference"],
      "when": [{ "field": "status", "op": "in", "value": ["sent", "partially_paid", "overdue"] }]
    },
    {
      "action": "convertProforma",
      "label": "invoicing.action.convert",
      "input": { "id": { "$record": "id" } },
      "when": [{ "field": "doc_type", "op": "eq", "value": "proforma" }]
    },
    {
      "action": "cancelInvoice",
      "label": "invoicing.action.cancel",
      "tone": "warning",
      "input": { "id": { "$record": "id" } },
      "confirm": "invoicing.cancelConfirm",
      "when": [
        { "field": "status", "op": "in", "value": ["draft", "sent", "overdue", "partially_paid"] }
      ]
    },
    {
      "action": "deleteDraft",
      "label": "common.delete",
      "tone": "danger",
      "input": { "id": { "$record": "id" } },
      "confirm": "invoicing.deleteConfirm",
      "when": [{ "field": "status", "op": "eq", "value": "draft" }]
    }
  ]
}
