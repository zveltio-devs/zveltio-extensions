{
  "name": "company_profile",
  "fields": [
    {
      "name": "singleton",
      "type": "text",
      "required": true,
      "unique": true,
      "defaultValue": "company"
    },
    {
      "name": "name",
      "type": "text",
      "required": true
    },
    {
      "name": "legal_name",
      "type": "text"
    },
    {
      "name": "tax_id",
      "type": "text"
    },
    {
      "name": "reg_no",
      "type": "text"
    },
    {
      "name": "vat_payer",
      "type": "boolean",
      "required": true,
      "defaultValue": true
    },
    {
      "name": "vat_on_collection",
      "type": "boolean",
      "required": true,
      "defaultValue": false
    },
    {
      "name": "address",
      "type": "textarea"
    },
    {
      "name": "city",
      "type": "text"
    },
    {
      "name": "county",
      "type": "text"
    },
    {
      "name": "country",
      "type": "text",
      "required": true,
      "defaultValue": "RO"
    },
    {
      "name": "iban",
      "type": "text"
    },
    {
      "name": "bank",
      "type": "text"
    },
    {
      "name": "share_capital",
      "type": "text"
    },
    {
      "name": "email",
      "type": "email"
    },
    {
      "name": "phone",
      "type": "phone"
    },
    {
      "name": "website",
      "type": "url"
    },
    {
      "name": "logo_url",
      "type": "url"
    }
  ],
  "validation": [
    {
      "field": "tax_id",
      "rule": "custom",
      "config": {
        "expression": "value == null || value == \"\" || value.matches(\"^[0-9]{2,10}$\") && (int(value) / 1000000000 % 10 * 7 + int(value) / 100000000 % 10 * 5 + int(value) / 10000000 % 10 * 3 + int(value) / 1000000 % 10 * 2 + int(value) / 100000 % 10 * 1 + int(value) / 10000 % 10 * 7 + int(value) / 1000 % 10 * 5 + int(value) / 100 % 10 * 3 + int(value) / 10 % 10 * 2) * 10 % 11 % 10 == int(value) % 10"
      },
      "message": "Not a valid Romanian CUI: 2 to 10 digits with a valid check digit, no RO prefix (that is vat_payer)."
    }
  ]
}
