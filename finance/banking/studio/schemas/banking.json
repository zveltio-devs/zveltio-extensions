{
  "spec": "zveltio.view/2",
  "title": "finance.banking.title",
  "type": "tabs",
  "items": [
    {
      "type": "list",
      "collection": "bank_accounts",
      "title": "finance.banking.tab.accounts",
      "fields": [
        {
          "field": "name",
          "label": "common.col.name"
        },
        {
          "field": "bank_name",
          "label": "common.col.bank"
        },
        {
          "field": "iban",
          "label": "common.col.iban",
          "display": "mono"
        },
        {
          "field": "currency",
          "label": "common.col.currency",
          "display": "mono"
        },
        {
          "field": "balance",
          "label": "common.col.balance"
        },
        {
          "field": "is_active",
          "label": "common.col.active"
        }
      ],
      "sort": "-created_at",
      "edit": true,
      "rowActions": [
        {
          "action": "refreshBalance",
          "label": "finance.banking.action.refresh",
          "input": {
            "id": {
              "$record": "id"
            }
          }
        }
      ],
      "create": true
    },
    {
      "type": "split",
      "panes": [
        {
          "type": "list",
          "id": "master",
          "collection": "bank_accounts",
          "fields": [
            "name",
            "bank_name",
            "iban",
            "currency"
          ],
          "sort": "-created_at"
        },
        {
          "type": "list",
          "collection": "bank_transactions",
          "fields": [
            {
              "field": "date",
              "label": "common.col.date"
            },
            {
              "field": "description",
              "label": "common.col.description"
            },
            {
              "field": "type",
              "label": "common.col.type",
              "display": "badge",
              "tones": {
                "credit": "success",
                "debit": "warning"
              }
            },
            {
              "field": "amount",
              "label": "common.col.amount"
            },
            {
              "field": "category",
              "label": "common.col.category"
            },
            {
              "field": "is_reconciled",
              "label": "finance.banking.status.reconciled"
            }
          ],
          "filter": [
            {
              "field": "account_id",
              "op": "eq",
              "value": {
                "$selected": "master"
              }
            }
          ],
          "sort": "-date",
          "rowActions": [
            {
              "action": "reconcile",
              "label": "finance.banking.action.reconcile",
              "input": {
                "transaction_id": {
                  "$record": "id"
                },
                "linked_type": "manual"
              },
              "when": [
                {
                  "field": "is_reconciled",
                  "op": "eq",
                  "value": false
                }
              ]
            },
            {
              "action": "reconcile",
              "label": "finance.banking.action.payInvoice",
              "input": {
                "transaction_id": {
                  "$record": "id"
                },
                "linked_type": "invoice"
              },
              "prompt": [
                "linked_id"
              ],
              "when": [
                {
                  "field": "type",
                  "op": "eq",
                  "value": "credit"
                }
              ]
            }
          ]
        }
      ],
      "title": "finance.banking.tab.transactions"
    }
  ]
}
