{
  "name": "finance/quotes",
  "displayName": "Quotes & Proposals",
  "category": "finance",
  "description": "Quotes and proposals linked to CRM contacts, converted into invoices",
  "version": "2.0.0",
  "zveltioMinVersion": "3.0.0-beta.92",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-quotes",
  "permissions": [
    "data:write"
  ],
  "i18nPrefixes": [
    "finance.quotes",
    "quotes"
  ],
  "dependencies": [
    {
      "name": "finance/invoicing",
      "minVersion": "2.0.0"
    }
  ],
  "studio": {
    "pages": [
      {
        "path": "/admin/finance/quotes",
        "label": "Quotes",
        "icon": "FileText",
        "schema": "schemas/quotes.json"
      }
    ],
    "navGroup": "finance"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "fieldTypes": []
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "collections": [
    "quotes",
    "quote_lines"
  ],
  "actions": [
    {
      "name": "createQuote",
      "permission": {
        "resource": "quotes",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "title",
          "client_name",
          "lines"
        ],
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1
          },
          "client_name": {
            "type": "string",
            "minLength": 1
          },
          "contact_id": {
            "type": "string",
            "format": "uuid"
          },
          "organization_id": {
            "type": "string",
            "format": "uuid"
          },
          "client_email": {
            "type": "string"
          },
          "valid_until": {
            "type": "string",
            "format": "date"
          },
          "valid_days": {
            "type": "integer",
            "minimum": 1
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "tax_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "discount_percent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "series": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "terms": {
            "type": "string"
          },
          "footer_notes": {
            "type": "string"
          },
          "po_number": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "description"
              ],
              "additionalProperties": false,
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1
                },
                "quantity": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "unit_price": {
                  "type": "number",
                  "minimum": 0
                },
                "tax_rate": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "discount": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                "sort_order": {
                  "type": "integer"
                }
              }
            }
          }
        }
      },
      "reads": [
        "quotes",
        "quote_lines",
        "document_series"
      ],
      "writes": [
        "document_series",
        "quotes",
        "quote_lines"
      ]
    },
    {
      "name": "convertToInvoice",
      "permission": {
        "resource": "invoices",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "series": {
            "type": "string"
          },
          "client_tax_id": {
            "type": "string"
          },
          "exchange_rate": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "due_days": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "reads": [
        "quotes",
        "quote_lines",
        "document_series",
        "company_profile",
        "invoices",
        "invoice_lines"
      ],
      "writes": [
        "quotes",
        "document_series",
        "invoices",
        "invoice_lines"
      ]
    }
  ],
  "integrity": {
    "engineSha256": "a62fa356d4facccd6d2157bae04ef4ad6b440efb98dada0a1683d050a406a756",
    "sourceSha256": "9b0e5c3c8e87d5b1ca3c8af60d960e32c6ffefa257b2a502b41c73a1df33c36f",
    "schemaSha256": "e05ed125316c2f2fb0e081ca1d54aa26608f67423a32c6c3785f6444675b026a"
  }
}
