{
  "spec": "zveltio.view/2",
  "title": "finance.quotes.title",
  "type": "list",
  "collection": "quotes",
  "fields": [
    {
      "field": "number",
      "label": "common.col.number",
      "display": "mono"
    },
    {
      "field": "client_name",
      "label": "common.col.client"
    },
    {
      "field": "total",
      "label": "common.col.total"
    },
    {
      "field": "status",
      "label": "common.col.status",
      "display": "badge",
      "tones": {
        "draft": "muted",
        "sent": "info",
        "accepted": "success",
        "rejected": "danger",
        "expired": "warning"
      }
    },
    {
      "field": "valid_until",
      "label": "common.col.validUntil"
    },
    {
      "field": "created_at",
      "label": "common.col.created"
    }
  ],
  "sort": "-created_at",
  "edit": true,
  "delete": true,
  "rowActions": [
    {
      "action": "convertToInvoice",
      "label": "finance.quotes.btn.convert",
      "input": {
        "id": {
          "$record": "id"
        }
      },
      "prompt": [
        "client_tax_id"
      ],
      "when": [
        {
          "field": "status",
          "op": "eq",
          "value": "accepted"
        }
      ]
    }
  ]
}
