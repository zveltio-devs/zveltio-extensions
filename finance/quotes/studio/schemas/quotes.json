{
  "sduiSchema": 1,
  "title": "finance.quotes.title",
  "subtitle": "finance.quotes.subtitle",
  "newLabel": "finance.quotes.btn.new",
  "resources": [
    {
      "id": "quotes",
      "dataSource": "/ext/finance/quotes",
      "dataPath": "data",
      "columns": [
        {
          "key": "quote_number",
          "label": "common.col.number",
          "type": "mono"
        },
        {
          "key": "client_name",
          "label": "common.col.client",
          "secondary": "client_email"
        },
        {
          "key": "total",
          "label": "common.col.total",
          "type": "currency",
          "currency": {
            "codeKey": "currency"
          }
        },
        {
          "key": "status",
          "label": "common.col.status",
          "type": "badge",
          "badge": {
            "colors": {
              "draft": "badge-ghost",
              "sent": "badge-info",
              "accepted": "badge-success",
              "rejected": "badge-error",
              "expired": "badge-warning"
            }
          }
        },
        {
          "key": "valid_until",
          "label": "common.col.validUntil",
          "type": "date"
        },
        {
          "key": "created_at",
          "label": "common.col.created",
          "type": "date"
        }
      ],
      "rowActions": [
        {
          "id": "send",
          "icon": "Send",
          "method": "POST",
          "endpoint": "/ext/finance/quotes/{id}/send",
          "visibleWhen": {
            "field": "status",
            "equals": "draft"
          }
        },
        {
          "id": "accept",
          "icon": "CheckCircle",
          "variant": "text-success",
          "method": "POST",
          "endpoint": "/ext/finance/quotes/{id}/accept",
          "visibleWhen": {
            "field": "status",
            "equals": "sent"
          }
        },
        {
          "id": "delete",
          "icon": "Trash2",
          "variant": "text-error",
          "method": "DELETE",
          "endpoint": "/ext/finance/quotes/{id}",
          "confirm": "finance.quotes.deleteConfirm"
        }
      ],
      "readOnlyReason": "a quote needs at least one line item; a flat form cannot express it, so this resource lists rather than creates. A dedicated page is the fix, not a schema field."
    }
  ]
}
