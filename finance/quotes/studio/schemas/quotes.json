{
  "sduiSchema": 1,
  "title": "finance.quotes.title",
  "subtitle": "finance.quotes.subtitle",
  "newLabel": "finance.quotes.btn.new",
  "resources": [
    {
      "id": "quotes",
      "dataSource": "/api/data/quotes?sort=created_at&order=desc&limit=500",
      "dataPath": "records",
      "columns": [
        {
          "key": "number",
          "label": "common.col.number",
          "type": "mono"
        },
        {
          "key": "client_name",
          "label": "common.col.client",
          "secondary": "client_email"
        },
        {
          "key": "total",
          "label": "common.col.total",
          "type": "currency",
          "currency": {
            "codeKey": "currency"
          }
        },
        {
          "key": "status",
          "label": "common.col.status",
          "type": "badge",
          "badge": {
            "colors": {
              "draft": "badge-ghost",
              "sent": "badge-info",
              "accepted": "badge-success",
              "rejected": "badge-error",
              "expired": "badge-warning"
            }
          }
        },
        {
          "key": "valid_until",
          "label": "common.col.validUntil",
          "type": "date"
        },
        {
          "key": "created_at",
          "label": "common.col.created",
          "type": "date"
        }
      ],
      "rowActions": [
        {
          "id": "send",
          "icon": "Send",
          "label": "finance.quotes.btn.send",
          "method": "PATCH",
          "endpoint": "/api/data/quotes/{id}",
          "visibleWhen": {
            "field": "status",
            "equals": "draft"
          },
          "body": {
            "status": "sent"
          }
        },
        {
          "id": "accept",
          "icon": "CheckCircle",
          "label": "finance.quotes.btn.accept",
          "variant": "text-success",
          "method": "PATCH",
          "endpoint": "/api/data/quotes/{id}",
          "visibleWhen": {
            "field": "status",
            "equals": "sent"
          },
          "body": {
            "status": "accepted"
          }
        },
        {
          "id": "reject",
          "icon": "XCircle",
          "label": "finance.quotes.btn.reject",
          "variant": "text-error",
          "method": "PATCH",
          "endpoint": "/api/data/quotes/{id}",
          "visibleWhen": {
            "field": "status",
            "equals": "sent"
          },
          "body": {
            "status": "rejected"
          }
        },
        {
          "id": "convert",
          "icon": "FileCheck",
          "label": "finance.quotes.btn.convert",
          "method": "POST",
          "endpoint": "/ext/finance/quotes/actions/convertToInvoice",
          "visibleWhen": {
            "field": "status",
            "equals": "accepted"
          },
          "prompt": {
            "title": "finance.quotes.btn.convert",
            "submitLabel": "finance.quotes.btn.convert",
            "fields": [
              {
                "name": "client_tax_id",
                "label": "finance.quotes.ui.client_tax_id",
                "type": "text"
              }
            ]
          },
          "body": {
            "id": "{id}"
          }
        },
        {
          "id": "delete",
          "icon": "Trash2",
          "variant": "text-error",
          "label": "common.delete",
          "method": "DELETE",
          "endpoint": "/api/data/quotes/{id}",
          "confirm": "finance.quotes.deleteConfirm",
          "visibleWhen": {
            "field": "status",
            "equals": "draft"
          }
        }
      ],
      "readOnlyReason": "a quote needs at least one line item; a flat form cannot express it, so this resource lists rather than creates. A dedicated page is the fix, not a schema field."
    }
  ]
}
