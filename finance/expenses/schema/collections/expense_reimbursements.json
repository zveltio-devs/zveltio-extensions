      "indexed": true,
      "options": {
        "related_collection": "expense_reports"
      }
    },
    {
      "name": "amount",
      "type": "decimal",
      "required": true
    },
    {
      "name": "currency",
      "type": "text",
      "required": true,
      "defaultValue": "RON"
    },
    {
      "name": "payment_date",
      "type": "date",
      "required": true
    },
    {
      "name": "payment_method",
      "type": "enum",
      "required": true,
      "defaultValue": "transfer",
      "options": {
        "values": [
          "cash",
          "card",
          "transfer",
          "check",
          "other"
        ]
      }
    },
    {
      "name": "reference",
      "type": "text"
    },
    {
      "name": "notes",
      "type": "textarea"
    }
  ],
  "relations": [
    {
      "name": "expense_reimbursements_report_id",
      "type": "m2o",
      "field": "report_id",
      "target": "expense_reports",
      "targetField": "id",
      "onDelete": "RESTRICT",
      "onUpdate": "CASCADE",
      "metadata": {}
    }
  ],
  "validation": [
    {
      "field": "amount",
      "rule": "min",
      "config": {
        "value": 0.01
      },
      "message": "A reimbursement is a positive amount."
