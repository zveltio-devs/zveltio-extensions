      "options": {
        "related_collection": "expense_reports"
      }
    },
    {
      "name": "date",
      "type": "date",
      "required": true
    },
    {
      "name": "destination",
      "type": "text",
      "required": true
    },
    {
      "name": "rate",
      "type": "decimal",
      "required": true
    },
    {
      "name": "currency",
      "type": "text",
      "required": true,
      "defaultValue": "RON"
    },
    {
      "name": "is_domestic",
      "type": "boolean",
      "required": true,
      "defaultValue": true
    },
    {
