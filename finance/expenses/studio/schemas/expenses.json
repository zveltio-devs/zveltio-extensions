{
  "sduiSchema": 1,
  "title": "finance.expenses.title",
  "subtitle": "finance.expenses.subtitle",
  "newLabel": "finance.expenses.new",
  "resources": [
    {
      "id": "expenses",
      "dataSource": "/ext/finance/expenses/reports",
      "dataPath": "data",
      "filters": [
        {
          "param": "status",
          "options": [
            {
              "value": "all",
              "label": "finance.expenses.filter.all"
            },
            {
              "value": "draft",
              "label": "finance.expenses.filter.draft"
            },
            {
              "value": "submitted",
              "label": "finance.expenses.filter.submitted"
            },
            {
              "value": "approved",
              "label": "finance.expenses.filter.approved"
            },
            {
              "value": "reimbursed",
              "label": "finance.expenses.filter.reimbursed"
            }
          ]
        }
      ],
      "columns": [
        {
          "key": "expense_date",
          "label": "finance.expenses.col.date",
          "type": "date"
        },
        {
          "key": "category",
          "label": "common.col.category",
          "type": "badge",
          "badge": {
            "colors": {}
          }
        },
        {
          "key": "vendor",
          "label": "finance.expenses.col.vendor"
        },
        {
          "key": "description",
          "label": "finance.expenses.col.description"
        },
        {
          "key": "amount",
          "label": "finance.expenses.col.amount",
          "type": "currency",
          "currency": {
            "codeKey": "currency"
          }
        },
        {
          "key": "status",
          "label": "finance.expenses.col.status",
          "type": "badge",
          "badge": {
            "colors": {
              "draft": "badge-ghost",
              "submitted": "badge-warning",
              "approved": "badge-success",
              "reimbursed": "badge-info",
              "rejected": "badge-error"
            }
          }
        }
      ],
      "rowActions": [
        {
          "id": "approve",
          "label": "finance.expenses.action.approve",
          "icon": "CheckCircle",
          "variant": "text-success",
          "method": "POST",
          "endpoint": "/ext/finance/expenses/reports/{id}/approve",
          "visibleWhen": {
            "field": "status",
            "equals": "submitted"
          }
        }
      ],
      "form": {
        "endpoint": "/ext/finance/expenses/reports",
        "fields": [
          {
            "name": "title",
            "label": "expenses.form.title",
            "required": true,
            "colSpan": 2
          },
          {
            "name": "currency",
            "label": "expenses.form.currency",
            "default": "RON",
            "colSpan": 1
          },
          {
            "name": "notes",
            "label": "expenses.form.notes",
            "type": "textarea",
            "colSpan": 2
          }
        ]
      }
    }
  ]
}
