{
  "spec": "zveltio.view/2",
  "title": "finance.expenses.title",
  "type": "list",
  "collection": "expense_reports",
  "fields": [
    {
      "field": "title",
      "label": "finance.expenses.col.title"
    },
    {
      "field": "submitted_at",
      "label": "finance.expenses.col.date"
    },
    {
      "field": "grand_total",
      "label": "finance.expenses.col.amount"
    },
    {
      "field": "reimbursed_amount",
      "label": "finance.expenses.col.reimbursed"
    },
    {
      "field": "status",
      "label": "finance.expenses.col.status",
      "display": "badge",
      "tones": {
        "draft": "muted",
        "submitted": "warning",
        "approved": "success",
        "reimbursed": "info",
        "rejected": "danger"
      }
    }
  ],
  "sort": "-created_at",
  "rowActions": [
    {
      "action": "recalculate",
      "label": "finance.expenses.action.recalculate",
      "input": {
        "id": {
          "$record": "id"
        }
      },
      "when": [
        {
          "field": "status",
          "op": "eq",
          "value": "draft"
        }
      ]
    },
    {
      "action": "submit",
      "label": "finance.expenses.action.submit",
      "input": {
        "id": {
          "$record": "id"
        }
      },
      "when": [
        {
          "field": "status",
          "op": "eq",
          "value": "draft"
        }
      ]
    },
    {
      "action": "approve",
      "label": "finance.expenses.action.approve",
      "tone": "success",
      "input": {
        "id": {
          "$record": "id"
        }
      },
      "when": [
        {
          "field": "status",
          "op": "eq",
          "value": "submitted"
        }
      ]
    },
    {
      "action": "reject",
      "label": "finance.expenses.action.reject",
      "tone": "danger",
      "input": {
        "id": {
          "$record": "id"
        }
      },
      "prompt": [
        "reason"
      ],
      "when": [
        {
          "field": "status",
          "op": "eq",
          "value": "submitted"
        }
      ]
    },
    {
      "action": "reimburse",
      "label": "finance.expenses.action.reimburse",
      "input": {
        "id": {
          "$record": "id"
        }
      },
      "prompt": [
        "amount",
        "payment_date",
        "reference"
      ],
      "when": [
        {
          "field": "status",
          "op": "eq",
          "value": "approved"
        }
      ]
    }
  ],
  "actions": [
    {
      "action": "createReport",
      "tone": "info",
      "label": "finance.expenses.new",
      "prompt": [
        "title",
        "currency",
        "notes"
      ]
    }
  ]
}
