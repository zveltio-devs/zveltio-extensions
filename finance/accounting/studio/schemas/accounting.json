{
  "sduiSchema": 1,
  "title": "finance.accounting.title",
  "subtitle": "finance.accounting.subtitle",
  "newLabel": "finance.accounting.newEntry",
  "resources": [
    {
      "id": "entries",
      "label": "finance.accounting.tab.entries",
      "icon": "BookOpen",
      "dataSource": "/api/data/journal_entries?sort=date&order=desc&limit=500",
      "dataPath": "records",
      "columns": [
        {
          "key": "date",
          "label": "common.col.date",
          "type": "date"
        },
        {
          "key": "reference",
          "label": "common.col.docNumber",
          "type": "mono"
        },
        {
          "key": "description",
          "label": "common.col.description"
        },
        {
          "key": "status",
          "label": "common.col.status",
          "type": "badge",
          "badge": {
            "colors": {
              "posted": "badge-success",
              "draft": "badge-ghost",
              "voided": "badge-error"
            }
          }
        }
      ],
      "readOnlyReason": "a journal entry needs balanced debit/credit lines; a flat form cannot express it, so this resource lists rather than creates (the createEntry action does). A dedicated page is the fix, not a schema field.",
      "rowActions": [
        {
          "id": "post",
          "icon": "CheckCircle",
          "label": "finance.accounting.postEntry",
          "variant": "text-success",
          "method": "POST",
          "endpoint": "/ext/finance/accounting/actions/postEntry",
          "visibleWhen": {
            "field": "status",
            "equals": "draft"
          },
          "body": {
            "id": "{id}"
          }
        },
        {
          "id": "void",
          "icon": "Ban",
          "label": "finance.accounting.voidEntry",
          "variant": "text-warning",
          "method": "POST",
          "endpoint": "/ext/finance/accounting/actions/voidEntry",
          "confirm": "finance.accounting.voidConfirm",
          "visibleWhen": {
            "field": "status",
            "equals": "posted"
          },
          "body": {
            "id": "{id}"
          }
        },
        {
          "id": "delete",
          "icon": "Trash2",
          "label": "common.delete",
          "variant": "text-error",
          "method": "POST",
          "endpoint": "/ext/finance/accounting/actions/deleteEntry",
          "confirm": "finance.accounting.deleteConfirm",
          "visibleWhen": {
            "field": "status",
            "equals": "draft"
          },
          "body": {
            "id": "{id}"
          }
        }
      ]
    },
    {
      "id": "accounts",
      "label": "finance.accounting.tab.accounts",
      "icon": "Coins",
      "dataSource": "/api/data/accounts?sort=code&limit=500",
      "dataPath": "records",
      "columns": [
        {
          "key": "code",
          "label": "common.col.code",
          "type": "mono"
        },
        {
          "key": "name",
          "label": "common.col.name"
        },
        {
          "key": "type",
          "label": "common.col.type",
          "type": "badge",
          "badge": {
            "colors": {
              "asset": "badge-info",
              "liability": "badge-warning",
              "equity": "badge-primary",
              "revenue": "badge-success",
              "expense": "badge-error"
            }
          }
        },
        {
          "key": "is_active",
          "label": "accounting.col.active",
          "type": "badge",
          "badge": {
            "colors": {
              "true": "badge-success",
              "false": "badge-ghost"
            },
            "labels": {
              "true": "accounting.yes",
              "false": "accounting.no"
            }
          }
        }
      ],
      "form": {
        "endpoint": "/api/data/accounts",
        "fields": [
          {
            "name": "code",
            "label": "common.col.code",
            "required": true,
            "mono": true
          },
          {
            "name": "name",
            "label": "common.col.name",
            "required": true
          },
          {
            "name": "type",
            "label": "common.col.type",
            "type": "select",
            "default": "asset",
            "options": [
              {
                "value": "asset",
                "label": "finance.accounting.ui.asset"
              },
              {
                "value": "liability",
                "label": "finance.accounting.ui.liability"
              },
              {
                "value": "equity",
                "label": "finance.accounting.ui.equity"
              },
              {
                "value": "revenue",
                "label": "finance.accounting.ui.revenue"
              },
              {
                "value": "expense",
                "label": "finance.accounting.ui.expense"
              }
            ]
          },
          {
            "name": "parent_id",
            "label": "common.col.parent",
            "type": "relation",
            "relation": {
              "dataSource": "/api/data/accounts?sort=code&limit=500",
              "dataPath": "records",
              "valueKey": "id",
              "labelKey": [
                "code",
                "name"
              ]
            }
          }
        ]
      }
    },
    {
      "id": "fiscal",
      "label": "finance.accounting.tab.fiscal",
      "icon": "TrendingUp",
      "dataSource": "/api/data/fiscal_years?sort=year&order=desc&limit=100",
      "dataPath": "records",
      "columns": [
        {
          "key": "year",
          "label": "common.col.year"
        },
        {
          "key": "start_date",
          "label": "common.col.start",
          "type": "date"
        },
        {
          "key": "end_date",
          "label": "common.col.end",
          "type": "date"
        },
        {
          "key": "status",
          "label": "common.col.status",
          "type": "badge",
          "badge": {
            "colors": {
              "open": "badge-success",
              "closed": "badge-ghost"
            },
            "labels": {
              "open": "finance.accounting.status.open",
              "closed": "finance.accounting.status.closed"
            }
          }
        }
      ],
      "form": {
        "endpoint": "/api/data/fiscal_years",
        "fields": [
          {
            "name": "year",
            "label": "common.col.year",
            "type": "number",
            "required": true
          },
          {
            "name": "start_date",
            "label": "common.col.start",
            "type": "date",
            "required": true
          },
          {
            "name": "end_date",
            "label": "common.col.end",
            "type": "date",
            "required": true
          }
        ]
      },
      "rowActions": [
        {
          "id": "close",
          "icon": "Lock",
          "label": "finance.accounting.closeYear",
          "variant": "text-warning",
          "method": "POST",
          "endpoint": "/ext/finance/accounting/actions/closeFiscalYear",
          "confirm": "finance.accounting.closeConfirm",
          "visibleWhen": {
            "field": "status",
            "equals": "open"
          },
          "body": {
            "id": "{id}"
          }
        }
      ]
    },
    {
      "id": "cost-centers",
      "label": "accounting.tab.costCenters",
      "icon": "Boxes",
      "dataSource": "/api/data/cost_centers?sort=code&limit=500",
      "dataPath": "records",
      "columns": [
        {
          "key": "code",
          "label": "accounting.col.code"
        },
        {
          "key": "name",
          "label": "accounting.col.name"
        },
        {
          "key": "is_active",
          "label": "accounting.col.active",
          "type": "badge",
          "badge": {
            "colors": {
              "true": "badge-success",
              "false": "badge-ghost"
            },
            "labels": {
              "true": "accounting.yes",
              "false": "accounting.no"
            }
          }
        }
      ],
      "form": {
        "endpoint": "/api/data/cost_centers",
        "fields": [
          {
            "name": "code",
            "label": "accounting.col.code",
            "required": true,
            "colSpan": 1
          },
          {
            "name": "name",
            "label": "accounting.col.name",
            "required": true,
            "colSpan": 1
          }
        ]
      }
    }
  ]
}
