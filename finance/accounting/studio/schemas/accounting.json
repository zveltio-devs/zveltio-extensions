{
  "sduiSchema": 1,
  "title": "finance.accounting.title",
  "subtitle": "finance.accounting.subtitle",
  "newLabel": "finance.accounting.newEntry",
  "resources": [
    {
      "id": "entries",
      "label": "finance.accounting.tab.entries",
      "icon": "BookOpen",
      "dataSource": "/ext/finance/accounting/journal",
      "dataPath": "data",
      "pagination": {
        "limit": 100
      },
      "columns": [
        {
          "key": "date",
          "label": "common.col.date",
          "type": "date"
        },
        {
          "key": "reference",
          "label": "common.col.docNumber",
          "type": "mono"
        },
        {
          "key": "description",
          "label": "common.col.description"
        },
        {
          "key": "status",
          "label": "common.col.status",
          "type": "badge",
          "badge": {
            "colors": {
              "posted": "badge-success",
              "draft": "badge-ghost",
              "void": "badge-error"
            }
          }
        }
      ],
      "readOnlyReason": "a journal entry needs balanced debit/credit lines; a flat form cannot express it, so this resource lists rather than creates. A dedicated page is the fix, not a schema field."
    },
    {
      "id": "accounts",
      "label": "finance.accounting.tab.accounts",
      "icon": "Coins",
      "dataSource": "/ext/finance/accounting/accounts",
      "dataPath": "data",
      "columns": [
        {
          "key": "code",
          "label": "common.col.code",
          "type": "mono"
        },
        {
          "key": "name",
          "label": "common.col.name"
        },
        {
          "key": "type",
          "label": "common.col.type",
          "type": "badge",
          "badge": {
            "colors": {
              "asset": "badge-info",
              "liability": "badge-warning",
              "equity": "badge-primary",
              "revenue": "badge-success",
              "expense": "badge-error"
            }
          }
        },
        {
          "key": "parent_name",
          "label": "common.col.parent"
        }
      ],
      "form": {
        "endpoint": "/ext/finance/accounting/accounts",
        "fields": [
          {
            "name": "code",
            "label": "common.col.code",
            "required": true,
            "mono": true
          },
          {
            "name": "name",
            "label": "common.col.name",
            "required": true
          },
          {
            "name": "type",
            "label": "common.col.type",
            "type": "select",
            "default": "asset",
            "options": [
              {
                "value": "asset",
                "label": "finance.accounting.ui.asset"
              },
              {
                "value": "liability",
                "label": "finance.accounting.ui.liability"
              },
              {
                "value": "equity",
                "label": "finance.accounting.ui.equity"
              },
              {
                "value": "revenue",
                "label": "finance.accounting.ui.revenue"
              },
              {
                "value": "expense",
                "label": "finance.accounting.ui.expense"
              }
            ]
          },
          {
            "name": "parent_id",
            "label": "common.col.parent",
            "type": "relation",
            "relation": {
              "dataSource": "/ext/finance/accounting/accounts",
              "dataPath": "data",
              "valueKey": "id",
              "labelKey": [
                "code",
                "name"
              ]
            }
          }
        ]
      }
    },
    {
      "id": "fiscal",
      "label": "finance.accounting.tab.fiscal",
      "icon": "TrendingUp",
      "dataSource": "/ext/finance/accounting/fiscal-years",
      "dataPath": "data",
      "columns": [
        {
          "key": "year",
          "label": "common.col.year"
        },
        {
          "key": "start_date",
          "label": "common.col.start",
          "type": "date"
        },
        {
          "key": "end_date",
          "label": "common.col.end",
          "type": "date"
        },
        {
          "key": "is_closed",
          "label": "common.col.status",
          "type": "badge",
          "badge": {
            "colors": {
              "true": "badge-ghost",
              "false": "badge-success"
            },
            "labels": {
              "true": "finance.accounting.status.closed",
              "false": "finance.accounting.status.open"
            }
          }
        }
      ]
    },
    {
      "id": "trial-balance",
      "label": "accounting.tab.trialBalance",
      "icon": "TrendingUp",
      "dataSource": "/ext/finance/accounting/reports/trial-balance",
      "dataPath": "data",
      "columns": [
        {
          "key": "code",
          "label": "accounting.col.code"
        },
        {
          "key": "name",
          "label": "accounting.col.name"
        },
        {
          "key": "type",
          "label": "accounting.col.type"
        },
        {
          "key": "total_debit",
          "label": "accounting.col.debit",
          "format": "currency"
        },
        {
          "key": "total_credit",
          "label": "accounting.col.credit",
          "format": "currency"
        },
        {
          "key": "balance",
          "label": "accounting.col.balance",
          "format": "currency"
        }
      ]
    },
    {
      "id": "balance-sheet",
      "label": "accounting.tab.balanceSheet",
      "icon": "FolderOpen",
      "dataSource": "/ext/finance/accounting/reports/balance-sheet",
      "dataPath": "data",
      "columns": [
        {
          "key": "code",
          "label": "accounting.col.code"
        },
        {
          "key": "name",
          "label": "accounting.col.name"
        },
        {
          "key": "type",
          "label": "accounting.col.type"
        },
        {
          "key": "balance",
          "label": "accounting.col.balance",
          "format": "currency"
        }
      ]
    },
    {
      "id": "cost-centers",
      "label": "accounting.tab.costCenters",
      "icon": "Boxes",
      "dataSource": "/ext/finance/accounting/cost-centers",
      "dataPath": "data",
      "columns": [
        {
          "key": "code",
          "label": "accounting.col.code"
        },
        {
          "key": "name",
          "label": "accounting.col.name"
        },
        {
          "key": "is_active",
          "label": "accounting.col.active",
          "type": "badge",
          "badge": {
            "colors": {
              "true": "badge-success",
              "false": "badge-ghost"
            },
            "labels": {
              "true": "accounting.yes",
              "false": "accounting.no"
            }
          }
        }
      ],
      "form": {
        "endpoint": "/ext/finance/accounting/cost-centers",
        "fields": [
          {
            "name": "code",
            "label": "accounting.col.code",
            "required": true,
            "colSpan": 1
          },
          {
            "name": "name",
            "label": "accounting.col.name",
            "required": true,
            "colSpan": 1
          }
        ]
      }
    }
  ]
}
