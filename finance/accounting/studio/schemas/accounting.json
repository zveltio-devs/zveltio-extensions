{
  "spec": "zveltio.view/2",
  "title": "finance.accounting.title",
  "type": "tabs",
  "items": [
    {
      "type": "list",
      "collection": "journal_entries",
      "title": "finance.accounting.tab.entries",
      "fields": [
        {
          "field": "date",
          "label": "common.col.date"
        },
        {
          "field": "reference",
          "label": "common.col.docNumber",
          "display": "mono"
        },
        {
          "field": "description",
          "label": "common.col.description"
        },
        {
          "field": "status",
          "label": "common.col.status",
          "display": "badge",
          "tones": {
            "posted": "success",
            "draft": "muted",
            "voided": "danger"
          }
        }
      ],
      "sort": "-date",
      "rowActions": [
        {
          "action": "postEntry",
          "label": "finance.accounting.postEntry",
          "tone": "success",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "when": [
            {
              "field": "status",
              "op": "eq",
              "value": "draft"
            }
          ]
        },
        {
          "action": "voidEntry",
          "label": "finance.accounting.voidEntry",
          "tone": "warning",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "confirm": "finance.accounting.voidConfirm",
          "when": [
            {
              "field": "status",
              "op": "eq",
              "value": "posted"
            }
          ]
        },
        {
          "action": "deleteEntry",
          "label": "common.delete",
          "tone": "danger",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "confirm": "finance.accounting.deleteConfirm",
          "when": [
            {
              "field": "status",
              "op": "eq",
              "value": "draft"
            }
          ]
        }
      ]
    },
    {
      "type": "list",
      "collection": "accounts",
      "title": "finance.accounting.tab.accounts",
      "fields": [
        {
          "field": "code",
          "label": "common.col.code",
          "display": "mono"
        },
        {
          "field": "name",
          "label": "common.col.name"
        },
        {
          "field": "type",
          "label": "common.col.type",
          "display": "badge",
          "tones": {
            "asset": "info",
            "liability": "warning",
            "equity": "info",
            "revenue": "success",
            "expense": "danger"
          }
        },
        {
          "field": "is_active",
          "label": "accounting.col.active",
          "display": "badge",
          "tones": {
            "true": "success",
            "false": "muted"
          }
        }
      ],
      "sort": "code",
      "create": true
    },
    {
      "type": "list",
      "collection": "fiscal_years",
      "title": "finance.accounting.tab.fiscal",
      "fields": [
        {
          "field": "year",
          "label": "common.col.year"
        },
        {
          "field": "start_date",
          "label": "common.col.start"
        },
        {
          "field": "end_date",
          "label": "common.col.end"
        },
        {
          "field": "status",
          "label": "common.col.status",
          "display": "badge",
          "tones": {
            "open": "success",
            "closed": "muted"
          }
        }
      ],
      "sort": "-year",
      "rowActions": [
        {
          "action": "closeFiscalYear",
          "label": "finance.accounting.closeYear",
          "tone": "warning",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "confirm": "finance.accounting.closeConfirm",
          "when": [
            {
              "field": "status",
              "op": "eq",
              "value": "open"
            }
          ]
        }
      ],
      "create": true
    },
    {
      "type": "list",
      "collection": "cost_centers",
      "title": "accounting.tab.costCenters",
      "fields": [
        {
          "field": "code",
          "label": "accounting.col.code"
        },
        {
          "field": "name",
          "label": "accounting.col.name"
        },
        {
          "field": "is_active",
          "label": "accounting.col.active",
          "display": "badge",
          "tones": {
            "true": "success",
            "false": "muted"
          }
        }
      ],
      "sort": "code",
      "create": true
    }
  ]
}
