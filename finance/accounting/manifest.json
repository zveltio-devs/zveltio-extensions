        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "journal_entries",
        "journal_lines",
        "fiscal_years"
      ],
      "writes": [
        "journal_entries"
      ]
    },
