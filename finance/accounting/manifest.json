{
  "name": "finance/accounting",
  "displayName": "Accounting",
  "category": "finance",
  "description": "Double-entry bookkeeping: chart of accounts, journal entries, fiscal years, budgets, trial balance, P&L and balance sheet",
  "version": "2.1.0",
  "zveltioMinVersion": "3.0.0-beta.93",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-accounting",
  "permissions": [
    "data:write"
  ],
  "i18nPrefixes": [
    "accounting",
    "finance.accounting"
  ],
  "contributes": {
    "engine": true,
    "studio": true,
    "fieldTypes": []
  },
  "studio": {
    "navGroup": "finance",
    "pages": [
      {
        "path": "/admin/finance/accounting",
        "label": "Accounting",
        "icon": "Calculator",
        "schema": "schemas/accounting.json"
      }
    ]
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "collections": [
    "cost_centers",
    "accounts",
    "fiscal_years",
    "exchange_rates",
    "budgets",
    "journal_entries",
    "journal_lines",
    "recurring_journals",
    "recurring_journal_lines",
    "tax_reports"
  ],
  "actions": [
    {
      "name": "createEntry",
      "permission": {
        "resource": "journal_entries",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "date",
          "description",
          "lines"
        ],
        "additionalProperties": false,
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "reference": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "account_id"
              ],
              "additionalProperties": false,
              "properties": {
                "account_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "debit": {
                  "type": "number",
                  "minimum": 0
                },
                "credit": {
                  "type": "number",
                  "minimum": 0
                },
                "description": {
                  "type": "string"
                },
                "currency": {
                  "type": "string",
                  "minLength": 3,
                  "maxLength": 3
                },
                "exchange_rate": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "amount_foreign": {
                  "type": "number"
                },
                "cost_center_id": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      },
      "reads": [
        "fiscal_years"
      ],
      "writes": [
        "journal_entries",
        "journal_lines"
      ]
    },
    {
      "name": "postEntry",
      "permission": {
        "resource": "journal_entries",
        "action": "execute"
      },
      "input": {
        "type": "object",
