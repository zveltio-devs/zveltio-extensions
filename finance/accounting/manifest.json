            "enum": [
              "daily",
              "weekly",
              "monthly",
              "quarterly",
              "yearly"
            ]
          },
          "next_run_date": {
            "type": "string",
            "format": "date"
          },
          "end_date": {
            "type": "string",
            "format": "date"
          },
          "lines": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": [
                "account_id"
              ],
              "additionalProperties": false,
              "properties": {
                "account_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "debit": {
                  "type": "number",
                  "minimum": 0
                },
                "credit": {
                  "type": "number",
                  "minimum": 0
                },
