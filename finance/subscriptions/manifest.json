{
  "name": "finance/subscriptions",
  "displayName": "Subscriptions",
  "category": "finance",
  "description": "Recurring billing plans, subscribers, metered usage, invoices and dunning",
  "version": "2.1.0",
  "zveltioMinVersion": "3.0.0-beta.93",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-subscriptions",
  "permissions": [
    "data:write"
  ],
  "i18nPrefixes": [
    "finance.subscriptions"
  ],
  "contributes": {
    "engine": true,
    "studio": true,
    "fieldTypes": []
  },
  "studio": {
    "navGroup": "finance",
    "pages": [
      {
        "path": "/admin/finance/subscriptions",
        "label": "Subscriptions",
        "icon": "Repeat",
        "schema": "schemas/subscriptions.json"
      }
    ]
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "collections": [
    "subscription_plans",
    "subscribers",
    "subscription_invoices",
    "subscription_usage",
    "dunning_attempts",
    "plan_changes",
    "subscription_settlements"
  ],
  "actions": [
    {
      "name": "subscribe",
      "permission": {
        "resource": "subscribers",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "plan_id",
          "name",
          "email"
        ],
        "additionalProperties": false,
        "properties": {
          "plan_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "contact_id": {
            "type": "string"
          },
          "organization_id": {
            "type": "string"
          },
          "start_date": {
            "type": "string",
            "format": "date"
          },
          "metadata": {
            "type": "object"
          }
        }
      },
      "reads": [
        "subscription_plans"
      ],
      "writes": [
        "subscribers"
      ]
    },
    {
      "name": "changePlan",
      "permission": {
        "resource": "subscribers",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id",
          "plan_id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "plan_id": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "reads": [
        "subscribers",
        "subscription_plans",
        "subscription_invoices"
      ],
      "writes": [
        "subscribers",
        "plan_changes"
      ]
    },
    {
      "name": "cancel",
      "permission": {
        "resource": "subscription_settlements",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "at_period_end": {
            "type": "boolean"
          }
        }
      },
      "reads": [
        "subscribers"
      ],
      "writes": [
        "subscribers",
        "subscription_settlements"
      ]
    },
    {
      "name": "reactivate",
      "permission": {
        "resource": "subscribers",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "subscribers"
      ],
      "writes": [
        "subscribers"
      ]
    },
    {
      "name": "recordUsage",
      "permission": {
        "resource": "subscription_usage",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id",
          "metric_name",
          "quantity"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "metric_name": {
            "type": "string",
            "minLength": 1
          },
          "quantity": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "billing_period_start": {
            "type": "string",
            "format": "date"
          },
          "billing_period_end": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "reads": [
        "subscribers",
        "subscription_plans"
      ],
      "writes": [
        "subscription_usage"
      ]
    },
    {
      "name": "issueInvoice",
      "permission": {
        "resource": "subscription_invoices",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "subscribers",
        "subscription_plans",
        "subscription_usage",
        "plan_changes"
      ],
      "writes": [
        "subscribers",
        "subscription_invoices",
        "subscription_usage",
        "plan_changes"
      ]
    },
    {
      "name": "markInvoicePaid",
      "permission": {
        "resource": "subscription_settlements",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "subscription_invoices",
        "subscribers"
      ],
      "writes": [
        "subscription_invoices",
        "subscribers",
        "subscription_settlements"
      ]
    },
    {
      "name": "recordPaymentFailure",
      "permission": {
        "resource": "subscription_invoices",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "reads": [
        "subscription_invoices",
        "subscribers",
        "dunning_attempts"
      ],
      "writes": [
        "subscribers",
        "dunning_attempts"
      ]
    }
  ],
  "integrity": {
    "engineSha256": "8527c62e7b21f9f8f90ca724ab49034da8e3c2fcd6d75ba8eedb7013cad4699c",
    "sourceSha256": "0dc6e23cd7eb6279572726fbad78907d7a554808a94efbd04abf59095fbf4de0",
    "schemaSha256": "fef753faef2d06c4d58f12b765570d4f250424301190e2360a0371c282fae9e7"
  }
}
