{
  "spec": "zveltio.view/2",
  "title": "finance.subscriptions.title",
  "type": "tabs",
  "items": [
    {
      "type": "list",
      "collection": "subscribers",
      "title": "finance.subscriptions.tab.subscribers",
      "fields": [
        {
          "field": "name",
          "label": "finance.subscriptions.col.subscriber"
        },
        {
          "field": "current_period_start",
          "label": "finance.subscriptions.col.periodStart"
        },
        {
          "field": "current_period_end",
          "label": "finance.subscriptions.col.nextBill"
        },
        {
          "field": "status",
          "label": "common.col.status",
          "display": "badge",
          "tones": {
            "active": "success",
            "trialing": "info",
            "past_due": "warning",
            "cancelled": "danger",
            "open": "warning",
            "paid": "success"
          }
        },
        {
          "field": "cancel_at_period_end",
          "label": "finance.subscriptions.col.cancelling"
        }
      ],
      "sort": "-created_at",
      "edit": true,
      "rowActions": [
        {
          "action": "issueInvoice",
          "label": "finance.subscriptions.action.invoice",
          "input": {
            "id": {
              "$record": "id"
            }
          }
        },
        {
          "action": "changePlan",
          "label": "finance.subscriptions.action.changePlan",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "prompt": [
            "plan_id",
            "reason"
          ]
        },
        {
          "action": "recordUsage",
          "label": "finance.subscriptions.action.usage",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "prompt": [
            "metric_name",
            "quantity"
          ]
        },
        {
          "action": "cancel",
          "label": "finance.subscriptions.action.cancelAtPeriodEnd",
          "input": {
            "id": {
              "$record": "id"
            },
            "at_period_end": true
          },
          "when": [
            {
              "field": "cancel_at_period_end",
              "op": "eq",
              "value": false
            }
          ]
        },
        {
          "action": "cancel",
          "label": "finance.subscriptions.action.cancel",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "confirm": "finance.subscriptions.cancelConfirm"
        },
        {
          "action": "reactivate",
          "label": "finance.subscriptions.action.reactivate",
          "input": {
            "id": {
              "$record": "id"
            }
          }
        }
      ],
      "actions": [
        {
          "action": "subscribe",
          "tone": "info",
          "label": "finance.subscriptions.btn.newSubscriber",
          "prompt": [
            "name",
            "email",
            "plan_id",
            "start_date"
          ]
        }
      ]
    },
    {
      "type": "list",
      "collection": "subscription_plans",
      "title": "finance.subscriptions.tab.plans",
      "fields": [
        {
          "field": "name",
          "label": "common.col.name"
        },
        {
          "field": "interval",
          "label": "finance.subscriptions.ui.interval"
        },
        {
          "field": "price",
          "label": "common.col.price"
        },
        {
          "field": "trial_days",
          "label": "finance.subscriptions.ui.trial_days"
        },
        {
          "field": "is_active",
          "label": "common.col.active"
        }
      ],
      "sort": "price",
      "edit": true,
      "create": true
    },
    {
      "type": "list",
      "collection": "subscription_invoices",
      "title": "finance.subscriptions.tab.invoices",
      "fields": [
        {
          "field": "period_start",
          "label": "finance.subscriptions.col.periodStart"
        },
        {
          "field": "period_end",
          "label": "finance.subscriptions.col.periodEnd"
        },
        {
          "field": "total_amount",
          "label": "common.col.amount"
        },
        {
          "field": "due_date",
          "label": "finance.subscriptions.col.due"
        },
        {
          "field": "status",
          "label": "common.col.status",
          "display": "badge",
          "tones": {
            "active": "success",
            "trialing": "info",
            "past_due": "warning",
            "cancelled": "danger",
            "open": "warning",
            "paid": "success"
          }
        }
      ],
      "sort": "-created_at",
      "rowActions": [
        {
          "action": "markInvoicePaid",
          "label": "finance.subscriptions.action.pay",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "when": [
            {
              "field": "status",
              "op": "eq",
              "value": "open"
            }
          ]
        },
        {
          "action": "recordPaymentFailure",
          "label": "finance.subscriptions.action.fail",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "when": [
            {
              "field": "status",
              "op": "eq",
              "value": "open"
            }
          ]
        }
      ]
    }
  ]
}
