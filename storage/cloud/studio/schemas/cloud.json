{
  "sduiSchema": 1,
  "title": "storage.cloud.title",
  "subtitle": "storage.cloud.subtitle",
  "newLabel": "common.new",
  "resources": [
    {
      "id": "versions",
      "label": "storage.cloud.tab.versions",
      "icon": "History",
      "dataSource": "/api/data/cloud_file_versions?sort=created_at&order=desc&limit=100",
      "dataPath": "records",
      "columns": [
        {
          "key": "file_id",
          "label": "storage.cloud.col.fileId",
          "type": "mono"
        },
        {
          "key": "version",
          "label": "storage.cloud.col.version"
        },
        {
          "key": "version_file_id",
          "label": "storage.cloud.col.versionFileId",
          "type": "mono"
        },
        {
          "key": "note",
          "label": "storage.cloud.col.note"
        },
        {
          "key": "created_at",
          "label": "common.col.created",
          "type": "date"
        }
      ],
      "rowActions": [
        {
          "id": "restore",
          "icon": "RotateCcw",
          "label": "storage.cloud.restore",
          "method": "POST",
          "endpoint": "/ext/storage/cloud/actions/restoreVersion",
          "body": {
            "version_id": "{id}"
          },
          "confirm": "storage.cloud.confirmRestore"
        }
      ],
      "form": {
        "endpoint": "/ext/storage/cloud/files/{file_id}/versions",
        "submit": {
          "kind": "upload"
        },
        "fields": [
          {
            "name": "file_id",
            "label": "storage.cloud.col.fileId",
            "required": true,
            "mono": true,
            "colSpan": 2
          },
          {
            "name": "file",
            "label": "storage.cloud.col.file",
            "type": "file",
            "required": true,
            "colSpan": 2
          },
          {
            "name": "note",
            "label": "storage.cloud.col.note",
            "colSpan": 2
          }
        ]
      }
    },
    {
      "id": "favorites",
      "label": "storage.cloud.tab.favorites",
      "icon": "Star",
      "dataSource": "/api/data/cloud_favorites?sort=created_at&order=desc&limit=100",
      "dataPath": "records",
      "columns": [
        {
          "key": "file_id",
          "label": "storage.cloud.col.fileId",
          "type": "mono"
        },
        {
          "key": "created_at",
          "label": "common.col.created",
          "type": "date"
        }
      ],
      "rowActions": [
        {
          "id": "delete",
          "icon": "Trash2",
          "variant": "text-error",
          "label": "common.delete",
          "method": "DELETE",
          "endpoint": "/api/data/cloud_favorites/{id}",
          "confirm": "ext.confirmDelete"
        }
      ],
      "form": {
        "endpoint": "/api/data/cloud_favorites",
        "fields": [
          {
            "name": "file_id",
            "label": "storage.cloud.col.fileId",
            "required": true,
            "mono": true,
            "colSpan": 2
          }
        ]
      }
    },
    {
      "id": "retention",
      "label": "storage.cloud.tab.retention",
      "icon": "Clock",
      "dataSource": "/api/data/cloud_retention_policies?sort=name&order=asc&limit=500",
      "dataPath": "records",
      "columns": [
        {
          "key": "name",
          "label": "common.col.name"
        },
        {
          "key": "folder_path",
          "label": "storage.cloud.col.folderPath",
          "type": "mono"
        },
        {
          "key": "max_versions",
          "label": "storage.cloud.col.maxVersions"
        },
        {
          "key": "delete_after_days",
          "label": "storage.cloud.col.deleteAfterDays"
        },
        {
          "key": "is_active",
          "label": "storage.cloud.col.active",
          "type": "boolean"
        }
      ],
      "rowActions": [
        {
          "id": "edit",
          "kind": "edit",
          "label": "common.edit"
        },
        {
          "id": "delete",
          "icon": "Trash2",
          "variant": "text-error",
          "label": "common.delete",
          "method": "DELETE",
          "endpoint": "/api/data/cloud_retention_policies/{id}",
          "confirm": "storage.cloud.confirmDeletePolicy"
        }
      ],
      "form": {
        "endpoint": "/api/data/cloud_retention_policies",
        "fields": [
          {
            "name": "name",
            "label": "common.col.name",
            "required": true,
            "colSpan": 1
          },
          {
            "name": "folder_path",
            "label": "storage.cloud.col.folderPath",
            "mono": true,
            "colSpan": 1
          },
          {
            "name": "file_extension",
            "label": "storage.cloud.col.extension",
            "colSpan": 1
          },
          {
            "name": "max_versions",
            "label": "storage.cloud.col.maxVersions",
            "type": "number",
            "colSpan": 1,
            "default": 10
          },
          {
            "name": "delete_after_days",
            "label": "storage.cloud.col.deleteAfterDays",
            "type": "number",
            "colSpan": 1
          },
          {
            "name": "archive_after_days",
            "label": "storage.cloud.col.archiveAfterDays",
            "type": "number",
            "colSpan": 1
          },
          {
            "name": "is_active",
            "label": "storage.cloud.col.active",
            "type": "boolean",
            "default": true,
            "colSpan": 2
          }
        ]
      }
    }
  ]
}
