{
  "sduiSchema": 1,
  "title": "storage.cloud.title",
  "subtitle": "storage.cloud.subtitle",
  "newLabel": "common.new",
  "resources": [
    {
      "id": "files",
      "label": "storage.cloud.tab.files",
      "icon": "Folder",
      "dataSource": "/ext/storage/cloud/files",
      "dataPath": "data",
      "search": {
        "param": "path",
        "placeholder": "storage.cloud.root"
      },
      "columns": [
        {
          "key": "name",
          "label": "common.col.name"
        },
        {
          "key": "is_folder",
          "label": "storage.cloud.col.folder",
          "type": "boolean"
        },
        {
          "key": "size",
          "label": "storage.cloud.col.size"
        },
        {
          "key": "updated_at",
          "label": "storage.cloud.col.modified",
          "type": "date"
        }
      ],
      "rowActions": [
        {
          "id": "download",
          "kind": "download",
          "icon": "Download",
          "label": "common.download",
          "endpoint": "/ext/storage/cloud/files/{id}/download"
        },
        {
          "id": "delete",
          "icon": "Trash2",
          "variant": "text-error",
          "label": "common.delete",
          "method": "DELETE",
          "endpoint": "/ext/storage/cloud/files/{id}",
          "confirm": "storage.cloud.confirmDeleteFile"
        }
      ]
    },
    {
      "id": "shares",
      "label": "storage.cloud.tab.shares",
      "icon": "Share2",
      "dataSource": "/ext/storage/cloud/shares",
      "dataPath": "shares",
      "columns": [
        {
          "key": "id",
          "label": "common.col.number",
          "type": "mono"
        },
        {
          "key": "file_id",
          "label": "storage.cloud.col.fileId",
          "type": "mono"
        },
        {
          "key": "expires_at",
          "label": "storage.cloud.col.expires",
          "type": "date"
        },
        {
          "key": "created_at",
          "label": "common.col.created",
          "type": "date"
        }
      ],
      "rowActions": [
        {
          "id": "revoke",
          "icon": "Trash2",
          "variant": "text-error",
          "label": "common.delete",
          "method": "DELETE",
          "endpoint": "/ext/storage/cloud/shares/{id}",
          "confirm": "storage.cloud.confirmRevokeShare"
        }
      ]
    },
    {
      "id": "retention",
      "label": "storage.cloud.tab.retention",
      "icon": "Clock",
      "dataSource": "/ext/storage/cloud/retention-policies",
      "dataPath": "policies",
      "columns": [
        {
          "key": "name",
          "label": "common.col.name"
        },
        {
          "key": "folder_path",
          "label": "storage.cloud.col.folderPath",
          "type": "mono"
        },
        {
          "key": "max_versions",
          "label": "storage.cloud.col.maxVersions"
        },
        {
          "key": "delete_after_days",
          "label": "storage.cloud.col.deleteAfterDays"
        }
      ],
      "rowActions": [
        {
          "id": "delete",
          "icon": "Trash2",
          "variant": "text-error",
          "label": "common.delete",
          "method": "DELETE",
          "endpoint": "/ext/storage/cloud/retention-policies/{id}",
          "confirm": "storage.cloud.confirmDeletePolicy"
        }
      ],
      "form": {
        "endpoint": "/ext/storage/cloud/retention-policies",
        "fields": [
          {
            "name": "name",
            "label": "common.col.name",
            "required": true,
            "colSpan": 1
          },
          {
            "name": "folder_path",
            "label": "storage.cloud.col.folderPath",
            "mono": true,
            "colSpan": 1
          },
          {
            "name": "file_extension",
            "label": "storage.cloud.col.extension",
            "colSpan": 1
          },
          {
            "name": "max_versions",
            "label": "storage.cloud.col.maxVersions",
            "type": "number",
            "colSpan": 1,
            "default": 10
          },
          {
            "name": "delete_after_days",
            "label": "storage.cloud.col.deleteAfterDays",
            "type": "number",
            "colSpan": 2
          }
        ]
      }
    },
    {
      "id": "quotas",
      "label": "storage.cloud.tab.quotas",
      "icon": "Gauge",
      "dataSource": "/ext/storage/cloud/admin/quotas",
      "dataPath": "quotas",
      "columns": [
        {
          "key": "role_name",
          "label": "common.col.role"
        },
        {
          "key": "user_id",
          "label": "common.col.user",
          "type": "mono"
        },
        {
          "key": "quota_bytes",
          "label": "storage.cloud.col.quotaBytes"
        },
        {
          "key": "max_file_size_bytes",
          "label": "storage.cloud.col.maxFileSize"
        }
      ],
      "rowActions": [
        {
          "id": "delete",
          "icon": "Trash2",
          "variant": "text-error",
          "label": "common.delete",
          "method": "DELETE",
          "endpoint": "/ext/storage/cloud/admin/quotas/{id}",
          "confirm": "storage.cloud.confirmDeleteQuota"
        }
      ],
      "form": {
        "endpoint": "/ext/storage/cloud/admin/quotas",
        "fields": [
          {
            "name": "role_name",
            "label": "common.col.role",
            "colSpan": 1
          },
          {
            "name": "user_id",
            "label": "common.col.user",
            "mono": true,
            "colSpan": 1
          },
          {
            "name": "quota_bytes",
            "label": "storage.cloud.col.quotaBytes",
            "type": "number",
            "required": true,
            "colSpan": 1
          },
          {
            "name": "max_file_size_bytes",
            "label": "storage.cloud.col.maxFileSize",
            "type": "number",
            "colSpan": 1,
            "default": 104857600
          },
          {
            "name": "allowed_extensions",
            "label": "storage.cloud.col.allowedExtensions",
            "type": "json",
            "mono": true,
            "rows": 2,
            "colSpan": 2,
            "default": "[]"
          }
        ]
      }
    }
  ]
}
