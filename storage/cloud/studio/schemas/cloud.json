{
  "spec": "zveltio.view/2",
  "title": "storage.cloud.title",
  "type": "tabs",
  "items": [
    {
      "type": "list",
      "collection": "cloud_file_versions",
      "title": "storage.cloud.tab.versions",
      "fields": [
        { "field": "file_id", "label": "storage.cloud.col.fileId", "display": "mono" },
        { "field": "version", "label": "storage.cloud.col.version" },
        { "field": "version_file_id", "label": "storage.cloud.col.versionFileId", "display": "mono" },
        { "field": "note", "label": "storage.cloud.col.note" },
        { "field": "created_at", "label": "common.col.created" }
      ],
      "sort": "-created_at",
      "actions": [
        {
          "action": "addFileVersion",
          "label": "storage.cloud.newVersion",
          "prompt": ["file_id", "note"],
          "files": { "prompt": { "input": "file", "label": "storage.cloud.col.file" } }
        }
      ],
      "rowActions": [
        {
          "action": "restoreVersion",
          "label": "storage.cloud.restore",
          "input": { "version_id": { "$record": "id" } },
          "confirm": "storage.cloud.confirmRestore"
        }
      ]
    },
    {
      "type": "list",
      "collection": "cloud_favorites",
      "title": "storage.cloud.tab.favorites",
      "fields": [
        { "field": "file_id", "label": "storage.cloud.col.fileId", "display": "mono" },
        { "field": "created_at", "label": "common.col.created" }
      ],
      "sort": "-created_at",
      "create": true,
      "delete": true
    },
    {
      "type": "list",
      "collection": "cloud_retention_policies",
      "title": "storage.cloud.tab.retention",
      "fields": [
        { "field": "name", "label": "common.col.name" },
        { "field": "folder_path", "label": "storage.cloud.col.folderPath", "display": "mono" },
        { "field": "max_versions", "label": "storage.cloud.col.maxVersions" },
        { "field": "delete_after_days", "label": "storage.cloud.col.deleteAfterDays" },
        { "field": "is_active", "label": "storage.cloud.col.active" }
      ],
      "sort": "name",
      "create": true,
      "edit": true,
      "delete": true
    }
  ]
}
