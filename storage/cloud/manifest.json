{
  "name": "storage/cloud",
  "displayName": "Cloud Storage",
  "category": "storage",
  "description": "File versioning, trash bin, public share links, and storage quotas",
  "version": "1.1.4",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-cloud",
  "permissions": [
    "database",
    "files",
    "introspection",
    "storage"
  ],
  "i18nPrefixes": [
    "storage"
  ],
  "publicRoutes": [
    "/share/*"
  ],
  "peerDependencies": {
    "nanoid": "^5.0.0"
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/storage/cloud",
        "label": "Cloud Storage",
        "icon": "Cloud",
        "schema": "schemas/cloud.json"
      }
    ],
    "navGroup": "other"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "studioComponents": [
      "AttachmentManager",
      "FilePicker"
    ],
    "client": true,
    "clientComponents": [
      "FileUpload"
    ],
    "fieldTypes": []
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": true
  },
  "integrity": {
    "engineSha256": "97997e65cb16fe70ebc60336adf7822a00d6c7512ccd8a1d9d2d4cf85e4883c6",
    "sourceSha256": "771e8a6fec3d3d270e9a1805801f3d80673507a28c73b86761af043adc6d284a"
  },
  "globalRoutes": [
    "/share/:token"
  ]
}
