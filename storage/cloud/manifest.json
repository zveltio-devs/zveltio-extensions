{
  "name": "storage/cloud",
  "displayName": "Cloud Storage",
  "category": "storage",
  "description": "File versioning, trash bin, public share links, and storage quotas",
  "version": "1.1.8",
  "zveltioMinVersion": "3.0.0-beta.77",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-cloud",
  "permissions": [
    "database",
    "files",
    "introspection",
    "storage"
  ],
  "i18nPrefixes": [
    "storage"
  ],
  "publicRoutes": [
    "/share/*"
  ],
  "peerDependencies": {
    "nanoid": "^5.0.0"
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/storage/cloud",
        "label": "Cloud Storage",
        "icon": "Cloud",
        "schema": "schemas/cloud.json"
      }
    ],
    "navGroup": "other"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "studioComponents": [
      "AttachmentManager",
      "FilePicker"
    ],
    "client": true,
    "clientComponents": [
      "FileUpload"
    ],
    "fieldTypes": []
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": true,
    "isolation": "worker"
  },
  "integrity": {
    "engineSha256": "f8b0f13f86179792133c45224b1161cc681f8062b00fd509f482d3a314e92b5f",
    "sourceSha256": "0734761482985432e5a2d6e2b64b5f14e50b7cb2b02195070da47b65278f5b9e"
  },
  "globalRoutes": [
    "/share/:token"
  ]
}
