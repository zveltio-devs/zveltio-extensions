{
  "name": "storage/cloud",
  "displayName": "Cloud Storage",
  "category": "storage",
  "description": "File versioning, trash bin, public share links, and storage quotas",
  "version": "1.1.5",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-cloud",
  "permissions": [
    "database",
    "files",
    "introspection",
    "storage"
  ],
  "i18nPrefixes": [
    "storage"
  ],
  "publicRoutes": [
    "/share/*"
  ],
  "peerDependencies": {
    "nanoid": "^5.0.0"
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/storage/cloud",
        "label": "Cloud Storage",
        "icon": "Cloud",
        "schema": "schemas/cloud.json"
      }
    ],
    "navGroup": "other"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "studioComponents": [
      "AttachmentManager",
      "FilePicker"
    ],
    "client": true,
    "clientComponents": [
      "FileUpload"
    ],
    "fieldTypes": []
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": true
  },
  "integrity": {
    "engineSha256": "e8eaad87b4b1c59d5e9c39bfc17bdebac62907b511dac9612756522801a84a07",
    "sourceSha256": "a1e8dca15403a49a527234d571ccd912fdb4d4899dda91f0013a893657911b9c"
  },
  "globalRoutes": [
    "/share/:token"
  ]
}
