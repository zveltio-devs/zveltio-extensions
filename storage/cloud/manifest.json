{
  "name": "storage/cloud",
  "displayName": "Cloud Storage",
  "category": "storage",
  "description": "Version history, favorites and retention policies over the engine's stored files",
  "version": "3.0.0",
  "zveltioMinVersion": "3.0.0-beta.129",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-cloud",
  "permissions": [
    "data:write",
    "files"
  ],
  "collections": [
    "cloud_file_versions",
    "cloud_favorites",
    "cloud_retention_policies"
  ],
  "i18nPrefixes": [
    "storage"
  ],
  "studio": {
    "pages": [
      {
        "path": "/admin/storage/cloud",
        "label": "Cloud Storage",
        "icon": "Cloud",
        "schema": "schemas/cloud.json"
      },
      {
        "path": "/admin/storage/cloud/drive",
        "label": "Drive",
        "icon": "HardDrive"
      }
    ],
    "navGroup": "other"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "studioComponents": [
      "AttachmentManager",
      "FilePicker"
    ],
    "client": true,
    "clientComponents": [
      "FileUpload"
    ],
    "fieldTypes": []
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": true
  },
  "actions": [
    {
      "name": "restoreVersion",
      "permission": {
        "resource": "cloud_file_versions",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "version_id"
        ],
        "additionalProperties": false,
        "properties": {
          "version_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "cloud_file_versions"
      ],
      "writes": [
        "cloud_file_versions"
      ]
    },
    {
      "name": "addFileVersion",
      "permission": {
        "resource": "cloud_file_versions",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "file_id",
          "file"
        ],
        "additionalProperties": false,
        "properties": {
          "file_id": {
            "type": "string",
            "format": "uuid"
          },
          "file": {
            "type": "string",
            "format": "uuid"
          },
          "note": {
            "type": "string",
            "maxLength": 1000
          }
        }
      },
      "reads": [
        "cloud_file_versions"
      ],
      "writes": [
        "cloud_file_versions"
      ]
    }
  ],
  "integrity": {
    "engineSha256": "379d57c3606d90be2cfe5cfdd837e09bcb0416da190881a7fb84668a70cd344a",
    "sourceSha256": "6cf4b1939432cc5fc127c24231bd4908107e32b9f39856275f545f94acf4afa4",
    "schemaSha256": "86cdfc2ba774fd5bfd52d3769b63734c4d8b5cbb9abf320d966815e43ce011f9"
  }
}
