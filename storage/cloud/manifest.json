{
  "name": "storage/cloud",
  "displayName": "Cloud Storage",
  "category": "storage",
  "description": "File versioning, trash bin, public share links, and storage quotas",
  "version": "1.0.0",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-cloud",
  "permissions": [
    "database",
    "files",
    "introspection",
    "storage"
  ],
  "publicRoutes": [
    "/share/*"
  ],
  "peerDependencies": {
    "nanoid": "^5.0.0"
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/storage/cloud",
        "label": "Cloud Storage",
        "icon": "Cloud"
      }
    ],
    "navGroup": "other"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "studioComponents": [
      "AttachmentManager",
      "FilePicker"
    ],
    "client": true,
    "clientComponents": [
      "FileUpload"
    ],
    "fieldTypes": []
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": true
  },
  "integrity": {
    "engineSha256": "71ae41fbc1035f3f2142f502978d9c33a16ddc4ec59d2f9a6ff759c535e3f3da",
    "sourceSha256": "dbfc56171474683aeca0324cc9e29aaea811c5dfcd307e2d29e7bd6eae5c4206"
  },
  "globalRoutes": [
    "/share/:token"
  ]
}
