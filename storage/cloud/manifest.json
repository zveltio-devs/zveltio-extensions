{
  "name": "storage/cloud",
  "displayName": "Cloud Storage",
  "category": "storage",
  "description": "File versioning, trash bin, public share links, and storage quotas",
  "version": "1.0.1",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-cloud",
  "permissions": [
    "database",
    "files",
    "introspection",
    "storage"
  ],
  "publicRoutes": [
    "/share/*"
  ],
  "peerDependencies": {
    "nanoid": "^5.0.0"
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/storage/cloud",
        "label": "Cloud Storage",
        "icon": "Cloud"
      }
    ],
    "navGroup": "other"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "studioComponents": [
      "AttachmentManager",
      "FilePicker"
    ],
    "client": true,
    "clientComponents": [
      "FileUpload"
    ],
    "fieldTypes": []
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": true
  },
  "integrity": {
    "engineSha256": "bfd94a907180197abe7a256be63a6f5ad6999970fcc401b02bcd2ac2d4b68e09",
    "sourceSha256": "1ff385f054e5be889f8a3b70c2f22607888fe22709d099d4b8fac6a43630f9e1"
  },
  "globalRoutes": [
    "/share/:token"
  ]
}
