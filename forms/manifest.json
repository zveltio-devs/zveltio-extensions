{
  "name": "forms",
  "displayName": "Form Builder",
  "category": "forms",
  "description": "Drag-and-drop form builder with public submission endpoints",
  "version": "1.0.0",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-forms",
  "permissions": [
    "database"
  ],
  "publicRoutes": [
    "/public/*"
  ],
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/forms",
        "component": "./studio/src/pages/FormsPage.svelte",
        "label": "Forms",
        "icon": "file-text"
      },
      {
        "path": "/admin/forms/:id",
        "component": "./studio/src/pages/FormBuilderPage.svelte",
        "label": "Form Builder",
        "icon": "edit"
      },
      {
        "path": "/admin/forms/:id/responses",
        "component": "./studio/src/pages/FormResponsesPage.svelte",
        "label": "Form Responses",
        "icon": "inbox"
      }
    ],
    "navGroup": "content"
  },
  "contributes": {
    "engine": true,
    "studio": false,
    "fieldTypes": []
  },
  "integrity": {
    "engineSha256": "bb5502d84d27c4c34de172186fd2a57a74771dbe66515387dfa6aa11b8c2d5a9",
    "sourceSha256": "7f23c53296d2265fb9e47b8baf91f2c41b8cae67e8b73e6e342f8bf05a5edbf0"
  }
}
