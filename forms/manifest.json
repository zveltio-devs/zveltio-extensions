{
  "name": "forms",
  "displayName": "Form Builder",
  "category": "forms",
  "description": "Drag-and-drop form builder with public submission endpoints",
  "version": "1.0.12",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-forms",
  "permissions": [
    "database"
  ],
  "i18nPrefixes": [
    "forms"
  ],
  "publicRoutes": [
    "/public/*"
  ],
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/forms",
        "label": "Forms",
        "icon": "file-text",
        "schema": "schemas/forms.json"
      },
      {
        "path": "/admin/forms/:id",
        "label": "Form builder",
        "icon": "file-text",
        "schema": "schemas/form-builder.json"
      }
    ],
    "navGroup": "content"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "fieldTypes": []
  },
  "integrity": {
    "engineSha256": "d74c548d0b7ae694428a4a64115c4b8b644cde8ee26c3e3995e6fd48abd3dfcf",
    "sourceSha256": "c22a62009a158b6beb641c0430a4a766fe7f2e5b55d2f52e5dd7839141469548"
  }
}
