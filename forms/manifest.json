{
  "name": "forms",
  "displayName": "Form Builder",
  "category": "forms",
  "description": "Forms, checklists and inspections: public one-shot forms and responses attached to records, filled field by field, with completion, scoring and recurrence",
  "version": "3.0.0",
  "zveltioMinVersion": "3.0.0-beta.93",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-forms",
  "permissions": [
    "data:write"
  ],
  "i18nPrefixes": [
    "forms"
  ],
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/forms",
        "label": "Forms",
        "icon": "file-text",
        "schema": "schemas/forms.json"
      },
      {
        "path": "/admin/forms/:id",
        "label": "Form builder",
        "icon": "file-text",
        "schema": "schemas/form-builder.json"
      }
    ],
    "navGroup": "content"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "fieldTypes": []
  },
  "collections": [
    "forms",
    "form_submissions",
    "form_answers",
    "form_recurrences"
  ],
  "actions": [
    {
      "name": "submit",
      "permission": {
        "resource": "form_submissions",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "slug",
          "data"
        ],
        "additionalProperties": false,
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1
          },
          "data": {
            "type": "object",
            "maxProperties": 200
          }
        }
      },
      "reads": [
        "forms"
      ],
      "writes": [
        "form_submissions",
        "form_answers"
      ]
    },
    {
      "name": "attach",
      "permission": {
        "resource": "form_answers",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "form_id",
          "collection",
          "record_id"
        ],
        "additionalProperties": false,
        "properties": {
          "form_id": {
            "type": "string",
            "format": "uuid"
          },
          "collection": {
            "type": "string",
            "minLength": 1
          },
          "record_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "reads": [
        "forms",
        "form_answers"
      ],
      "writes": [
        "form_submissions",
        "form_answers"
      ]
    },
    {
      "name": "answer",
      "permission": {
        "resource": "form_answers",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "submission_id",
          "answers"
        ],
        "additionalProperties": false,
        "properties": {
          "submission_id": {
            "type": "string",
            "format": "uuid"
          },
          "answers": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 200
          }
        }
      },
      "reads": [
        "forms",
        "form_submissions",
        "form_answers"
      ],
      "writes": [
        "form_submissions",
        "form_answers"
      ]
    },
    {
      "name": "updateAnswer",
      "permission": {
        "resource": "form_answers",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "value": {},
          "time_spent_minutes": {
            "type": "integer",
            "minimum": 0
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "assignee_user_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "due_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "reads": [
        "forms",
        "form_submissions",
        "form_answers"
      ],
      "writes": [
        "form_submissions",
        "form_answers"
      ]
    },
    {
      "name": "deleteSubmission",
      "permission": {
        "resource": "forms",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "form_submissions"
      ],
      "writes": [
        "form_submissions"
      ]
    },
    {
      "name": "runDueRecurrences",
      "permission": {
        "resource": "form_recurrences",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [],
        "additionalProperties": false,
        "properties": {}
      },
      "reads": [
        "form_recurrences",
        "forms",
        "form_answers"
      ],
      "writes": [
        "form_recurrences",
        "form_submissions",
        "form_answers"
      ]
    }
  ],
  "integrity": {
    "engineSha256": "5fd1aae233cb2f0ec7f83e2d58f09dfaa3a19afefad1844e76ca930a0899dda1",
    "sourceSha256": "6bd95da65b36a9efe8d434320dcc24f5648ce0aca6afba53b0382036cd6286fa",
    "schemaSha256": "e3b2a7d8f72cbcdd2f017e306257ce70935158e7ed37445e44be27ac69631c1d"
  }
}
