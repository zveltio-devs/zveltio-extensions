{
  "name": "forms",
  "displayName": "Form Builder",
  "category": "forms",
  "description": "Drag-and-drop form builder with public submission endpoints",
  "version": "1.0.0",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-forms",
  "permissions": [
    "database"
  ],
  "publicRoutes": [
    "/public/*"
  ],
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/forms",
        "component": "./studio/src/pages/FormsPage.svelte",
        "label": "Forms",
        "icon": "file-text"
      },
      {
        "path": "/admin/forms/:id",
        "component": "./studio/src/pages/FormBuilderPage.svelte",
        "label": "Form Builder",
        "icon": "edit"
      },
      {
        "path": "/admin/forms/:id/responses",
        "component": "./studio/src/pages/FormResponsesPage.svelte",
        "label": "Form Responses",
        "icon": "inbox"
      }
    ],
    "navGroup": "content"
  },
  "contributes": {
    "engine": true,
    "studio": false,
    "fieldTypes": []
  },
  "integrity": {
    "engineSha256": "1f72aa9b4ccb0a31bc8d008680197337e90ddf8132a87bbb37ebe05cfe5cb327",
    "sourceSha256": "8a5e3337c9e0421659b8d2e726fa6404541de09e8ac7daa0fdf61e949971e706"
  }
}
