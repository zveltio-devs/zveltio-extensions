{
  "name": "forms",
  "displayName": "Form Builder",
  "category": "forms",
  "description": "Drag-and-drop form builder with public submission endpoints",
  "version": "1.0.5",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-forms",
  "permissions": [
    "database"
  ],
  "publicRoutes": [
    "/public/*"
  ],
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/forms",
        "label": "Forms",
        "icon": "file-text",
        "schema": "schemas/forms.json"
      },
      {
        "path": "/admin/forms/:id",
        "label": "Form builder",
        "icon": "file-text",
        "schema": "schemas/form-builder.json"
      }
    ],
    "navGroup": "content"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "fieldTypes": []
  },
  "integrity": {
    "engineSha256": "a70c75046ac4febbbd9682d70ec44ab69d940120f3df10d3a906dad7c0915607",
    "sourceSha256": "07278736c462c8dd0a0c0688f5b1412b05b994d04abfd55ba7f89a7bebdbeb9b"
  }
}
