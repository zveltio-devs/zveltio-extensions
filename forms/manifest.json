{
  "name": "forms",
  "displayName": "Form Builder",
  "category": "forms",
  "description": "Drag-and-drop form builder with public submission endpoints",
  "version": "1.0.7",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-forms",
  "permissions": [
    "database"
  ],
  "i18nPrefixes": [
    "forms"
  ],
  "publicRoutes": [
    "/public/*"
  ],
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/forms",
        "label": "Forms",
        "icon": "file-text",
        "schema": "schemas/forms.json"
      },
      {
        "path": "/admin/forms/:id",
        "label": "Form builder",
        "icon": "file-text",
        "schema": "schemas/form-builder.json"
      }
    ],
    "navGroup": "content"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "fieldTypes": []
  },
  "integrity": {
    "engineSha256": "21f9277f1abaf549112fe3518504de017ec4698ddc9513e65633805ae066f178",
    "sourceSha256": "fe2902b4ab096dacdb0a2dc7840e3f7c489ae136104d75263cf8c3e1de531d8e"
  }
}
