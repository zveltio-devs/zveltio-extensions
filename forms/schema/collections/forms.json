{
  "name": "forms",
  "fields": [
    {
      "name": "name",
      "type": "text",
      "required": true
    },
    {
      "name": "slug",
      "type": "text",
      "required": true,
      "unique": true
    },
    {
      "name": "description",
      "type": "textarea"
    },
    {
      "name": "fields",
      "type": "json",
      "required": true,
      "defaultValue": []
    },
    {
      "name": "active",
      "type": "boolean",
      "required": true,
      "defaultValue": true
    }
  ],
  "validation": [
    {
      "field": "slug",
      "rule": "pattern",
      "config": {
        "pattern": "^[a-z0-9-]+$"
      },
      "message": "A slug is lowercase letters, digits and hyphens."
    }
  ]
}
