{
  "spec": "zveltio.view/2",
  "title": "projects.helpdesk.title",
  "type": "list",
  "collection": "tickets",
  "fields": [
    {
      "field": "number",
      "label": "common.col.number",
      "display": "mono"
    },
    {
      "field": "title",
      "label": "common.col.title"
    },
    {
      "field": "requester_email",
      "label": "common.col.email"
    },
    {
      "field": "category_id",
      "label": "projects.helpdesk.col.category"
    },
    {
      "field": "priority",
      "label": "projects.helpdesk.ui.priority",
      "display": "badge",
      "tones": {
        "low": "muted",
        "medium": "info",
        "high": "warning",
        "critical": "danger"
      }
    },
    {
      "field": "status",
      "label": "common.col.status",
      "display": "badge",
      "tones": {
        "open": "info",
        "in_progress": "warning",
        "pending_customer": "muted",
        "resolved": "success",
        "closed": "muted"
      }
    },
    {
      "field": "created_at",
      "label": "common.col.created"
    }
  ],
  "sort": "-created_at",
  "search": true,
  "rowActions": [
    {
      "action": "resolve",
      "label": "projects.helpdesk.btn.resolve",
      "tone": "success",
      "input": {
        "id": {
          "$record": "id"
        }
      },
      "when": [
        {
          "field": "status",
          "op": "in",
          "value": [
            "open",
            "in_progress",
            "pending_customer"
          ]
        }
      ]
    },
    {
      "action": "reply",
      "label": "common.send",
      "input": {
        "id": {
          "$record": "id"
        }
      },
      "prompt": [
        "content"
      ],
      "when": [
        {
          "field": "status",
          "op": "in",
          "value": [
            "open",
            "in_progress",
            "pending_customer"
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "action": "open",
      "tone": "info",
      "label": "projects.helpdesk.btn.new",
      "prompt": [
        "title",
        "requester_email",
        "category_id",
        "priority",
        "description"
      ]
    }
  ]
}
