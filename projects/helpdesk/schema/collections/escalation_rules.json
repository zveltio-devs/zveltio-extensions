{
  "name": "escalation_rules",
  "fields": [
    { "name": "name", "type": "text", "required": true },
    { "name": "priority", "type": "enum", "options": { "values": ["low", "medium", "high", "critical"] } },
    { "name": "category_id", "type": "m2o", "options": { "related_collection": "ticket_categories" } },
    { "name": "condition_hours", "type": "integer", "required": true, "defaultValue": 4 },
    {
      "name": "condition_type",
      "type": "enum",
      "required": true,
      "defaultValue": "no_response",
      "options": { "values": ["no_response", "no_resolution", "sla_breach"] }
    },
    { "name": "action_assign_to", "type": "text" },
    { "name": "action_priority", "type": "enum", "options": { "values": ["low", "medium", "high", "critical"] } },
    { "name": "action_notify_email", "type": "email" },
    { "name": "is_active", "type": "boolean", "required": true, "defaultValue": true }
