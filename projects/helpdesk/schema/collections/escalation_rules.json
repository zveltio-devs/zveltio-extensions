  "relations": [{ "name": "escalation_rules_category_id", "type": "m2o", "field": "category_id", "target": "ticket_categories", "targetField": "id", "onDelete": "SET NULL", "onUpdate": "CASCADE", "metadata": {} }],
  "validation": [
    { "field": "condition_hours", "rule": "min", "config": { "value": 1 }, "message": "A rule waits at least one hour." }
  ]
