{
  "name": "hr/time-tracking",
  "displayName": "Time Tracking",
  "category": "hr",
  "description": "Timesheets, project-based time logging and billable hours",
  "version": "2.1.0",
  "zveltioMinVersion": "3.0.0-beta.92",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-time-tracking",
  "permissions": [
    "data:write"
  ],
  "i18nPrefixes": [
    "hr.time-tracking",
    "hr.timeTracking"
  ],
  "dependencies": [
    {
      "name": "hr/employees",
      "minVersion": "2.0.0"
    }
  ],
  "studio": {
    "pages": [
      {
        "path": "/admin/hr/time-tracking",
        "label": "Time Tracking",
        "icon": "Clock",
        "schema": "schemas/time-tracking.json"
      }
    ],
    "navGroup": "hr"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "fieldTypes": []
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "integrity": {
    "engineSha256": "ba319f48695df1cad1b8ab9e5f28fcb5c3ebfcd1ae6cf6f62a4cb3050de32c29",
    "sourceSha256": "6f8170603434dab983fd2b4b503dce987ca3f94ffa63bc417c57cd96b846c761",
    "schemaSha256": "9939f71ca744e78fb13d7f3c9faac95dad41a9d1164d57a9c8fbbafc0b59d2e3"
  },
  "collections": [
    "time_projects",
    "time_entries",
    "timesheets",
    "active_timers"
  ],
  "actions": [
    {
      "name": "logTime",
      "permission": {
        "resource": "time_entries",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "employee_id",
          "project_id",
          "date",
          "duration_minutes"
        ],
        "additionalProperties": false,
        "properties": {
          "employee_id": {
            "type": "string",
            "format": "uuid"
          },
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "format": "date"
          },
          "duration_minutes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1440
          },
          "task_description": {
            "type": "string",
            "maxLength": 2000
          },
          "is_billable": {
            "type": "boolean"
          },
          "notes": {
            "type": "string",
            "maxLength": 5000
          },
          "start_time": {
            "type": "string",
            "format": "date-time"
          },
          "end_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "reads": [
        "time_projects",
        "time_entries"
      ],
      "writes": [
        "time_entries"
      ]
    },
    {
      "name": "startTimer",
      "permission": {
        "resource": "active_timers",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "employee_id",
          "project_id"
        ],
        "additionalProperties": false,
        "properties": {
          "employee_id": {
            "type": "string",
            "format": "uuid"
          },
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "task_description": {
            "type": "string",
            "maxLength": 2000
          },
          "is_billable": {
            "type": "boolean"
          },
          "notes": {
            "type": "string",
            "maxLength": 5000
          }
        }
      },
      "reads": [
        "time_projects",
        "active_timers"
      ],
      "writes": [
        "active_timers"
      ]
    },
    {
      "name": "stopTimer",
      "permission": {
        "resource": "active_timers",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "employee_id"
        ],
        "additionalProperties": false,
        "properties": {
          "employee_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "time_projects",
        "active_timers",
        "time_entries"
      ],
      "writes": [
        "active_timers",
        "time_entries"
      ]
    },
    {
      "name": "computeTimesheet",
      "permission": {
        "resource": "timesheets",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "employee_id",
          "week_start"
        ],
        "additionalProperties": false,
        "properties": {
          "employee_id": {
            "type": "string",
            "format": "uuid"
          },
          "week_start": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "reads": [
        "time_entries",
        "timesheets"
      ],
      "writes": [
        "timesheets"
      ]
    },
    {
      "name": "invoiceEntries",
      "permission": {
        "resource": "time_entries",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "project_id",
          "entry_ids"
        ],
        "additionalProperties": false,
        "properties": {
          "project_id": {
            "type": "string",
            "format": "uuid"
          },
          "entry_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 500,
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "invoice_date": {
            "type": "string",
            "format": "date"
          },
          "due_days": {
            "type": "integer",
            "minimum": 0
          },
          "client_name": {
            "type": "string"
          },
          "client_tax_id": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "series": {
            "type": "string"
          },
          "exchange_rate": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "reads": [
        "time_projects",
        "time_entries",
        "invoices",
        "invoice_lines",
        "document_series",
        "company_profile"
      ],
      "writes": [
        "time_entries",
        "invoices",
        "invoice_lines",
        "document_series"
      ]
    }
  ],
  "optionalDependencies": [
    {
      "name": "finance/invoicing",
      "minVersion": "2.0.0"
    }
  ]
}
