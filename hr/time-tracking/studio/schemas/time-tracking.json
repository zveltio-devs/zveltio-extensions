{
  "spec": "zveltio.view/2",
  "title": "hr.time-tracking.title",
  "type": "tabs",
  "items": [
    {
      "type": "list",
      "collection": "time_projects",
      "title": "hr.time-tracking.tab.projects",
      "fields": [
        {
          "field": "name",
          "label": "common.col.name"
        },
        {
          "field": "client_name",
          "label": "hr.time-tracking.col.client"
        },
        {
          "field": "hourly_rate",
          "label": "hr.time-tracking.col.rate"
        },
        {
          "field": "currency",
          "label": "common.col.currency"
        },
        {
          "field": "is_billable",
          "label": "hr.time-tracking.col.billable"
        },
        {
          "field": "status",
          "label": "common.col.status",
          "display": "badge",
          "tones": {
            "active": "success",
            "archived": "muted"
          }
        }
      ],
      "sort": "name",
      "rowActions": [
        {
          "action": "startTimer",
          "label": "hr.time-tracking.btn.startTimer",
          "input": {
            "project_id": {
              "$record": "id"
            }
          },
          "prompt": [
            "employee_id",
            "task_description"
          ],
          "when": [
            {
              "field": "status",
              "op": "eq",
              "value": "active"
            }
          ]
        },
        {
          "action": "stopTimer",
          "label": "hr.time-tracking.btn.stopTimer",
          "prompt": [
            "employee_id"
          ]
        }
      ],
      "create": true
    },
    {
      "type": "list",
      "collection": "time_entries",
      "title": "hr.time-tracking.tab.entries",
      "fields": [
        {
          "field": "project_id",
          "label": "common.col.project"
        },
        {
          "field": "task_description",
          "label": "hr.time-tracking.ui.description"
        },
        {
          "field": "date",
          "label": "common.col.date"
        },
        {
          "field": "duration_minutes",
          "label": "hr.time-tracking.col.hours"
        },
        {
          "field": "is_billable",
          "label": "hr.time-tracking.col.billable"
        }
      ],
      "sort": "-date",
      "delete": true,
      "actions": [
        {
          "action": "logTime",
          "tone": "info",
          "label": "hr.time-tracking.ui.newProjectBtn",
          "prompt": [
            "employee_id",
            "project_id",
            "date",
            "duration_minutes",
            "is_billable",
            "task_description"
          ]
        }
      ]
    }
  ]
}
