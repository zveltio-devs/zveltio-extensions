{
  "sduiSchema": 1,
  "title": "hr.payroll.title",
  "subtitle": "hr.payroll.subtitle",
  "newLabel": "hr.payroll.btn.newPeriod",
  "resources": [
    {
      "id": "periods",
      "dataSource": "/api/data/payroll_entries?period_id[eq]={masterId}&sort=employee_name&order=asc&limit=500",
      "dataPath": "records",
      "master": {
        "dataSource": "/api/data/payroll_periods?sort=year&order=desc&limit=500",
        "dataPath": "records",
        "idKey": "id",
        "titleKey": "year",
        "subtitle": {
          "keys": [
            "month"
          ],
          "sep": " "
        },
        "badgeKey": "status"
      },
      "detailActions": [
        {
          "id": "generate",
          "icon": "Calculator",
          "label": "hr.payroll.btn.generate",
          "method": "POST",
          "endpoint": "/ext/hr/payroll/actions/generatePayroll",
          "body": {
            "period_id": "{id}"
          }
        },
        {
          "id": "approve",
          "icon": "CheckCircle",
          "label": "hr.payroll.btn.approve",
          "method": "POST",
          "endpoint": "/ext/hr/payroll/actions/approvePeriod",
          "body": {
            "id": "{id}"
          }
        },
        {
          "id": "pay",
          "icon": "Banknote",
          "label": "hr.payroll.btn.pay",
          "method": "POST",
          "endpoint": "/ext/hr/payroll/actions/payPeriod",
          "body": {
            "id": "{id}"
          }
        },
        {
          "id": "revisal",
          "icon": "FileText",
          "label": "hr.payroll.btn.revisal",
          "method": "POST",
          "endpoint": "/ext/hr/payroll/actions/exportRevisal",
          "body": {}
        }
      ],
      "columns": [
        {
          "key": "employee_name",
          "label": "common.col.employee"
        },
        {
          "key": "gross_salary",
          "label": "hr.payroll.col.gross",
          "type": "currency",
          "currency": {
            "code": "RON"
          }
        },
        {
          "key": "cas_employee",
          "label": "CAS 25%",
          "type": "currency",
          "currency": {
            "code": "RON"
          }
        },
        {
          "key": "cass_employee",
          "label": "CASS 10%",
          "type": "currency",
          "currency": {
            "code": "RON"
          }
        },
        {
          "key": "income_tax",
          "label": "hr.payroll.preset.tax10",
          "type": "currency",
          "currency": {
            "code": "RON"
          }
        },
        {
          "key": "net_salary",
          "label": "hr.payroll.col.net",
          "type": "currency",
          "currency": {
            "code": "RON"
          }
        }
      ],
      "form": {
        "endpoint": "/api/data/payroll_periods",
        "fields": [
          {
            "name": "year",
            "label": "payroll.form.year",
            "type": "number",
            "required": true,
            "colSpan": 1
          },
          {
            "name": "month",
            "label": "payroll.form.month",
            "type": "number",
            "required": true,
            "colSpan": 1
          },
          {
            "name": "notes",
            "label": "payroll.form.notes",
            "type": "textarea",
            "colSpan": 2
          }
        ]
      }
    }
  ]
}
