          "type": "currency",
          "currency": {
            "code": "RON"
          }
        },
        {
          "key": "cass",
          "label": "CASS 10%",
          "type": "currency",
          "currency": {
            "code": "RON"
          }
        },
        {
          "key": "income_tax",
          "label": "hr.payroll.preset.tax10",
          "type": "currency",
          "currency": {
            "code": "RON"
          }
        },
        {
          "key": "net_salary",
          "label": "hr.payroll.col.net",
          "type": "currency",
          "currency": {
            "code": "RON"
          }
        }
      ],
      "form": {
        "endpoint": "/ext/hr/payroll/periods",
