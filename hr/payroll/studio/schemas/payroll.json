          {
            "name": "year",
            "label": "payroll.form.year",
            "type": "number",
            "required": true,
            "colSpan": 1
          },
          {
            "name": "month",
            "label": "payroll.form.month",
            "type": "number",
            "required": true,
            "colSpan": 1
          },
          {
            "name": "notes",
            "label": "payroll.form.notes",
            "type": "textarea",
            "colSpan": 2
