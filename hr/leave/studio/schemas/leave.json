{
  "spec": "zveltio.view/2",
  "title": "hr.leave.title",
  "type": "list",
  "collection": "leave_requests",
  "fields": [
    {
      "field": "leave_type_id",
      "label": "common.col.leaveType"
    },
    {
      "field": "start_date",
      "label": "common.col.from"
    },
    {
      "field": "end_date",
      "label": "common.col.to"
    },
    {
      "field": "working_days",
      "label": "common.col.days",
      "display": "mono"
    },
    {
      "field": "status",
      "label": "common.col.status",
      "display": "badge",
      "tones": {
        "pending": "warning",
        "approved": "success",
        "rejected": "danger",
        "cancelled": "muted"
      }
    }
  ],
  "sort": "-start_date",
  "rowActions": [
    {
      "action": "approveRequest",
      "label": "hr.leave.btn.approve",
      "tone": "success",
      "input": {
        "id": {
          "$record": "id"
        }
      },
      "when": [
        {
          "field": "status",
          "op": "eq",
          "value": "pending"
        }
      ]
    },
    {
      "action": "rejectRequest",
      "label": "hr.leave.btn.reject",
      "tone": "danger",
      "input": {
        "id": {
          "$record": "id"
        }
      },
      "prompt": [
        "reason"
      ],
      "when": [
        {
          "field": "status",
          "op": "eq",
          "value": "pending"
        }
      ]
    },
    {
      "action": "cancelRequest",
      "label": "hr.leave.btn.cancel",
      "tone": "warning",
      "input": {
        "id": {
          "$record": "id"
        }
      },
      "when": [
        {
          "field": "status",
          "op": "in",
          "value": [
            "pending",
            "approved"
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "action": "requestLeave",
      "tone": "info",
      "label": "hr.leave.new",
      "prompt": [
        "employee_id",
        "leave_type_id",
        "start_date",
        "end_date",
        "reason"
      ]
    }
  ]
}
