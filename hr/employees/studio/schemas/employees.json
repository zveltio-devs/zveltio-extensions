{
  "spec": "zveltio.view/2",
  "title": "hr.employees.title",
  "type": "list",
  "collection": "employees",
  "fields": [
    {
      "field": "employee_number",
      "label": "hr.employees.col.number",
      "display": "mono"
    },
    {
      "field": "first_name",
      "label": "hr.employees.col.name"
    },
    {
      "field": "email",
      "label": "hr.employees.col.email"
    },
    {
      "field": "department_id",
      "label": "hr.employees.col.department"
    },
    {
      "field": "position_id",
      "label": "hr.employees.col.position"
    },
    {
      "field": "hire_date",
      "label": "hr.employees.col.hireDate"
    },
    {
      "field": "status",
      "label": "hr.employees.col.status",
      "display": "badge",
      "tones": {
        "active": "success",
        "on_leave": "warning",
        "terminated": "muted"
      }
    }
  ],
  "sort": "last_name",
  "search": true,
  "rowActions": [
    {
      "action": "terminate",
      "label": "hr.employees.btn.terminate",
      "tone": "danger",
      "input": {
        "id": {
          "$record": "id"
        }
      },
      "prompt": [
        "end_date"
      ],
      "when": [
        {
          "field": "status",
          "op": "in",
          "value": [
            "active",
            "inactive",
            "on_leave"
          ]
        }
      ]
    }
  ],
  "actions": [
    {
      "action": "hire",
      "tone": "info",
      "label": "hr.employees.new",
      "prompt": [
        "first_name",
        "last_name",
        "email",
        "work_email",
        "phone",
        "hire_date",
        "department_id",
        "position_id",
        "employment_type",
        "salary",
        "currency",
        "address"
      ]
    }
  ]
}
