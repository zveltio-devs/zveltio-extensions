{
  "name": "employees",
  "fields": [
    {"name": "employee_number", "type": "text", "unique": true, "required": true},
    {"name": "user_id", "type": "text", "indexed": true},
    {"name": "first_name", "type": "text", "required": true},
    {"name": "last_name", "type": "text", "required": true},
    {"name": "email", "type": "email", "required": true},
    {"name": "work_email", "type": "email"},
    {"name": "phone", "type": "phone"},
    {"name": "birth_date", "type": "date"},
    {"name": "gender", "type": "enum", "options": {"values": ["m", "f", "other"]}},
    {"name": "national_id", "type": "text"},
    {"name": "tax_id", "type": "text"},
    {"name": "address", "type": "textarea"},
    {"name": "department_id", "type": "m2o", "indexed": true, "options": {"related_collection": "departments"}},
    {"name": "position_id", "type": "m2o", "options": {"related_collection": "job_positions"}},
    {"name": "manager_id", "type": "m2o", "indexed": true, "options": {"related_collection": "employees"}},
    {"name": "hire_date", "type": "date", "required": true},
    {"name": "end_date", "type": "date"},
    {"name": "probation_end_date", "type": "date"},
    {"name": "employment_type", "type": "enum", "required": true, "defaultValue": "full_time", "options": {"values": ["full_time", "part_time", "contractor", "intern"]}},
    {"name": "status", "type": "enum", "required": true, "indexed": true, "defaultValue": "active", "options": {"values": ["active", "inactive", "on_leave", "terminated"]}},
    {"name": "salary", "type": "decimal"},
    {"name": "currency", "type": "text", "required": true, "defaultValue": "RON"},
    {"name": "iban", "type": "text"},
    {"name": "bank_name", "type": "text"},
    {"name": "avatar_url", "type": "url"},
    {"name": "notes", "type": "textarea"}
  ],
  "relations": [
    {"name": "employees_department_id", "type": "m2o", "field": "department_id", "target": "departments", "targetField": "id", "onDelete": "SET NULL", "onUpdate": "CASCADE", "metadata": {}},
    {"name": "employees_position_id", "type": "m2o", "field": "position_id", "target": "job_positions", "targetField": "id", "onDelete": "SET NULL", "onUpdate": "CASCADE", "metadata": {}},
    {"name": "employees_manager_id", "type": "m2o", "field": "manager_id", "target": "employees", "targetField": "id", "onDelete": "SET NULL", "onUpdate": "CASCADE", "metadata": {}}
  ],
  "validation": [
    {"field": "salary", "rule": "min", "config": {"value": 0}, "message": "A salary is not negative."}
  ]
}
