{
  "name": "ai",
  "displayName": "AI",
  "category": "intelligence",
  "description": "AI chat on providers the operator allows: OpenAI, Anthropic, Ollama or any OpenAI-compatible server, with prompt templates and a usage log. The assistant acts as its caller and nothing more.",
  "version": "2.0.1",
  "zveltioMinVersion": "3.0.0-beta.106",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-ai",
  "permissions": [
    "data:system"
  ],
  "i18nPrefixes": [
    "ai"
  ],
  "contributes": {
    "engine": true,
    "studio": true,
    "fieldTypes": [],
    "slots": [
      "topbar.center",
      "dashboard.hero"
    ]
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/ai",
        "label": "AI",
        "icon": "Bot",
        "schema": "schemas/ai.json"
      },
      {
        "path": "/admin/ai/chat",
        "label": "AI Chat",
        "icon": "MessageSquare"
      }
    ],
    "navGroup": "developer"
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "collections": [
    "ai_providers",
    "ai_prompt_templates",
    "ai_conversations",
    "ai_messages",
    "ai_usage"
  ],
  "actions": [
    {
      "name": "chat",
      "permission": {
        "resource": "ai_messages",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "conversation_id",
          "content"
        ],
        "additionalProperties": false,
        "properties": {
          "conversation_id": {
            "type": "string",
            "format": "uuid"
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000
          }
        }
      },
      "reads": [
        "ai_conversations",
        "ai_messages"
      ],
      "writes": [
        "ai_messages"
      ],
      "enqueues": [
        "complete"
      ]
    }
  ],
  "jobs": [
    {
      "name": "complete",
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "ai_messages",
        "ai_conversations",
        "ai_providers",
        "ai_prompt_templates"
      ],
      "writes": [
        "ai_messages",
        "ai_usage"
      ],
      "egressSlots": [
        "provider"
      ],
      "retry": {
        "limit": 0,
        "backoff": true
      },
      "timeoutSeconds": 300
    }
  ],
  "integrity": {
    "engineSha256": "43fd7b006a60293db2194d04a6c505dfbe5e35fedb18dc32a8c28a2483ded1bb",
    "sourceSha256": "206ac3f199713d439593524ce007ed37cacea9fccdf1543181c7780cf6187c1b",
    "schemaSha256": "56a5ac3e17cd2e5ff6d500dab3a83577d5db0f3daf6c94fa5fbd7353aead2201",
    "jobsSha256": "ddd2abf1c7ff6c125adf3b9327e148bbf7452c64e696c8aca8d6693476b6d538"
  }
}
