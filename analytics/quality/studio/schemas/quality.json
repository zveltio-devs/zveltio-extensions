{
  "spec": "zveltio.view/2",
  "title": "analytics.quality.title",
  "type": "split",
  "panes": [
    {
      "id": "scan",
      "type": "list",
      "collection": "quality_scans",
      "fields": [
        "target_collection",
        { "field": "scan_type", "display": "badge" },
        "issues_found"
      ],
      "sort": "-created_at",
      "actions": [
        {
          "action": "scan",
          "label": "analytics.quality.btn.runScan",
          "prompt": ["collection", "scan_type"]
        }
      ]
    },
    {
      "type": "list",
      "collection": "quality_issues",
      "fields": [
        {
          "field": "severity",
          "label": "analytics.quality.col.severity",
          "display": "badge",
          "tones": { "error": "danger", "warning": "warning", "info": "info" }
        },
        { "field": "issue_type", "label": "common.col.type" },
        { "field": "field_name", "label": "common.col.field", "display": "mono" },
        { "field": "description", "label": "common.col.description" }
      ],
      "filter": [
        { "field": "scan_id", "op": "eq", "value": { "$selected": "scan" } },
        { "field": "dismissed", "op": "eq", "value": false }
      ],
      "sort": "created_at",
      "actions": [
        {
          "action": "dismissScan",
          "label": "analytics.quality.btn.dismissAll",
          "input": { "scan_id": { "$selected": "scan" } }
        }
      ],
      "rowActions": [
        {
          "action": "dismissIssue",
          "label": "analytics.quality.btn.dismiss",
          "input": { "id": { "$record": "id" } }
        }
      ]
    }
  ]
}
