node_modules/
# …and the same name as a symlink. `node_modules/` matches a DIRECTORY only,
# so a worktree that links its dependencies instead of installing them offers
# `node_modules` to `git add -A` as an ordinary file.
node_modules
dist/
build/
.env
.env.*
*.local
bun.lock

# zveltio extension types codegen output (S4-01) — regenerate via:
#   $ zveltio extension types
.zveltio/

# Ship pre-built Studio bundles — deployment artifact for extension UIs.
# Without them the engine cannot serve extension Studio pages.
!**/studio/dist/
!**/studio/dist/bundle.js
!**/studio/dist/*.css
