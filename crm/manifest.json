{
  "name": "crm",
  "displayName": "CRM",
  "category": "business",
  "description": "Contacts, Organizations, and Transactions — owned by this extension, not the engine core",
  "version": "1.0.15",
  "zveltioMinVersion": "3.0.0-beta.83",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-crm",
  "permissions": [
    "database",
    "data:write"
  ],
  "i18nPrefixes": [
    "briefing",
    "crm"
  ],
  "studio": {
    "pages": [
      {
        "path": "/admin/crm",
        "label": "CRM",
        "icon": "Users",
        "schema": "schemas/crm.json"
      }
    ],
    "navGroup": "business"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "fieldTypes": [],
    "slots": [
      "dashboard.widgets"
    ]
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "integrity": {
    "engineSha256": "5fef245c8de43411006379ef4aba67e03e1f5809b2c8b5e8b03966aa1bab5d0d",
    "sourceSha256": "3804e7221a433d7d9080d56c1b9ebb8213d93db2e3a171ea461f1819cad53c64"
  },
  "resources": [
    "crm",
    "contacts",
    "organizations",
    "transactions"
  ],
  "actions": [
    {
      "name": "markPaid",
      "permission": {
        "resource": "transactions",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "paid_date": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "reads": [
        "transactions"
      ],
      "writes": [
        "transactions"
      ]
    }
  ]
}
