{
  "name": "crm",
  "displayName": "CRM",
  "category": "business",
  "description": "Contacts, Organizations, and Transactions — owned by this extension, not the engine core",
  "version": "1.0.20",
  "zveltioMinVersion": "3.0.0-beta.83",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-crm",
  "permissions": [
    "database",
    "data:write"
  ],
  "i18nPrefixes": [
    "briefing",
    "crm"
  ],
  "studio": {
    "pages": [
      {
        "path": "/admin/crm",
        "label": "CRM",
        "icon": "Users",
        "schema": "schemas/crm.json"
      }
    ],
    "navGroup": "business"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "fieldTypes": [],
    "slots": [
      "dashboard.widgets"
    ]
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "integrity": {
    "engineSha256": "b25c752bbeb00aa9914529ab938ed0cb220c56eef90ca33228f4cb6a72d682f2",
    "sourceSha256": "f49afb13fb81679e21705534359270cdb472c27e268ccac3d80dcfd41e671457"
  },
  "resources": [
    "crm",
    "contacts",
    "organizations",
    "transactions",
    "contact_organizations"
  ],
  "actions": [
    {
      "name": "markPaid",
      "permission": {
        "resource": "transactions",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "paid_date": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "reads": [
        "transactions"
      ],
      "writes": [
        "transactions"
      ]
    }
  ]
}
