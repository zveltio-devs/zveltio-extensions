{
  "name": "crm",
  "displayName": "CRM",
  "category": "business",
  "description": "Contacts, Organizations, and Transactions — owned by this extension, not the engine core",
  "version": "2.0.0",
  "zveltioMinVersion": "3.0.0-beta.92",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-crm",
  "permissions": [
    "data:write"
  ],
  "collections": [
    "organizations",
    "contacts",
    "transactions"
  ],
  "i18nPrefixes": [
    "briefing",
    "crm"
  ],
  "studio": {
    "pages": [
      {
        "path": "/admin/crm",
        "label": "CRM",
        "icon": "Users",
        "schema": "schemas/crm.json"
      }
    ],
    "navGroup": "business"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "fieldTypes": [],
    "slots": [
      "dashboard.widgets"
    ]
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "integrity": {
    "engineSha256": "a87e52f9f1cad712dd8bbbfe7982c6e1d2ce6147be2f3db557fb0e43d910d01d",
    "sourceSha256": "5fe9ebed9d625bd8ec8a035fe6781046ac6208bd500347188081a613a774698e",
    "schemaSha256": "2595cc30d01e44be558b1115b63c119bfce69c4cb5bc6fa3d302c27a02f9ef2e"
  },
  "actions": [
    {
      "name": "markPaid",
      "permission": {
        "resource": "transactions",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "paid_date": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "reads": [
        "transactions"
      ],
      "writes": [
        "transactions"
      ]
    }
  ]
}
