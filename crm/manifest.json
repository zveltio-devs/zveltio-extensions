{
  "name": "crm",
  "displayName": "CRM",
  "category": "business",
  "description": "Contacts, Organizations, and Transactions — owned by this extension, not the engine core",
  "version": "1.0.21",
  "zveltioMinVersion": "3.0.0-beta.83",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-crm",
  "permissions": [
    "database",
    "data:write"
  ],
  "i18nPrefixes": [
    "briefing",
    "crm"
  ],
  "studio": {
    "pages": [
      {
        "path": "/admin/crm",
        "label": "CRM",
        "icon": "Users",
        "schema": "schemas/crm.json"
      }
    ],
    "navGroup": "business"
  },
  "contributes": {
    "engine": true,
    "studio": true,
    "fieldTypes": [],
    "slots": [
      "dashboard.widgets"
    ]
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "integrity": {
    "engineSha256": "8cc52f25cc92015dd965dfdc2bfeb8d89909199e174bbfd73a87e81897c4c885",
    "sourceSha256": "04107d675baca7c9ba151732c6478522a000b77e37ac0adc5e4794c1b5a10877"
  },
  "resources": [
    "crm",
    "contacts",
    "organizations",
    "transactions",
    "contact_organizations"
  ],
  "actions": [
    {
      "name": "markPaid",
      "permission": {
        "resource": "transactions",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "paid_date": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "reads": [
        "transactions"
      ],
      "writes": [
        "transactions"
      ]
    }
  ]
}
