{
  "spec": "zveltio.view/2",
  "title": "crm.title",
  "type": "tabs",
  "items": [
    {
      "type": "list",
      "collection": "contacts",
      "title": "crm.tab.contacts",
      "fields": [
        {
          "field": "first_name",
          "label": "crm.col.name"
        },
        {
          "field": "email",
          "label": "crm.col.email"
        },
        {
          "field": "organization_id",
          "label": "crm.col.organization"
        },
        {
          "field": "phone",
          "label": "crm.col.phone"
        },
        {
          "field": "company",
          "label": "crm.col.company"
        },
        {
          "field": "created_at",
          "label": "common.added"
        }
      ],
      "sort": "-created_at",
      "search": true,
      "delete": true,
      "create": true
    },
    {
      "type": "list",
      "collection": "organizations",
      "title": "crm.tab.organizations",
      "fields": [
        {
          "field": "name",
          "label": "crm.col.name"
        },
        {
          "field": "industry",
          "label": "crm.col.industry"
        },
        {
          "field": "email",
          "label": "crm.col.email"
        },
        {
          "field": "created_at",
          "label": "common.added"
        }
      ],
      "sort": "name",
      "search": true,
      "delete": true,
      "create": true
    },
    {
      "type": "list",
      "collection": "transactions",
      "title": "crm.tab.deals",
      "fields": [
        {
          "field": "number",
          "label": "crm.col.number"
        },
        {
          "field": "type",
          "label": "crm.col.type",
          "display": "badge",
          "tones": {
            "invoice": "info",
            "payment": "success",
            "credit_note": "warning",
            "expense": "muted",
            "transfer": "muted",
            "other": "muted"
          }
        },
        {
          "field": "status",
          "label": "crm.col.status",
          "display": "badge",
          "tones": {
            "draft": "muted",
            "pending": "warning",
            "completed": "success",
            "cancelled": "danger",
            "refunded": "info"
          }
        },
        {
          "field": "total_amount",
          "label": "crm.col.amount"
        },
        {
          "field": "currency",
          "label": "common.col.currency"
        },
        {
          "field": "due_date",
          "label": "crm.col.dueDate"
        },
        {
          "field": "created_at",
          "label": "common.added"
        }
      ],
      "sort": "-created_at",
      "search": true,
      "delete": true,
      "rowActions": [
        {
          "action": "markPaid",
          "label": "crm.action.markPaid",
          "input": {
            "id": {
              "$record": "id"
            },
            "paid_date": {
              "$today": true
            }
          },
          "when": [
            {
              "field": "status",
              "op": "in",
              "value": [
                "draft",
                "pending"
              ]
            }
          ]
        }
      ],
      "create": true
    }
  ]
}
