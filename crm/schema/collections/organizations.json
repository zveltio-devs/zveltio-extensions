{
  "name": "organizations",
  "fields": [
    {
      "name": "name",
      "type": "text",
      "required": true
    },
    {
      "name": "legal_name",
      "type": "text"
    },
    {
      "name": "tax_id",
      "type": "text",
      "indexed": true
    },
    {
      "name": "vat_payer",
      "type": "boolean",
      "required": true,
      "defaultValue": false
    },
    {
      "name": "registration_no",
      "type": "text"
    },
    {
      "name": "type",
      "type": "enum",
      "required": true,
      "defaultValue": "company",
      "options": {
        "values": [
          "company",
          "nonprofit",
          "government",
          "individual"
        ]
      }
    },
    {
      "name": "industry",
      "type": "text"
    },
    {
      "name": "website",
      "type": "url"
    },
    {
      "name": "email",
      "type": "email"
    },
    {
      "name": "phone",
      "type": "phone"
    },
    {
      "name": "address",
      "type": "textarea"
    },
    {
      "name": "logo_url",
      "type": "url"
    },
    {
      "name": "is_active",
      "type": "boolean",
      "required": true,
      "defaultValue": true
    },
    {
      "name": "tags",
      "type": "tags"
    },
    {
      "name": "notes",
      "type": "textarea"
    },
    {
      "name": "metadata",
      "type": "json"
    }
  ],
  "validation": [
    {
      "field": "tax_id",
      "rule": "custom",
      "config": {
        "expression": "value == null || value == \"\" || value.matches(\"^[0-9]{2,10}$\") && (int(value) / 1000000000 % 10 * 7 + int(value) / 100000000 % 10 * 5 + int(value) / 10000000 % 10 * 3 + int(value) / 1000000 % 10 * 2 + int(value) / 100000 % 10 * 1 + int(value) / 10000 % 10 * 7 + int(value) / 1000 % 10 * 5 + int(value) / 100 % 10 * 3 + int(value) / 10 % 10 * 2) * 10 % 11 % 10 == int(value) % 10"
      },
      "message": "Not a valid Romanian CUI: 2 to 10 digits with a valid check digit, no RO prefix (that is vat_payer)."
    }
  ]
}
