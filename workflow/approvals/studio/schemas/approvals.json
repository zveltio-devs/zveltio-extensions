            "required": true,
            "colSpan": 1
          },
          {
            "name": "is_active",
            "label": "common.col.active",
            "type": "boolean",
            "default": true,
            "colSpan": 1
          }
        ]
      }
    },
    {
      "id": "steps",
      "label": "workflow.approvals.tab.steps",
      "icon": "ListOrdered",
      "dataSource": "/api/data/approval_steps?expand=workflow_id&sort=step_order&order=asc&limit=500",
      "dataPath": "records",
      "columns": [
        {
          "key": "workflow_id_expanded.name",
          "label": "workflow.approvals.col.workflow"
        },
        {
