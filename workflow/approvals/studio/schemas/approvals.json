      "dataPath": "records",
      "filters": [
        {
          "param": "status",
          "options": [
            {
              "value": "",
              "label": "common.filter.all"
            },
            {
              "value": "pending",
              "label": "common.status.pending"
            },
            {
              "value": "approved",
              "label": "common.status.approved"
            },
            {
              "value": "rejected",
              "label": "common.status.rejected"
            },
            {
              "value": "cancelled",
              "label": "common.status.cancelled"
            }
          ]
        }
      ],
      "columns": [
        {
          "key": "workflow_id_expanded.name",
          "label": "workflow.approvals.col.workflow"
        },
        {
          "key": "collection",
          "label": "common.col.collection",
          "type": "mono"
        },
        {
          "key": "record_id",
          "label": "workflow.approvals.col.record",
          "type": "mono"
        },
        {
          "key": "current_step_id_expanded.name",
          "label": "workflow.approvals.col.step"
        },
        {
          "key": "status",
          "label": "common.col.status",
          "type": "badge",
          "badge": {
            "colors": {
              "pending": "badge-warning",
              "approved": "badge-success",
              "rejected": "badge-error",
              "cancelled": "badge-ghost"
            }
          }
        },
        {
          "key": "created_at",
          "label": "common.col.date",
          "type": "date"
        },
        {
          "key": "priority",
          "label": "common.col.priority"
        }
      ],
      "rowActions": [
        {
          "id": "approve",
          "icon": "CheckCircle",
          "variant": "text-success",
          "label": "common.approve",
          "method": "POST",
          "endpoint": "/ext/workflow/approvals/actions/decide",
          "body": {
            "id": "{id}",
            "decision": "approved"
          },
          "visibleWhen": {
            "field": "status",
            "equals": "pending"
          },
          "prompt": {
            "title": "common.approve",
            "submitLabel": "common.approve",
            "fields": [
              {
                "name": "comment",
                "label": "workflow.approvals.comment",
                "type": "textarea",
                "rows": 3
              }
            ]
          }
        },
        {
          "id": "reject",
          "icon": "XCircle",
          "variant": "text-error",
          "label": "common.reject",
          "method": "POST",
          "endpoint": "/ext/workflow/approvals/actions/decide",
          "body": {
            "id": "{id}",
            "decision": "rejected"
          },
          "visibleWhen": {
            "field": "status",
            "equals": "pending"
          },
          "prompt": {
            "title": "common.reject",
            "submitLabel": "common.reject",
            "fields": [
              {
                "name": "comment",
                "label": "workflow.approvals.comment",
                "type": "textarea",
                "rows": 3,
                "required": true
              }
            ]
          }
        },
        {
          "id": "cancel",
          "icon": "Ban",
          "label": "workflow.approvals.cancelRequest",
          "method": "POST",
          "endpoint": "/ext/workflow/approvals/actions/cancel",
          "confirm": "workflow.approvals.confirmCancel",
          "visibleWhen": {
            "field": "status",
            "equals": "pending"
          },
          "body": {
            "id": "{id}"
          }
        }
      ],
      "label": "workflow.approvals.tab.requests",
      "form": {
        "endpoint": "/ext/workflow/approvals/actions/requestApproval",
        "fields": [
          {
            "name": "workflow_id",
            "label": "workflow.approvals.col.workflow",
            "type": "relation",
            "required": true,
            "colSpan": 2,
            "relation": {
              "dataSource": "/api/data/approval_workflows?is_active[eq]=true&sort=name&order=asc&limit=500",
              "dataPath": "records",
              "valueKey": "id",
              "labelKey": "name"
            }
          },
          {
            "name": "collection",
            "label": "common.col.collection",
            "mono": true,
            "required": true,
            "colSpan": 1
          },
          {
            "name": "record_id",
            "label": "workflow.approvals.col.record",
            "mono": true,
            "required": true,
            "colSpan": 1
          }
        ]
      }
    },
    {
