      "form": {
        "endpoint": "/api/data/approval_steps",
        "fields": [
          {
            "name": "workflow_id",
            "label": "workflow.approvals.col.workflow",
            "type": "relation",
            "required": true,
            "colSpan": 2,
            "relation": {
              "dataSource": "/api/data/approval_workflows?sort=name&order=asc&limit=500",
              "dataPath": "records",
              "valueKey": "id",
              "labelKey": "name"
            }
          },
          {
            "name": "step_order",
            "label": "common.col.index",
            "type": "number",
            "default": 0,
