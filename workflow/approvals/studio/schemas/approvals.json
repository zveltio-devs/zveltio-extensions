          },
          {
            "name": "name",
            "label": "common.col.name",
            "required": true,
            "colSpan": 1
          },
          {
            "name": "approver_role",
            "label": "workflow.approvals.col.approverRole",
            "mono": true,
            "colSpan": 1
          },
          {
            "name": "approver_user_id",
            "label": "workflow.approvals.col.approverUser",
