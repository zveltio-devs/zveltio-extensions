{
  "spec": "zveltio.view/2",
  "title": "workflow.approvals.title",
  "type": "tabs",
  "items": [
    {
      "type": "list",
      "collection": "approval_requests",
      "title": "workflow.approvals.tab.requests",
      "fields": [
        {
          "field": "workflow_id",
          "label": "workflow.approvals.col.workflow"
        },
        {
          "field": "collection",
          "label": "common.col.collection",
          "display": "mono"
        },
        {
          "field": "record_id",
          "label": "workflow.approvals.col.record",
          "display": "mono"
        },
        {
          "field": "current_step_id",
          "label": "workflow.approvals.col.step"
        },
        {
          "field": "status",
          "label": "common.col.status",
          "display": "badge",
          "tones": {
            "pending": "warning",
            "approved": "success",
            "rejected": "danger",
            "cancelled": "muted"
          }
        },
        {
          "field": "created_at",
          "label": "common.col.date"
        },
        {
          "field": "priority",
          "label": "common.col.priority"
        }
      ],
      "sort": "-created_at",
      "rowActions": [
        {
          "action": "decide",
          "label": "common.approve",
          "tone": "success",
          "input": {
            "id": {
              "$record": "id"
            },
            "decision": "approved"
          },
          "prompt": [
            "comment"
          ],
          "when": [
            {
              "field": "status",
              "op": "eq",
              "value": "pending"
            }
          ]
        },
        {
          "action": "decide",
          "label": "common.reject",
          "tone": "danger",
          "input": {
            "id": {
              "$record": "id"
            },
            "decision": "rejected"
          },
          "prompt": [
            "comment"
          ],
          "when": [
            {
              "field": "status",
              "op": "eq",
              "value": "pending"
            }
          ]
        },
        {
          "action": "cancel",
          "label": "workflow.approvals.cancelRequest",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "confirm": "workflow.approvals.confirmCancel",
          "when": [
            {
              "field": "status",
              "op": "eq",
              "value": "pending"
            }
          ]
        }
      ],
      "actions": [
        {
          "action": "requestApproval",
          "tone": "info",
          "label": "workflow.approvals.btn.newRequest",
          "prompt": [
            "workflow_id",
            "collection",
            "record_id"
          ]
        }
      ]
    },
    {
      "type": "list",
      "collection": "approval_workflows",
      "title": "workflow.approvals.tab.workflows",
      "fields": [
        {
          "field": "name",
          "label": "common.col.name"
        },
        {
          "field": "collection",
          "label": "common.col.collection",
          "display": "mono"
        },
        {
          "field": "is_active",
          "label": "common.col.active"
        }
      ],
      "sort": "name",
      "edit": true,
      "create": true
    },
    {
      "type": "list",
      "collection": "approval_steps",
      "title": "workflow.approvals.tab.steps",
      "fields": [
        {
          "field": "workflow_id",
          "label": "workflow.approvals.col.workflow"
        },
        {
          "field": "step_order",
          "label": "common.col.index",
          "display": "mono"
        },
        {
          "field": "name",
          "label": "common.col.name"
        },
        {
          "field": "approver_role",
          "label": "workflow.approvals.col.approverRole",
          "display": "mono"
        },
        {
          "field": "deadline_hours",
          "label": "workflow.approvals.col.deadlineHours",
          "display": "mono"
        }
      ],
      "sort": "step_order",
      "edit": true,
      "create": true
    }
  ]
}
