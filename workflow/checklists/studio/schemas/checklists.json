{
  "spec": "zveltio.view/2",
  "title": "workflow.checklists.title",
  "type": "tabs",
  "items": [
    {
      "type": "list",
      "collection": "checklist_templates",
      "title": "workflow.checklists.tab.templates",
      "fields": [
        {
          "field": "name",
          "label": "common.col.name"
        },
        {
          "field": "description",
          "label": "common.col.description"
        },
        {
          "field": "collection",
          "label": "common.col.collection",
          "display": "mono"
        },
        {
          "field": "is_active",
          "label": "common.col.active"
        }
      ],
      "sort": "name",
      "edit": true,
      "create": true
    },
    {
      "type": "list",
      "collection": "checklist_template_items",
      "title": "workflow.checklists.tab.templateItems",
      "fields": [
        {
          "field": "template_id",
          "label": "workflow.checklists.col.template"
        },
        {
          "field": "label",
          "label": "common.col.label"
        },
        {
          "field": "required",
          "label": "common.required"
        },
        {
          "field": "order_idx",
          "label": "common.col.index",
          "display": "mono"
        }
      ],
      "sort": "order_idx",
      "edit": true,
      "create": true
    },
    {
      "type": "list",
      "collection": "checklists",
      "title": "workflow.checklists.tab.instances",
      "fields": [
        {
          "field": "name",
          "label": "common.col.name"
        },
        {
          "field": "collection",
          "label": "common.col.collection",
          "display": "mono"
        },
        {
          "field": "record_id",
          "label": "workflow.checklists.col.record",
          "display": "mono"
        },
        {
          "field": "completed_at",
          "label": "workflow.checklists.col.completed"
        },
        {
          "field": "created_at",
          "label": "common.col.created"
        }
      ],
      "sort": "-updated_at",
      "rowActions": [
        {
          "action": "deleteChecklist",
          "tone": "danger",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "confirm": "workflow.checklists.confirmDelete"
        }
      ],
      "actions": [
        {
          "action": "attachChecklist",
          "tone": "info",
          "label": "workflow.checklists.btn.new",
          "prompt": [
            "name",
            "template_id",
            "collection",
            "record_id"
          ]
        }
      ]
    },
    {
      "type": "list",
      "collection": "checklist_items",
      "title": "workflow.checklists.tab.items",
      "fields": [
        {
          "field": "checklist_id",
          "label": "workflow.checklists.col.checklist"
        },
        {
          "field": "label",
          "label": "common.col.label"
        },
        {
          "field": "required",
          "label": "common.required"
        },
        {
          "field": "checked",
          "label": "workflow.checklists.col.checked"
        },
        {
          "field": "due_at",
          "label": "workflow.checklists.col.due"
        }
      ],
      "sort": "order_idx",
      "rowActions": [
        {
          "action": "updateItem",
          "label": "workflow.checklists.action.check",
          "input": {
            "id": {
              "$record": "id"
            },
            "checked": true
          }
        },
        {
          "action": "updateItem",
          "label": "workflow.checklists.action.uncheck",
          "input": {
            "id": {
              "$record": "id"
            },
            "checked": false
          }
        }
      ]
    },
    {
      "type": "list",
      "collection": "checklist_recurrences",
      "title": "workflow.checklists.tab.recurrences",
      "fields": [
        {
          "field": "template_id",
          "label": "workflow.checklists.col.template"
        },
        {
          "field": "collection",
          "label": "common.col.collection",
          "display": "mono"
        },
        {
          "field": "record_id",
          "label": "workflow.checklists.col.record",
          "display": "mono"
        },
        {
          "field": "frequency",
          "label": "workflow.checklists.col.frequency"
        },
        {
          "field": "next_run_at",
          "label": "workflow.checklists.col.nextRun"
        },
        {
          "field": "is_active",
          "label": "common.col.active"
        }
      ],
      "filter": [
        {
          "field": "is_active",
          "op": "eq",
          "value": true
        }
      ],
      "sort": "next_run_at",
      "edit": true,
      "create": true
    }
  ]
}
