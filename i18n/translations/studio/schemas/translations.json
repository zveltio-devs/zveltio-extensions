{
  "spec": "zveltio.view/2",
  "title": "i18n.translations.title",
  "type": "tabs",
  "items": [
    {
      "type": "list",
      "collection": "i18n_keys",
      "title": "i18n.translations.tab.keys",
      "fields": [
        {
          "field": "key",
          "label": "common.col.key",
          "display": "mono"
        },
        {
          "field": "context",
          "label": "i18n.translations.col.context"
        },
        {
          "field": "default_value",
          "label": "i18n.translations.col.default"
        },
        {
          "field": "description",
          "label": "common.col.description"
        }
      ],
      "sort": "key",
      "search": true,
      "delete": true,
      "create": true
    },
    {
      "type": "list",
      "collection": "i18n_translations",
      "title": "i18n.translations.tab.translations",
      "fields": [
        {
          "field": "key_id",
          "label": "common.col.key",
          "display": "mono"
        },
        {
          "field": "locale_id",
          "label": "i18n.translations.col.locale"
        },
        {
          "field": "value",
          "label": "i18n.translations.col.translation"
        },
        {
          "field": "reviewed",
          "label": "i18n.translations.col.reviewed"
        },
        {
          "field": "is_machine_translated",
          "label": "i18n.translations.col.machine"
        }
      ],
      "sort": "-updated_at",
      "delete": true,
      "rowActions": [
        {
          "action": "approve",
          "label": "i18n.translations.btn.approve",
          "input": {
            "id": {
              "$record": "id"
            }
          },
          "confirm": "i18n.translations.confirmApprove"
        }
      ],
      "create": true
    },
    {
      "type": "list",
      "collection": "i18n_approvals",
      "title": "i18n.translations.tab.approvals",
      "fields": [
        {
          "field": "created_at",
          "label": "common.col.date"
        },
        {
          "field": "value",
          "label": "i18n.translations.col.translation"
        },
        {
          "field": "translation_id",
          "label": "i18n.translations.col.current"
        }
      ],
      "sort": "-created_at"
    },
    {
      "type": "list",
      "collection": "i18n_locales",
      "title": "i18n.translations.tab.locales",
      "fields": [
        {
          "field": "code",
          "label": "i18n.translations.col.localeCode",
          "display": "mono"
        },
        {
          "field": "name",
          "label": "i18n.translations.col.localeName"
        },
        {
          "field": "is_active",
          "label": "common.col.active"
        }
      ],
      "sort": "code",
      "delete": true,
      "create": true
    },
    {
      "type": "list",
      "collection": "i18n_settings",
      "title": "i18n.translations.tab.settings",
      "fields": [
        {
          "field": "default_locale",
          "label": "i18n.translations.col.defaultLocale",
          "display": "mono"
        }
      ],
      "delete": true,
      "create": true
    },
    {
      "type": "list",
      "collection": "i18n_glossary",
      "title": "i18n.translations.tab.glossary",
      "fields": [
        {
          "field": "term",
          "label": "i18n.translations.col.term"
        },
        {
          "field": "locale_id",
          "label": "i18n.translations.col.locale"
        },
        {
          "field": "translation",
          "label": "i18n.translations.col.translation"
        },
        {
          "field": "forbidden",
          "label": "i18n.translations.col.forbidden"
        }
      ],
      "sort": "term",
      "delete": true,
      "create": true
    }
