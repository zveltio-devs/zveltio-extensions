{
  "name": "i18n/translations",
  "displayName": "Translations",
  "category": "i18n",
  "description": "Internationalization: locales, translation keys, per-locale values, a glossary and approvals",
  "version": "2.1.0",
  "zveltioMinVersion": "3.0.0-beta.111",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-translations",
  "permissions": [
    "data:write"
  ],
  "i18nPrefixes": [
    "i18n"
  ],
  "studio": {
    "pages": [
      {
        "path": "/admin/i18n",
        "label": "Translations",
        "icon": "Languages",
        "schema": "schemas/translations.json"
      }
    ],
    "navGroup": "other"
  },
  "contributes": {
    "engine": true,
    "studio": true
  },
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "collections": [
    "i18n_locales",
    "i18n_settings",
    "i18n_keys",
    "i18n_translations",
    "i18n_approvals",
    "i18n_glossary"
  ],
  "actions": [
    {
      "name": "approve",
      "permission": {
        "resource": "i18n_approvals",
        "action": "execute"
      },
      "input": {
        "type": "object",
        "required": [
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "reads": [
        "i18n_translations"
      ],
      "writes": [
        "i18n_approvals"
      ]
    }
  ],
  "integrity": {
    "engineSha256": "0051d93140759377d31c32c85547c5bf69cbff2dcab1c66bdab9fbb94eff8f23",
    "sourceSha256": "96f7b83e55f8f835cb72e225cdfa3f2cd6a6086902f50f4c12c1c4713bc191d0",
