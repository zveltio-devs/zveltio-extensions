{
  "name": "billing",
  "displayName": "Billing & Usage",
  "category": "billing",
  "description": "Usage metering and Stripe billing integration",
  "version": "1.0.0",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-billing",
  "permissions": [
    "database"
  ],
  "publicRoutes": [
    "/webhook/stripe"
  ],
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/billing",
        "component": "./studio/src/pages/BillingPage.svelte",
        "label": "Billing",
        "icon": "credit-card"
      },
      {
        "path": "/admin/billing/usage",
        "component": "./studio/src/pages/UsagePage.svelte",
        "label": "Usage",
        "icon": "bar-chart"
      }
    ],
    "navGroup": "finance"
  },
  "contributes": {
    "engine": true,
    "studio": false,
    "fieldTypes": []
  },
  "integrity": {
    "engineSha256": "c01a834d24f7502567ce1d8a8df1b3070dc73c3fd5bfa29c5155697d82f5d5bf",
    "sourceSha256": "8ba764ede2182f5242f7b570da56262de279dec496d1e977c2a937569c2b0e87"
  }
}
