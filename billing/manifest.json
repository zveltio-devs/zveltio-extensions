{
  "name": "billing",
  "displayName": "Billing & Usage",
  "category": "billing",
  "description": "Usage metering and Stripe billing integration",
  "version": "1.0.0",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-billing",
  "permissions": [
    "database"
  ],
  "publicRoutes": [
    "/webhook/stripe"
  ],
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/billing",
        "component": "./studio/src/pages/BillingPage.svelte",
        "label": "Billing",
        "icon": "credit-card"
      },
      {
        "path": "/admin/billing/usage",
        "component": "./studio/src/pages/UsagePage.svelte",
        "label": "Usage",
        "icon": "bar-chart"
      }
    ],
    "navGroup": "finance"
  },
  "contributes": {
    "engine": true,
    "studio": false,
    "fieldTypes": []
  },
  "integrity": {
    "engineSha256": "59f2cf26bab0b86eaf2dcf62e1c88b74afca50e11f36566b89c472d5295801df",
    "sourceSha256": "faabf4fca1f1c7fc65f36632874e5b68cf974f3bccf534c7c27841d262758c65"
  }
}
