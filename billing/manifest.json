{
  "name": "billing",
  "displayName": "Billing & Usage",
  "category": "billing",
  "description": "Usage metering and Stripe billing integration",
  "version": "1.0.0",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-billing",
  "permissions": [
    "database"
  ],
  "publicRoutes": [
    "/webhook/stripe"
  ],
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/billing",
        "component": "./studio/src/pages/BillingPage.svelte",
        "label": "Billing",
        "icon": "credit-card"
      },
      {
        "path": "/admin/billing/usage",
        "component": "./studio/src/pages/UsagePage.svelte",
        "label": "Usage",
        "icon": "bar-chart"
      }
    ],
    "navGroup": "finance"
  },
  "contributes": {
    "engine": true,
    "studio": false,
    "fieldTypes": []
  },
  "integrity": {
    "engineSha256": "e44a0a3c4db0a9491994e6f08ad8fef26b46ff9668c79617a6be38bb13077029",
    "sourceSha256": "6f289804d28105d9e56a850a8cd3f26e76aaa52c5ea8c037dcf68bbfd6341be3"
  }
}
