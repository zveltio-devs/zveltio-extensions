{
  "name": "billing",
  "displayName": "Billing & Usage",
  "category": "billing",
  "description": "Usage metering and Stripe billing integration",
  "version": "2.2.0",
  "zveltioMinVersion": "3.0.0-beta.111",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-billing",
  "permissions": [
    "data:system"
  ],
  "i18nPrefixes": [
    "billing"
  ],
  "publicRoutes": [
    "/webhook/stripe"
  ],
  "jobs": [
    {
      "name": "applyEvent",
      "input": {
        "type": "object",
        "required": [
          "id",
          "type",
          "created",
          "data"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "created": {
            "type": "integer"
          },
          "data": {
            "type": "object",
            "required": [
              "object"
            ],
            "properties": {
              "object": {
                "type": "object"
              }
            }
          }
        }
      },
      "reads": [
        "billing_plans",
        "billing_subscriptions"
      ],
      "writes": [
        "billing_subscriptions"
      ],
      "fromPublicRoutes": [
        "/webhook/stripe"
      ],
      "retry": {
        "limit": 5,
        "backoff": true
      }
    }
  ],
  "collections": [
    "billing_plans",
    "billing_settings",
    "billing_subscriptions",
    "billing_webhook_events",
    "billing_usage_events"
  ],
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/billing",
        "label": "Billing",
        "icon": "credit-card",
        "schema": "schemas/billing.json"
      }
    ],
    "navGroup": "finance"
  },
  "contributes": {
    "engine": true,
    "studio": true
  },
  "integrity": {
    "engineSha256": "c954c5df8b42d0ce9fab323bb700dcc6e59737d705d456f2127d2b2f2f5351ac",
    "sourceSha256": "eea102f3b1b0c2890ef3fb32c2d407d04c165d79b1d8ea1fe10d646924bc5ac1",
    "schemaSha256": "2289edc0c829f3459fd36ec636d12e217bef73ac87e785abdb1c672ba061dadb"
  }
}
