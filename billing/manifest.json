{
  "name": "billing",
  "displayName": "Billing & Usage",
  "category": "billing",
  "description": "Usage metering and Stripe billing integration",
  "version": "1.0.1",
  "zveltioMinVersion": "1.0.0",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-billing",
  "permissions": [
    "database"
  ],
  "publicRoutes": [
    "/webhook/stripe"
  ],
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/billing",
        "component": "./studio/src/pages/BillingPage.svelte",
        "label": "Billing",
        "icon": "credit-card"
      },
      {
        "path": "/admin/billing/usage",
        "component": "./studio/src/pages/UsagePage.svelte",
        "label": "Usage",
        "icon": "bar-chart"
      }
    ],
    "navGroup": "finance"
  },
  "contributes": {
    "engine": true,
    "studio": false,
    "fieldTypes": []
  },
  "integrity": {
    "engineSha256": "898f456d8b9876c7aae23d3752bbb82404629342e4e65d125e2d6081f2a84891",
    "sourceSha256": "56358a778c46614cee053aee50f854a6184a8ea1acc6b1a489e8991f861d86f4"
  }
}
