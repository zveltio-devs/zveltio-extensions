{
  "name": "billing",
  "displayName": "Billing & Usage",
  "category": "billing",
  "description": "Usage metering and Stripe billing integration",
  "version": "2.3.0",
  "zveltioMinVersion": "3.0.0-beta.111",
  "zveltioMaxVersion": "4.0.0",
  "package": "@zveltio/ext-billing",
  "permissions": [
    "data:system"
  ],
  "i18nPrefixes": [
    "billing"
  ],
  "routes": [
    {
      "method": "POST",
      "path": "/webhook/stripe",
      "access": "public",
      "handler": "stripeWebhook"
    }
  ],
  "jobs": [
    {
      "name": "applyEvent",
      "input": {
        "type": "object",
        "required": [
          "id",
          "type",
          "created",
          "data"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "created": {
            "type": "integer"
          },
          "data": {
            "type": "object",
            "required": [
              "object"
            ],
            "properties": {
              "object": {
                "type": "object"
              }
            }
          }
        }
      },
      "reads": [
        "billing_plans",
        "billing_subscriptions"
      ],
      "writes": [
        "billing_subscriptions"
      ],
      "fromPublicRoutes": [
        "/webhook/stripe"
      ],
      "retry": {
        "limit": 5,
        "backoff": true
      }
    }
  ],
  "collections": [
    "billing_plans",
    "billing_settings",
    "billing_subscriptions",
    "billing_webhook_events",
    "billing_usage_events"
  ],
  "engine": {
    "entry": "engine/index.js",
    "format": "esm",
    "target": "bun",
    "bundled": true,
    "bundlePeers": false
  },
  "studio": {
    "pages": [
      {
        "path": "/admin/billing",
        "label": "Billing",
        "icon": "credit-card",
        "schema": "schemas/billing.json"
      }
    ],
    "navGroup": "finance"
  },
  "contributes": {
    "engine": true,
    "studio": true
  },
  "integrity": {
    "engineSha256": "cb87b1772964a2b59a697d38ffb4d4a92b4e94bd71500bdf63f7af0b60e26d2f",
    "sourceSha256": "76baa6822eadfa2d21710ff9111209363a62308fb7855973098cb31c26ebac86",
    "schemaSha256": "a7ed3511c61999f6b42b09f34d9ebc361e76f3b971d0d1bb627b6164260f6993"
  }
}
