{
  "spec": "zveltio.view/2",
  "title": "billing.title",
  "type": "tabs",
  "items": [
    {
      "type": "list",
      "collection": "billing_plans",
      "title": "billing.ui.available_plans",
      "fields": [
        {
          "field": "name",
          "label": "common.col.name"
        },
        {
          "field": "price_cents",
          "label": "common.col.price"
        },
        {
          "field": "interval",
          "label": "billing.col.interval"
        },
        {
          "field": "stripe_price_id",
          "label": "billing.col.stripePrice",
          "display": "mono"
        }
      ],
      "sort": "price_cents",
      "present": "cards",
      "delete": true,
      "create": true
    },
    {
      "type": "list",
      "collection": "billing_subscriptions",
      "title": "billing.tab.subscription",
      "fields": [
        {
          "field": "plan_id",
          "label": "billing.col.plan"
        },
        {
          "field": "stripe_subscription_id",
          "label": "billing.col.stripeSubscription",
          "display": "mono"
        },
        {
          "field": "status",
          "label": "common.col.status",
          "display": "badge",
          "tones": {
            "active": "success",
            "past_due": "warning",
            "canceled": "danger",
            "trialing": "info",
            "unpaid": "danger",
            "incomplete": "muted",
            "incomplete_expired": "muted",
            "paused": "muted"
          }
        },
        {
          "field": "current_period_start",
          "label": "billing.col.periodStart"
        },
        {
          "field": "current_period_end",
          "label": "billing.col.periodEnd"
        }
      ],
      "sort": "-created_at"
    },
    {
      "type": "list",
      "collection": "billing_usage_events",
      "title": "billing.tab.usage",
      "fields": [
        {
          "field": "event_type",
          "label": "billing.col.metric",
          "display": "mono"
        },
        {
          "field": "collection",
          "label": "billing.col.collection"
        },
        {
          "field": "quantity",
          "label": "billing.col.quantity"
        },
        {
          "field": "created_at",
          "label": "common.col.date"
        }
      ],
      "sort": "-created_at"
    },
    {
      "type": "list",
      "collection": "billing_settings",
      "title": "billing.tab.settings",
      "fields": [
        {
          "field": "updated_at",
          "label": "common.col.date"
        }
      ],
      "delete": true,
      "create": true
    }
  ]
}
