{
  "sduiSchema": 1,
  "title": "billing.title",
  "subtitle": "billing.subtitle",
  "newLabel": "billing.btn.newPlan",
  "resources": [
    {
      "id": "plans",
      "label": "billing.ui.available_plans",
      "icon": "CreditCard",
      "dataSource": "/api/data/billing_plans?sort=price_cents&order=asc&limit=500",
      "dataPath": "records",
      "layout": "cards",
      "card": {
        "title": "name",
        "badge": "interval",
        "subtitle": "price_cents"
      },
      "columns": [
        {
          "key": "name",
          "label": "common.col.name"
        },
        {
          "key": "price_cents",
          "label": "common.col.price"
        },
        {
          "key": "interval",
          "label": "billing.col.interval"
        },
        {
          "key": "stripe_price_id",
          "label": "billing.col.stripePrice",
          "type": "mono"
        }
      ],
      "form": {
        "endpoint": "/api/data/billing_plans",
        "fields": [
          {
            "name": "name",
            "label": "common.col.name",
            "required": true,
            "colSpan": 1
          },
          {
            "name": "interval",
            "label": "billing.col.interval",
            "type": "select",
            "colSpan": 1,
            "default": "month",
            "options": [
              {
                "value": "month",
                "label": "billing.interval.month"
              },
              {
                "value": "year",
                "label": "billing.interval.year"
              }
            ]
          },
          {
            "name": "price_cents",
            "label": "billing.form.priceCents",
            "type": "number",
            "required": true,
            "colSpan": 1,
            "default": 0
          },
          {
            "name": "stripe_price_id",
            "label": "billing.col.stripePrice",
            "mono": true,
            "colSpan": 1
          },
          {
            "name": "limits",
            "label": "billing.form.limits",
            "type": "json",
            "mono": true,
            "rows": 4,
            "colSpan": 2
          }
        ]
      },
      "rowActions": [
        {
          "id": "delete",
          "variant": "text-error",
          "label": "common.delete",
          "method": "DELETE",
          "endpoint": "/api/data/billing_plans/{id}",
          "confirm": "ext.confirmDelete"
        }
      ]
    },
    {
      "id": "subscriptions",
      "label": "billing.tab.subscription",
      "icon": "Receipt",
      "dataSource": "/api/data/billing_subscriptions?expand=plan_id&sort=created_at&order=desc&limit=500",
      "dataPath": "records",
      "columns": [
        {
          "key": "plan_id_expanded.name",
          "label": "billing.col.plan"
        },
        {
          "key": "stripe_subscription_id",
          "label": "billing.col.stripeSubscription",
          "type": "mono"
        },
        {
          "key": "status",
          "label": "common.col.status",
          "type": "badge",
          "badge": {
            "colors": {
              "active": "badge-success",
              "past_due": "badge-warning",
              "canceled": "badge-error",
              "trialing": "badge-info",
              "unpaid": "badge-error",
              "incomplete": "badge-ghost",
              "incomplete_expired": "badge-ghost",
              "paused": "badge-ghost"
            }
          }
        },
        {
          "key": "plan_id_expanded.price_cents",
          "label": "common.col.price"
        },
        {
          "key": "current_period_start",
          "label": "billing.col.periodStart",
          "type": "date"
        },
        {
          "key": "current_period_end",
          "label": "billing.col.periodEnd",
          "type": "date"
        }
      ]
    },
    {
      "id": "usage",
      "label": "billing.tab.usage",
      "icon": "BarChart2",
      "dataSource": "/api/data/billing_usage_events?sort=created_at&order=desc&limit=500",
      "dataPath": "records",
      "columns": [
        {
          "key": "event_type",
          "label": "billing.col.metric",
          "type": "mono"
        },
        {
          "key": "collection",
          "label": "billing.col.collection"
        },
        {
          "key": "quantity",
          "label": "billing.col.quantity"
        },
        {
          "key": "created_at",
          "label": "common.col.date",
          "type": "date"
        }
      ]
    }
  ]
}
